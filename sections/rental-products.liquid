{% comment %}
  Section: Rental Product Showcase Slider
  Editorial product cards with responsive horizontal slider.
{% endcomment %}

<section
  id="rental-products-{{ section.id }}"
  class="rental-products"
  style="
    --rp-bg: {{ section.settings.background_color }};
    --rp-text: {{ section.settings.text_color }};
    --rp-muted: {{ section.settings.muted_color }};
    --rp-accent: {{ section.settings.accent_color }};
    --rp-button-bg: {{ section.settings.button_background }};
    --rp-button-text: {{ section.settings.button_text_color }};
    --rp-button-border: {{ section.settings.button_border_color }};
    --rp-columns: {{ section.settings.columns_desktop }};
    --rp-gap: {{ section.settings.card_gap }}px;
    --rp-image-ratio: {{ section.settings.image_ratio }};
    --rp-image-position: {{ section.settings.image_position }};
    --rp-padding-top: {{ section.settings.padding_top }}px;
    --rp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rp-container-width: {{ section.settings.container_width }}%;
  "
>

  <div class="rental-products__container">

    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="rental-products__header">

        <div class="rental-products__header-content">

          {% if section.settings.heading != blank %}
            <h2 class="rental-products__heading">
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="rental-products__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

        </div>

        {% if section.settings.show_arrows %}
          <div class="rental-products__navigation">

            <button
              type="button"
              class="rental-products__arrow rental-products__arrow--prev"
              aria-label="Previous products"
              disabled
            >
              <span aria-hidden="true">←</span>
            </button>

            <button
              type="button"
              class="rental-products__arrow rental-products__arrow--next"
              aria-label="Next products"
            >
              <span aria-hidden="true">→</span>
            </button>

          </div>
        {% endif %}

      </div>
    {% endif %}


    <div class="rental-products__slider">

      <div
        class="rental-products__grid"
        data-slider
        data-loop="{{ section.settings.loop_slider }}"
      >

        {% for block in section.blocks %}

          {% assign product = block.settings.product %}

          <article
            class="rental-product-card"
            {{ block.shopify_attributes }}
          >

            <!-- IMAGE -->
            <div class="rental-product-card__media">

              {% if product != blank and product.featured_image != blank %}

                <a
                  href="{{ product.url }}"
                  class="rental-product-card__image-link"
                  aria-label="{{ product.title | escape }}"
                >

                  {{
                    product.featured_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '500, 700, 900, 1200',
                      sizes: '(max-width: 749px) 88vw, (max-width: 989px) 50vw, 33vw',
                      loading: 'lazy',
                      class: 'rental-product-card__image',
                      alt: product.featured_image.alt | default: product.title
                  }}

                </a>

              {% else %}

                <div class="rental-product-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}


              <!-- WISHLIST -->
              {% if section.settings.show_wishlist %}

                <button
                  type="button"
                  class="rental-product-card__wishlist"
                  aria-label="Add to wishlist"
                  data-product-handle="{% if product != blank %}{{ product.handle }}{% endif %}"
                >
                  <span aria-hidden="true">♡</span>
                </button>

              {% endif %}


              <!-- LOOK LABEL -->
              {% if section.settings.show_look_label and block.settings.look_label != blank %}

                <div class="rental-product-card__look-label">
                  {{ block.settings.look_label | escape }}
                </div>

              {% endif %}

            </div>


            <!-- PRODUCT DETAILS -->
            <div class="rental-product-card__details">

              <!-- BRAND -->
              {% if block.settings.brand != blank %}

                <p class="rental-product-card__brand">
                  {{ block.settings.brand | escape }}
                </p>

              {% elsif product != blank and product.vendor != blank %}

                <p class="rental-product-card__brand">
                  {{ product.vendor | escape }}
                </p>

              {% endif %}


              <!-- TITLE -->
              {% if product != blank %}

                <h3 class="rental-product-card__title">
                  <a href="{{ product.url }}">
                    {{ product.title | escape }}
                  </a>
                </h3>

              {% elsif block.settings.custom_title != blank %}

                <h3 class="rental-product-card__title">
                  {{ block.settings.custom_title | escape }}
                </h3>

              {% endif %}


              <!-- PRICE -->
              {% if product != blank %}

                <div class="rental-product-card__pricing">

                  {% if product.compare_at_price_max > product.price %}

                    <span class="rental-product-card__compare">
                      {{ product.compare_at_price_max | money }}
                    </span>

                  {% endif %}

                  <span class="rental-product-card__price">
                    {{ product.price | money }}
                  </span>

                  {% if section.settings.price_suffix != blank %}

                    <span class="rental-product-card__suffix">
                      {{ section.settings.price_suffix | escape }}
                    </span>

                  {% endif %}

                </div>

              {% elsif block.settings.custom_price != blank %}

                <div class="rental-product-card__pricing">

                  <span class="rental-product-card__price">
                    {{ block.settings.custom_price | escape }}
                  </span>

                </div>

              {% endif %}


              <!-- ACTIONS -->
              <div class="rental-product-card__actions">

                {% if product != blank %}

                  <a
                    href="{{ product.url }}"
                    class="rental-product-card__button"
                  >
                    {{ section.settings.button_label | escape }}
                  </a>

                {% elsif block.settings.link != blank %}

                  <a
                    href="{{ block.settings.link }}"
                    class="rental-product-card__button"
                  >
                    {{ section.settings.button_label | escape }}
                  </a>

                {% else %}

                  <span class="rental-product-card__button">
                    {{ section.settings.button_label | escape }}
                  </span>

                {% endif %}


                {% if section.settings.show_secondary_button %}

                  {% if product != blank %}

                    <a
                      href="{{ product.url }}"
                      class="rental-product-card__secondary"
                      aria-label="View {{ product.title | escape }}"
                    >
                      <span aria-hidden="true">↗</span>
                    </a>

                  {% elsif block.settings.link != blank %}

                    <a
                      href="{{ block.settings.link }}"
                      class="rental-product-card__secondary"
                      aria-label="View product"
                    >
                      <span aria-hidden="true">↗</span>
                    </a>

                  {% endif %}

                {% endif %}

              </div>


              <!-- NOTE -->
              {% if section.settings.show_meta_note and section.settings.meta_note != blank %}

                <p class="rental-product-card__note">
                  {{ section.settings.meta_note | escape }}
                </p>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

    </div>

  </div>

</section>


<style>

  /* ========================================
     BASE
  ======================================== */

  #rental-products-{{ section.id }} {
    background: var(--rp-bg);
    color: var(--rp-text);

    padding-top: var(--rp-padding-top);
    padding-bottom: var(--rp-padding-bottom);

    overflow: hidden;
  }


  #rental-products-{{ section.id }} *,
  #rental-products-{{ section.id }} *::before,
  #rental-products-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* ========================================
     CONTAINER
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-products__container {

    width: min(
      var(--rp-container-width),
      calc(100% - 50px)
    );

    margin: 0 auto;
  }


  /* ========================================
     HEADER
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-products__header {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 40px;

    margin-bottom: 45px;
  }


  #rental-products-{{ section.id }}
  .rental-products__header-content {

    min-width: 0;
  }


  #rental-products-{{ section.id }}
  .rental-products__heading {

    max-width: 700px;

    margin: 0;

    color: var(--rp-text);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        40px,
        5vw,
        70px
      );

    font-weight: 400;

    line-height: .96;

    letter-spacing: -.045em;
  }


  #rental-products-{{ section.id }}
  .rental-products__description {

    max-width: 430px;

    margin-top: 18px;

    color: var(--rp-muted);

    font-size: 17px;

    line-height: 1.75;
  }


  /* ========================================
     NAVIGATION
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-products__navigation {

    display: flex;

    align-items: center;

    gap: 8px;

    flex-shrink: 0;
  }


  #rental-products-{{ section.id }}
  .rental-products__arrow {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 48px;

    height: 48px;

    padding: 0;

    border: 1px solid var(--rp-button-border);

    border-radius: 50%;

    color: var(--rp-text);

    background: transparent;

    font-size: 18px;

    line-height: 1;

    cursor: pointer;

    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      opacity 200ms ease,
      transform 200ms ease;
  }


  #rental-products-{{ section.id }}
  .rental-products__arrow:hover:not(:disabled) {

    color: #fff;

    background: var(--rp-button-bg);

    border-color: var(--rp-button-bg);

    transform: translateY(-1px);
  }


  #rental-products-{{ section.id }}
  .rental-products__arrow:disabled {

    opacity: .3;

    cursor: not-allowed;
  }


  /* ========================================
     SLIDER
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-products__slider {

    position: relative;

    width: 100%;
  }


  #rental-products-{{ section.id }}
  .rental-products__grid {

    display: flex;

    gap: var(--rp-gap);

    width: 100%;

    overflow-x: auto;

    overflow-y: hidden;

    scroll-behavior: smooth;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;

    -webkit-overflow-scrolling: touch;

    overscroll-behavior-x: contain;
  }


  #rental-products-{{ section.id }}
  .rental-products__grid::-webkit-scrollbar {

    display: none;
  }


  /* ========================================
     PRODUCT CARD
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card {

    min-width: 0;

    flex:
      0 0
      calc(
        (
          100% -
          (
            (var(--rp-columns) - 1)
            * var(--rp-gap)
          )
        )
        /
        var(--rp-columns)
      );

    border-right:
      1px solid
      rgba(53, 21, 28, .85);

    scroll-snap-align: start;

    scroll-snap-stop: always;
  }


  #rental-products-{{ section.id }}
  .rental-product-card:last-child {

    border-right: 0;
  }


  /* ========================================
     PRODUCT IMAGE
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__media {

    position: relative;

    overflow: hidden;

    aspect-ratio:
      var(--rp-image-ratio);

    background: #d5b386;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__image-link {

    display: block;

    width: 100%;
    height: 100%;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__image {

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position:
      var(--rp-image-position);

    transition:
      transform 650ms
      cubic-bezier(.2, .65, .25, 1);
  }


  #rental-products-{{ section.id }}
  .rental-product-card:hover
  .rental-product-card__image {

    transform: scale(1.025);
  }


  /* ========================================
     PLACEHOLDER
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__placeholder {

    width: 100%;
    height: 100%;

    background: #d5b386;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__placeholder svg {

    width: 100%;
    height: 100%;
  }


  /* ========================================
     DIAGONAL TEXTURE
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__media::after {

    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: .24;

   
    mix-blend-mode: screen;
  }


  /* ========================================
     WISHLIST
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__wishlist {

    position: absolute;

    z-index: 5;

    top: 18px;
    right: 18px;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 39px;
    height: 39px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    color: var(--rp-text);

    background:
      rgba(
        255,
        249,
        239,
        .92
      );

    font-size: 19px;

    line-height: 1;

    cursor: pointer;

    transition:
      transform 200ms ease,
      background-color 200ms ease;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__wishlist:hover {

    transform: scale(1.06);

    background: #fff;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__wishlist.is-active {

    color: #7a1f2d;
  }


  /* ========================================
     LOOK LABEL
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__look-label {

    position: absolute;

    z-index: 4;

    bottom: 8px;
    left: 50%;

    transform:
      translateX(-50%);

    width: max-content;

    max-width: 90%;

    color: #fff;

    font-size: 11px;

    font-weight: 400;

    letter-spacing: .06em;

    text-align: center;

    text-transform: uppercase;
  }


  /* ========================================
     DETAILS
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__details {

    padding:
      27px
      28px
      26px;
  }


  /* ========================================
     BRAND
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__brand {

    margin:
      0
      0
      10px;

    color: var(--rp-accent);

    font-size: 10px;

    font-weight: 500;

    line-height: 1.3;

    letter-spacing: .18em;

    text-transform: uppercase;
  }


  /* ========================================
     TITLE
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__title {

    margin: 0;

    color: var(--rp-text);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        22px,
        1.55vw,
        29px
      );

    font-weight: 400;

    line-height: 1.16;

    letter-spacing: -.02em;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__title a {

    color: inherit;

    text-decoration: none;
  }


  /* ========================================
     PRICING
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__pricing {

    display: flex;

    align-items: baseline;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 21px;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__compare {

    color: #9f9186;

    font-size: 13px;

    text-decoration: line-through;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__price {

    color: var(--rp-text);

    font-size: 18px;

    font-style: italic;

    font-weight: 600;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__suffix {

    color: var(--rp-text);

    font-size: 17px;

    font-style: italic;
  }


  /* ========================================
     ACTIONS
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__actions {

    display: flex;

    align-items: stretch;

    gap: 10px;

    margin-top: 20px;
  }


  /* Main button */

  #rental-products-{{ section.id }}
  .rental-product-card__button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 40px;

    padding:
      0
      24px;

    border:
      1px solid
      var(--rp-button-bg);

    color: var(--rp-button-text);

    background: var(--rp-button-bg);

    font-size: 10px;

    font-weight: 500;

    line-height: 1;

    letter-spacing: .06em;

    text-decoration: none;

    text-transform: uppercase;

    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__button:hover {

    color: var(--rp-button-bg);

    background: transparent;
  }


  /* Secondary */

  #rental-products-{{ section.id }}
  .rental-product-card__secondary {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 42px;

    min-width: 42px;

    border:
      1px solid
      var(--rp-button-border);

    color: var(--rp-text);

    background: transparent;

    font-size: 15px;

    text-decoration: none;

    transition:
      background-color 200ms ease,
      color 200ms ease;
  }


  #rental-products-{{ section.id }}
  .rental-product-card__secondary:hover {

    color: #fff;

    background: var(--rp-button-bg);
  }


  /* ========================================
     NOTE
  ======================================== */

  #rental-products-{{ section.id }}
  .rental-product-card__note {

    margin:
      13px
      0
      0;

    color: var(--rp-muted);

    font-size: 10px;

    line-height: 1.5;

    letter-spacing: .02em;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media screen and (max-width: 989px) {

    #rental-products-{{ section.id }}
    .rental-products__container {

      width:
        calc(100% - 40px);
    }


    #rental-products-{{ section.id }}
    .rental-products__header {

      align-items: flex-end;

      margin-bottom: 35px;
    }


    #rental-products-{{ section.id }}
    .rental-products__description {

      max-width: 600px;
    }


    #rental-products-{{ section.id }}
    .rental-products__grid {

      gap: 18px;
    }


    #rental-products-{{ section.id }}
    .rental-product-card {

      flex:
        0 0
        calc(
          (
            100% - 18px
          ) / 2
        );

      border-right: 0;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__details {

      padding:
        24px
        20px;
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media screen and (max-width: 749px) {

    #rental-products-{{ section.id }} {

      padding-top:
        min(
          var(--rp-padding-top),
          55px
        );

      padding-bottom:
        min(
          var(--rp-padding-bottom),
          55px
        );
    }


    #rental-products-{{ section.id }}
    .rental-products__container {

      width:
        calc(
          100% - 32px
        );
    }


    #rental-products-{{ section.id }}
    .rental-products__header {

      display: block;

      margin-bottom: 30px;
    }


    #rental-products-{{ section.id }}
    .rental-products__heading {

      font-size:
        clamp(
          40px,
          12vw,
          58px
        );
    }


    #rental-products-{{ section.id }}
    .rental-products__description {

      margin-top: 18px;

      max-width: 100%;
    }


    #rental-products-{{ section.id }}
    .rental-products__navigation {

      display: none;
    }


    #rental-products-{{ section.id }}
    .rental-products__grid {

      gap: 14px;

      margin-right: -16px;

      padding-right: 16px;

      padding-bottom: 5px;
    }


    #rental-products-{{ section.id }}
    .rental-product-card {

      flex:
        0 0 84vw;

      width: 84vw;

      border-right: 0;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__details {

      padding:
        22px
        0
        25px;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__title {

      font-size: 24px;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__button {

      padding:
        0
        20px;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__wishlist {

      top: 12px;

      right: 12px;
    }

  }


  /* ========================================
     REDUCED MOTION
  ======================================== */

  @media (prefers-reduced-motion: reduce) {

    #rental-products-{{ section.id }}
    .rental-products__grid {

      scroll-behavior: auto;
    }


    #rental-products-{{ section.id }}
    .rental-product-card__image,

    #rental-products-{{ section.id }}
    .rental-product-card__wishlist,

    #rental-products-{{ section.id }}
    .rental-product-card__button,

    #rental-products-{{ section.id }}
    .rental-product-card__secondary,

    #rental-products-{{ section.id }}
    .rental-products__arrow {

      transition: none;
    }

  }

</style>


<script>

  (function() {

    var sectionId = 'rental-products-{{ section.id }}';

    var section = document.getElementById(sectionId);

    if (!section) return;


    /* ========================================
       SLIDER
    ======================================== */

    var slider =
      section.querySelector('[data-slider]');

    var prevButton =
      section.querySelector(
        '.rental-products__arrow--prev'
      );

    var nextButton =
      section.querySelector(
        '.rental-products__arrow--next'
      );


    if (slider) {

      var cards =
        slider.querySelectorAll(
          '.rental-product-card'
        );


      function getScrollAmount() {

        if (!cards.length) return 0;

        var firstCard = cards[0];

        var cardWidth =
          firstCard.getBoundingClientRect().width;

        var sliderStyles =
          window.getComputedStyle(slider);

        var gap =
          parseFloat(sliderStyles.columnGap || sliderStyles.gap) || 0;

        return cardWidth + gap;
      }


      function updateButtons() {

        if (!prevButton && !nextButton) return;


        var maxScroll =
          slider.scrollWidth - slider.clientWidth;


        var currentScroll =
          slider.scrollLeft;


        if (prevButton) {

          prevButton.disabled =
            currentScroll <= 5;
        }


        if (nextButton) {

          nextButton.disabled =
            currentScroll >= maxScroll - 5;
        }

      }


      function scrollNext() {

        var amount =
          getScrollAmount();

        if (!amount) return;


        var maxScroll =
          slider.scrollWidth - slider.clientWidth;


        var target =
          slider.scrollLeft + amount;


        if (
          target >=
          maxScroll - 5
        ) {

          if (
            slider.dataset.loop === 'true'
          ) {

            slider.scrollTo({
              left: 0,
              behavior: 'smooth'
            });

          } else {

            slider.scrollTo({
              left: maxScroll,
              behavior: 'smooth'
            });

          }

        } else {

          slider.scrollTo({
            left: target,
            behavior: 'smooth'
          });

        }

      }


      function scrollPrevious() {

        var amount =
          getScrollAmount();


        if (!amount) return;


        var target =
          slider.scrollLeft - amount;


        if (target <= 5) {

          if (
            slider.dataset.loop === 'true'
          ) {

            slider.scrollTo({
              left:
                slider.scrollWidth -
                slider.clientWidth,
              behavior: 'smooth'
            });

          } else {

            slider.scrollTo({
              left: 0,
              behavior: 'smooth'
            });

          }

        } else {

          slider.scrollTo({
            left: target,
            behavior: 'smooth'
          });

        }

      }


      if (nextButton) {

        nextButton.addEventListener(
          'click',
          function() {

            scrollNext();

          }
        );

      }


      if (prevButton) {

        prevButton.addEventListener(
          'click',
          function() {

            scrollPrevious();

          }
        );

      }


      slider.addEventListener(
        'scroll',
        function() {

          window.requestAnimationFrame(
            updateButtons
          );

        },
        {
          passive: true
        }
      );


      window.addEventListener(
        'resize',
        updateButtons
      );


      updateButtons();

    }


    /* ========================================
       WISHLIST
    ======================================== */

    section.addEventListener(
      'click',
      function(event) {

        var wishlistButton =
          event.target.closest(
            '.rental-product-card__wishlist'
          );


        if (!wishlistButton) return;


        event.preventDefault();


        wishlistButton.classList.toggle(
          'is-active'
        );


        var icon =
          wishlistButton.querySelector(
            'span'
          );


        if (icon) {

          icon.textContent =
            wishlistButton.classList.contains(
              'is-active'
            )
              ? '♥'
              : '♡';

        }

      }
    );


  })();

</script>


