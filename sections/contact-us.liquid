{% comment %}
  ============================================================================
  sections/contact-us.liquid — nostringscouture "Contact Us" section
  ----------------------------------------------------------------------------
  WHY IT WASN'T SHOWING UP
  Sections only appear in the theme editor's "Add section" list when the
  file has a valid {% schema %} block at the bottom, AND it does NOT contain
  a full <html>/<head>/<body> document (that's only valid in a top-level
  template with {% layout none %}). This version fixes both.

  HOW TO USE
  1. Save this as sections/contact-us.liquid (you've already got the filename
     right).
  2. Create a Page called "Contact" in Shopify admin, with a JSON template.
     Easiest path:
       - Online Store → Pages → Add page → title "Contact" → Save.
       - Online Store → Themes → Customize → open the Contact page from the
         page picker at the top.
       - Shopify will offer to create templates/page.contact.json for you.
       - Click "Add section" and choose "Contact us" (this section) from the
         list — it'll appear now that the schema block exists below.
  3. The header/announcement bar and footer are intentionally left OUT of
     this section, so your theme's own header/footer sections (already in
     your theme.liquid or JSON templates) keep working normally — this
     section just drops into the content area between them.
  4. Update the WhatsApp number, address, and social links in the "Settings"
     panel in the theme customizer once this section is added — they're
     exposed as section settings below instead of being hardcoded.
  ============================================================================
{% endcomment %}

<style>
.contact-us-section{
  --ink:#2A1015;
  --ink-soft:#3D1E22;
  --ivory:#F7F1E6;
  --ivory-deep:#EFE5D4;
  --gold:#B8935A;
  --gold-bright:#D4AC72;
  --rose:#C79088;
  --text:#2A1015;
  --text-soft:#6B4C48;
  font-family:'Jost', sans-serif;
  font-weight:300;
  color:var(--text);
  background:var(--ivory);
}
.contact-us-section h1,
.contact-us-section h2,
.contact-us-section h3{
  font-family:'Fraunces', serif;
  font-weight:500;
  letter-spacing:-0.01em;
  color:var(--ink);
}
.contact-us-section a{color:inherit; text-decoration:none;}
.contact-us-section .eyebrow{
  font-family:'Jost',sans-serif;
  text-transform:uppercase;
  letter-spacing:0.22em;
  font-size:11px;
  color:var(--gold);
  font-weight:500;
}
.contact-us-section .wrap{max-width:1240px; margin:0 auto; padding:0 48px;}
@media(max-width:768px){.contact-us-section .wrap{padding:0 22px;}}

/* drape line signature */
.contact-us-section .drape-svg{position:absolute; pointer-events:none;}
.contact-us-section .drape-path{
  fill:none; stroke:var(--gold); stroke-width:1.4;
  stroke-dasharray:1400; stroke-dashoffset:1400;
  animation:cu-draw 2.6s ease forwards 0.3s;
}
@keyframes cu-draw{to{stroke-dashoffset:0;}}
@media (prefers-reduced-motion: reduce){.contact-us-section .drape-path{animation:none; stroke-dashoffset:0;}}

/* breadcrumb */
.contact-us-section .breadcrumb{padding:26px 0 0; font-size:12.5px; color:var(--text-soft);}
.contact-us-section .breadcrumb .sep{margin:0 8px; opacity:0.5;}
.contact-us-section .breadcrumb .current{color:var(--ink);}
.contact-us-section .breadcrumb a:hover{color:var(--gold);}

/* contact hero */
.contact-us-section .contact-hero{padding:80px 0 60px; position:relative; overflow:hidden; text-align:center;}
.contact-us-section .contact-hero-drape{position:absolute; top:0; left:50%; transform:translateX(-50%); width:260px; height:90px; opacity:0.6; pointer-events:none;}
.contact-us-section .contact-hero h1{font-size:clamp(32px,4.4vw,54px); margin-top:14px;}
.contact-us-section .contact-hero p{font-size:14.5px; color:var(--text-soft); max-width:440px; margin:20px auto 0; line-height:1.8;}

.contact-us-section .contact-layout{
  display:grid; grid-template-columns:1fr 1.15fr; gap:64px; align-items:start;
  padding-bottom:110px;
}
@media(max-width:900px){.contact-us-section .contact-layout{grid-template-columns:1fr; gap:50px;}}

.contact-us-section .contact-info-block{margin-bottom:36px;}
.contact-us-section .contact-info-block h4{
  font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--gold);
  font-weight:500; margin-bottom:14px;
}
.contact-us-section .contact-channel{
  display:flex; gap:16px; align-items:flex-start; padding:18px 0;
  border-bottom:1px solid rgba(42,16,21,0.08);
}
.contact-us-section .contact-channel:first-of-type{border-top:1px solid rgba(42,16,21,0.08);}
.contact-us-section .contact-channel .c-icon{
  width:40px; height:40px; border-radius:50%; border:1px solid rgba(184,147,90,0.4);
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.contact-us-section .contact-channel .c-icon svg{width:17px; height:17px; stroke:var(--gold); fill:none; stroke-width:1.4;}
.contact-us-section .contact-channel .c-text a,
.contact-us-section .contact-channel .c-text span{display:block;}
.contact-us-section .contact-channel .c-label{font-size:12.5px; color:var(--text-soft); margin-bottom:3px;}
.contact-us-section .contact-channel .c-value{font-size:15px; color:var(--ink); font-family:'Fraunces'; font-style:italic;}
.contact-us-section .contact-channel .c-value.plain{font-family:'Jost'; font-style:normal; font-size:14px;}

.contact-us-section .contact-hours{display:flex; flex-direction:column; gap:8px; font-size:13.5px; color:var(--text-soft);}
.contact-us-section .contact-hours .row{display:flex; justify-content:space-between; max-width:280px;}
.contact-us-section .contact-hours .row span:last-child{color:var(--ink);}

.contact-us-section .contact-social-row{display:flex; gap:12px; margin-top:6px;}
.contact-us-section .btn-icon{
  width:42px; height:42px; border:1px solid rgba(42,16,21,0.25); border-radius:2px;
  display:flex; align-items:center; justify-content:center; font-size:16px; color:var(--ink);
  transition:all .25s ease; flex-shrink:0;
}
.contact-us-section .btn-icon:hover{border-color:var(--gold); color:var(--gold);}

.contact-us-section .contact-form-card{
  background:var(--ivory-deep); padding:48px 44px; border-radius:2px; position:relative;
}
@media(max-width:560px){.contact-us-section .contact-form-card{padding:34px 24px;}}
.contact-us-section .contact-form-card h3{font-size:22px; margin-bottom:8px;}
.contact-us-section .contact-form-card > p{font-size:13.5px; color:var(--text-soft); margin-bottom:30px; line-height:1.7;}
.contact-us-section .cf-row{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;}
@media(max-width:560px){.contact-us-section .cf-row{grid-template-columns:1fr;}}
.contact-us-section .cf-field{display:flex; flex-direction:column; gap:8px; margin-bottom:20px;}
.contact-us-section .cf-field label{font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase; color:var(--text-soft);}
.contact-us-section .cf-field input,
.contact-us-section .cf-field select,
.contact-us-section .cf-field textarea{
  background:var(--ivory); border:1px solid rgba(42,16,21,0.15); border-radius:2px;
  padding:13px 14px; font-family:'Jost'; font-size:14px; color:var(--ink); outline:none;
  transition:border-color .25s ease; width:100%;
}
.contact-us-section .cf-field input:focus,
.contact-us-section .cf-field select:focus,
.contact-us-section .cf-field textarea:focus{border-color:var(--gold);}
.contact-us-section .cf-field textarea{resize:vertical; min-height:120px;}
.contact-us-section .cf-topic-row{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:24px;}
.contact-us-section .cf-topic{
  border:1px solid rgba(42,16,21,0.2); border-radius:100px; padding:8px 16px;
  font-size:12px; color:var(--text-soft); cursor:pointer; transition:all .25s ease;
}
.contact-us-section .cf-topic.selected{background:var(--ink); border-color:var(--ink); color:var(--ivory);}
.contact-us-section .cf-submit{
  width:100%; background:var(--ink); color:var(--ivory); padding:16px; border:none;
  border-radius:2px; font-size:12.5px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer;
  transition:background .25s ease;
}
.contact-us-section .cf-submit:hover{background:var(--gold); color:var(--ink);}
.contact-us-section .cf-note{font-size:11.5px; color:var(--text-soft); margin-top:14px; text-align:center;}

.contact-us-section .form-success{
  background:rgba(184,147,90,0.15); border:1px solid var(--gold); color:var(--ink);
  padding:14px 16px; border-radius:2px; font-size:13.5px; margin-bottom:24px;
}
.contact-us-section .form-error{
  background:rgba(199,40,40,0.08); border:1px solid #C72828; color:#8a1f1f;
  padding:14px 16px; border-radius:2px; font-size:13.5px; margin-bottom:24px;
}
.contact-us-section .form-error ul{margin:6px 0 0 18px;}
</style>

<div class="contact-us-section">

  {% if section.settings.show_breadcrumb %}
  <div class="breadcrumb">
    <div class="wrap"><a href="{{ routes.root_url }}">Home</a><span class="sep">/</span><span class="current">Contact</span></div>
  </div>
  {% endif %}

  <section class="contact-hero">
    <svg class="drape-svg contact-hero-drape" viewBox="0 0 260 90" preserveAspectRatio="none">
      <path class="drape-path" style="stroke-width:1;" d="M 10 10 C 90 70, 150 -10, 250 50"/>
    </svg>
    <div class="wrap">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>
  </section>

  <section>
    <div class="wrap contact-layout">

      <!-- INFO SIDE -->
      <div class="contact-info-side">

        <div class="contact-info-block">
          <h4>Reach us</h4>

          {% if section.settings.whatsapp_number != blank %}
          <div class="contact-channel">
            <span class="c-icon"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-4.4 7.4 8.5 8.5 0 0 1-8.9-.6L3 20l1.7-4.7a8.5 8.5 0 0 1-.7-3.4A8.5 8.5 0 1 1 21 11.5Z"/></svg></span>
            <div class="c-text">
              <span class="c-label">WhatsApp us</span>
              <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}" class="c-value plain" target="_blank" rel="noopener">{{ section.settings.whatsapp_number }}</a>
            </div>
          </div>
          {% endif %}

          <div class="contact-channel">
            <span class="c-icon"><svg viewBox="0 0 24 24"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/><path d="m3.5 7 8.5 6 8.5-6"/></svg></span>
            <div class="c-text">
              <span class="c-label">Email</span>
              <a href="mailto:{{ section.settings.contact_email | default: shop.email }}" class="c-value">{{ section.settings.contact_email | default: shop.email }}</a>
            </div>
          </div>

          {% if section.settings.studio_address != blank %}
          <div class="contact-channel">
            <span class="c-icon"><svg viewBox="0 0 24 24"><path d="M20 10.5c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10.5" r="2.5"/></svg></span>
            <div class="c-text">
              <span class="c-label">Studio &amp; pickup point</span>
              <span class="c-value plain">{{ section.settings.studio_address }}</span>
            </div>
          </div>
          {% endif %}
        </div>

        {% if section.settings.hours_weekday != blank or section.settings.hours_weekend != blank %}
        <div class="contact-info-block">
          <h4>Studio hours</h4>
          <div class="contact-hours">
            {% if section.settings.hours_weekday != blank %}
              <div class="row"><span>Monday – Saturday</span><span>{{ section.settings.hours_weekday }}</span></div>
            {% endif %}
            {% if section.settings.hours_weekend != blank %}
              <div class="row"><span>Sunday</span><span>{{ section.settings.hours_weekend }}</span></div>
            {% endif %}
          </div>
        </div>
        {% endif %}

        <div class="contact-info-block" style="margin-bottom:0;">
          <h4>Follow along</h4>
          <div class="contact-social-row">
            {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" class="btn-icon" aria-label="Instagram">◎</a>{% endif %}
            {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" class="btn-icon" aria-label="Facebook">f</a>{% endif %}
            {% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}" class="btn-icon" aria-label="Pinterest">P</a>{% endif %}
          </div>
        </div>

      </div>

      <!-- FORM SIDE -->
      <div class="contact-form-card">
        <h3>Send us a message</h3>
        <p>Fill this in and we'll get back to you within 24 hours, sooner if it's about an upcoming event date.</p>

        {% form 'contact', id: 'contact-form' %}

          {% if form.posted_successfully? %}
            <p class="form-success">Thanks for reaching out — our styling team will get back to you within a day.</p>
          {% endif %}

          {% if form.errors %}
            <div class="form-error">
              Please check the following:
              <ul>
                {% for field in form.errors %}
                  <li>
                    {% if field == 'form' %}
                      {{ form.errors.messages[field] }}
                    {% else %}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="cf-topic-row" id="cf-topic-row-{{ section.id }}">
            <span class="cf-topic selected" data-topic="Rental enquiry">Rental enquiry</span>
            <span class="cf-topic" data-topic="List my outfit">List my outfit</span>
            <span class="cf-topic" data-topic="Order support">Order support</span>
            <span class="cf-topic" data-topic="Something else">Something else</span>
          </div>
          <input type="hidden" name="contact[Enquiry type]" id="cf-topic-input-{{ section.id }}" value="Rental enquiry">

          <div class="cf-row">
            <div class="cf-field">
              <label for="ContactFormName-{{ section.id }}">Full name</label>
              <input type="text" id="ContactFormName-{{ section.id }}" name="contact[name]" placeholder="Your name" value="{% if customer %}{{ customer.name }}{% endif %}" required>
            </div>
            <div class="cf-field">
              <label for="ContactFormPhone-{{ section.id }}">Phone number</label>
              <input type="tel" id="ContactFormPhone-{{ section.id }}" name="contact[phone]" placeholder="+91 00000 00000" value="{% if customer %}{{ customer.phone }}{% endif %}">
            </div>
          </div>
          <div class="cf-field">
            <label for="ContactFormEmail-{{ section.id }}">Email address</label>
            <input type="email" id="ContactFormEmail-{{ section.id }}" name="contact[email]" placeholder="you@email.com" value="{% if customer %}{{ customer.email }}{% endif %}" required>
          </div>
          <div class="cf-field">
            <label for="ContactFormEventDate-{{ section.id }}">Event date <span style="text-transform:none; opacity:0.7;">(if applicable)</span></label>
            <input type="date" id="ContactFormEventDate-{{ section.id }}" name="contact[Event date]">
          </div>
          <div class="cf-field">
            <label for="ContactFormMessage-{{ section.id }}">Message</label>
            <textarea id="ContactFormMessage-{{ section.id }}" name="contact[body]" placeholder="Tell us what you're looking for, or ask us anything..." required></textarea>
          </div>
          <button type="submit" class="cf-submit">Send message</button>
          <p class="cf-note">By submitting, you agree to be contacted by {{ shop.name }} regarding your enquiry.</p>

        {% endform %}
      </div>

    </div>
  </section>

</div>

<script>
(function(){
  var row = document.getElementById('cf-topic-row-{{ section.id }}');
  var input = document.getElementById('cf-topic-input-{{ section.id }}');
  if (!row || !input) return;
  row.querySelectorAll('.cf-topic').forEach(function(el){
    el.addEventListener('click', function(){
      row.querySelectorAll('.cf-topic').forEach(function(t){ t.classList.remove('selected'); });
      this.classList.add('selected');
      input.value = this.getAttribute('data-topic');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Contact us",
  "tag": "section",
  "class": "section-contact-us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help you find the piece." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about a rental, sizing, a return, or listing your own piece with us. Reach out and our styling team will get back to you within a day." },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "info": "Include country code, e.g. +91 98765 43210", "default": "+91 98765 43210" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "info": "Defaults to your store email if left blank" },
    { "type": "text", "id": "studio_address", "label": "Studio / pickup address", "default": "A-14, Defence Colony, New Delhi 110024" },
    { "type": "header", "content": "Studio hours" },
    { "type": "text", "id": "hours_weekday", "label": "Monday–Saturday hours", "default": "11:00 AM – 7:30 PM" },
    { "type": "text", "id": "hours_weekend", "label": "Sunday hours", "default": "By appointment only" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" }
  ],
  "presets": [
    { "name": "Contact us" }
  ]
}
{% endschema %}
