<footer
  class="lm-footer"
  style="
    --lm-footer-bg: {{ section.settings.background_color }};
    --lm-footer-text: {{ section.settings.text_color }};
    --lm-footer-muted: {{ section.settings.muted_color }};
    --lm-footer-accent: {{ section.settings.accent_color }};
    --lm-footer-border: {{ section.settings.border_color }};
    --lm-footer-max-width: {{ section.settings.max_width }}px;
    --lm-footer-top: {{ section.settings.padding_top }}px;
    --lm-footer-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <!-- Decorative Curve -->
  {% if section.settings.show_curve %}
    <div class="lm-footer__curve" aria-hidden="true">
      <svg
        viewBox="0 0 1600 120"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,25 C180,105 350,105 550,30 C760,-45 890,-5 1060,55 C1240,120 1410,105 1600,20"
        />
      </svg>
    </div>
  {% endif %}

  <div class="lm-footer__container">

    <!-- ========================================= -->
    <!-- MAIN FOOTER -->
    <!-- ========================================= -->

    <div class="lm-footer__grid">

      <!-- BRAND -->
      <div class="lm-footer__brand">

        {% if section.settings.logo != blank %}
          <a
            href="{{ routes.root_url }}"
            class="lm-footer__logo-link"
            aria-label="{{ shop.name }}"
          >
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag:
                class: 'lm-footer__logo',
                loading: 'lazy',
                widths: '150,250,350,500'
            }}
          </a>
        {% else %}
          <a
            href="{{ routes.root_url }}"
            class="lm-footer__text-logo"
          >
            {{ shop.name }}
          </a>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <div class="lm-footer__description">
            {{ section.settings.brand_text }}
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="lm-footer__social">

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1"></circle>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 8h3V4h-3c-3.3 0-5 1.7-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1z"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.pinterest_url != blank %}
              <a
                href="{{ section.settings.pinterest_url }}"
                target="_blank"
                rel="noopener"
                aria-label="Pinterest"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-1.5 0-3 .4-4.4l1.1-4.7s-.3-.7-.3-1.7c0-1.6.9-2.8 2.2-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.5 2 1.6 2 1.9 0 3.3-2 3.3-4.8 0-2.5-1.8-4.2-4.4-4.2-3 0-4.8 2.3-4.8 4.6 0 .9.3 1.8.7 2.3.1.1.1.2.1.4l-.3 1.2c-.1.4-.4.5-.8.3-1.4-.7-2.2-2.8-2.2-4.5 0-3.7 2.7-7 7.8-7 4.1 0 7.3 2.9 7.3 6.7 0 4-2.5 7.2-6 7.2-1.2 0-2.3-.6-2.7-1.3l-.7 2.7c-.3 1.4-1.2 3.1-1.8 4.1.7.2 1.5.3 2.3.3a9 9 0 1 0 0-18z"></path>
                </svg>
              </a>
            {% endif %}

          </div>
        {% endif %}

      </div>


      <!-- SHOP -->
      <div class="lm-footer__column">

        {% if section.settings.shop_heading != blank %}
          <h2 class="lm-footer__heading">
            {{ section.settings.shop_heading }}
          </h2>
        {% endif %}

        {% if section.settings.shop_menu != blank %}
          <ul class="lm-footer__links" role="list">

            {% for link in section.settings.shop_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}

          </ul>
        {% endif %}

      </div>


      <!-- THE BASICS -->
      <div class="lm-footer__column">

        {% if section.settings.basics_heading != blank %}
          <h2 class="lm-footer__heading">
            {{ section.settings.basics_heading }}
          </h2>
        {% endif %}

        {% if section.settings.basics_menu != blank %}
          <ul class="lm-footer__links" role="list">

            {% for link in section.settings.basics_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}

          </ul>
        {% endif %}

      </div>


      <!-- COMPANY -->
      <div class="lm-footer__column">

        {% if section.settings.company_heading != blank %}
          <h2 class="lm-footer__heading">
            {{ section.settings.company_heading }}
          </h2>
        {% endif %}

        {% if section.settings.company_menu != blank %}
          <ul class="lm-footer__links" role="list">

            {% for link in section.settings.company_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}

          </ul>
        {% endif %}

      </div>


      <!-- NEWSLETTER -->
      <div class="lm-footer__newsletter">

        {% if section.settings.newsletter_heading != blank %}
          <h2 class="lm-footer__heading">
            {{ section.settings.newsletter_heading }}
          </h2>
        {% endif %}

        {% if section.settings.newsletter_text != blank %}
          <div class="lm-footer__newsletter-text">
            {{ section.settings.newsletter_text }}
          </div>
        {% endif %}

        {% form 'customer', class: 'lm-footer__form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <div class="lm-footer__input-wrap">

            <input
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder }}"
              autocomplete="email"
              required
              aria-label="{{ section.settings.email_placeholder }}"
            >

            <button
              type="submit"
              aria-label="Subscribe"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12h15"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </button>

          </div>

          {% if form.errors %}
            <div class="lm-footer__form-message lm-footer__form-message--error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div class="lm-footer__form-message">
              {{ section.settings.success_message }}
            </div>
          {% endif %}

        {% endform %}


        <!-- Trust badges -->

        {% if section.settings.show_badges %}

          <div class="lm-footer__badges">

            <div class="lm-footer__badge">
              <span class="lm-footer__check">
                ✓
              </span>

              <span>
                {{ section.settings.badge_one }}
              </span>
            </div>

            <div class="lm-footer__badge">
              <span class="lm-footer__check">
                ✓
              </span>

              <span>
                {{ section.settings.badge_two }}
              </span>
            </div>

          </div>

        {% endif %}

      </div>

    </div>


    <!-- ========================================= -->
    <!-- BOTTOM BAR -->
    <!-- ========================================= -->

    {% if section.settings.show_bottom_bar %}

      <div class="lm-footer__bottom">

        <div class="lm-footer__copyright">
          {{ section.settings.copyright_text }}
        </div>


        <nav class="lm-footer__policies" aria-label="Footer policies">

          {% if section.settings.show_privacy and shop.privacy_policy %}
            <a href="{{ shop.privacy_policy.url }}">
              {{ shop.privacy_policy.title }}
            </a>
          {% endif %}

          {% if section.settings.show_terms and shop.terms_of_service %}
            <a href="{{ shop.terms_of_service.url }}">
              {{ shop.terms_of_service.title }}
            </a>
          {% endif %}

          {% if section.settings.show_refund and shop.refund_policy %}
            <a href="{{ shop.refund_policy.url }}">
              {{ shop.refund_policy.title }}
            </a>
          {% endif %}

          {% if section.settings.show_shipping and shop.shipping_policy %}
            <a href="{{ shop.shipping_policy.url }}">
              {{ shop.shipping_policy.title }}
            </a>
          {% endif %}

        </nav>


        {% if section.settings.show_location %}
          <div class="lm-footer__location">
            {{ section.settings.location_text }}
          </div>
        {% endif %}

      </div>

    {% endif %}

  </div>
</footer>


<style>

  /* =========================================================
     FOOTER BASE
  ========================================================= */

  .lm-footer {
    position: relative;
    overflow: hidden;

    background: var(--lm-footer-bg);
    color: var(--lm-footer-text);

    padding-top: var(--lm-footer-top);
    padding-bottom: var(--lm-footer-bottom);
  }


  .lm-footer__container {
    width: min(
      calc(100% - 64px),
      var(--lm-footer-max-width)
    );

    margin-inline: auto;

    position: relative;
    z-index: 2;
  }


  /* =========================================================
     DECORATIVE CURVE
  ========================================================= */

  .lm-footer__curve {
    position: absolute;

    top: -1px;
    left: 0;

    width: 100%;
    height: 120px;

    pointer-events: none;

    opacity: .55;
  }


  .lm-footer__curve svg {
    display: block;

    width: 100%;
    height: 100%;
  }


  .lm-footer__curve path {
    fill: none;

    stroke: var(--lm-footer-accent);

    stroke-width: 1;
  }


  /* =========================================================
     MAIN GRID
  ========================================================= */

  .lm-footer__grid {

    display: grid;

    grid-template-columns:
      1.3fr
      .85fr
      .85fr
      .85fr
      1.25fr;

    column-gap: 42px;

    padding-bottom: 64px;

    border-bottom:
      1px solid var(--lm-footer-border);
  }


  /* =========================================================
     BRAND
  ========================================================= */

  .lm-footer__brand {
    min-width: 0;
  }


  .lm-footer__logo-link {
    display: inline-flex;

    text-decoration: none;

    margin-bottom: 26px;
  }


  .lm-footer__logo {

    display: block;

    width: auto;

    max-width: 180px;

    max-height: 70px;

    object-fit: contain;
  }


  .lm-footer__text-logo {

    display: inline-block;

    color: var(--lm-footer-text);

    text-decoration: none;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 24px;

    letter-spacing: .04em;

    margin-bottom: 24px;
  }


  .lm-footer__description {

    max-width: 270px;

    color: var(--lm-footer-muted);

    font-size: 14px;

    line-height: 1.8;
  }


  .lm-footer__description p {
    margin: 0;
  }


  /* =========================================================
     HEADINGS
  ========================================================= */

  .lm-footer__heading {

    margin: 0 0 22px;

    color: var(--lm-footer-accent);

    font-size: 11px;

    font-weight: 600;

    line-height: 1.4;

    letter-spacing: .16em;

    text-transform: uppercase;
  }


  /* =========================================================
     LINKS
  ========================================================= */

  .lm-footer__links {

    display: flex;

    flex-direction: column;

    gap: 12px;

    padding: 0;

    margin: 0;

    list-style: none;
  }


  .lm-footer__links li {
    margin: 0;
    padding: 0;
  }


  .lm-footer__links a {

    display: inline-block;

    color: var(--lm-footer-muted);

    text-decoration: none;

    font-size: 14px;

    line-height: 1.5;

    transition:
      color .25s ease,
      transform .25s ease;
  }


  .lm-footer__links a:hover {

    color: var(--lm-footer-accent);

    transform: translateX(3px);
  }


  /* =========================================================
     SOCIAL
  ========================================================= */

  .lm-footer__social {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-top: 28px;
  }


  .lm-footer__social a {

    display: flex;

    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    border:
      1px solid var(--lm-footer-accent);

    border-radius: 50%;

    color: var(--lm-footer-accent);

    transition:
      background-color .25s ease,
      color .25s ease,
      transform .25s ease;
  }


  .lm-footer__social svg {

    width: 15px;
    height: 15px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.5;

    stroke-linecap: round;

    stroke-linejoin: round;
  }


  .lm-footer__social a:hover {

    background: var(--lm-footer-accent);

    color: var(--lm-footer-bg);

    transform: translateY(-2px);
  }


  /* Facebook icon */

  .lm-footer__social a:nth-child(2) svg {
    fill: currentColor;
    stroke: none;
  }


  /* Pinterest */

  .lm-footer__social a:nth-child(3) svg {
    fill: currentColor;
    stroke: none;
  }


  /* =========================================================
     NEWSLETTER
  ========================================================= */

  .lm-footer__newsletter-text {

    max-width: 300px;

    margin-bottom: 24px;

    color: var(--lm-footer-muted);

    font-size: 14px;

    line-height: 1.7;
  }


  .lm-footer__newsletter-text p {
    margin: 0;
  }


  .lm-footer__form {
    width: 100%;
  }


  .lm-footer__input-wrap {

    display: flex;

    align-items: center;

    width: 100%;

    border-bottom:
      1px solid var(--lm-footer-border);
  }


  .lm-footer__input-wrap:focus-within {

    border-bottom-color:
      var(--lm-footer-accent);
  }


  .lm-footer__input-wrap input {

    flex: 1;

    min-width: 0;

    height: 48px;

    padding: 0;

    border: 0;

    outline: none;

    background: transparent;

    color: var(--lm-footer-text);

    font-family: inherit;

    font-size: 13px;
  }


  .lm-footer__input-wrap input::placeholder {

    color: var(--lm-footer-muted);

    opacity: .8;
  }


  .lm-footer__input-wrap button {

    flex: 0 0 auto;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    margin: 0;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--lm-footer-accent);

    cursor: pointer;
  }


  .lm-footer__input-wrap button svg {

    width: 19px;
    height: 19px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.3;

    stroke-linecap: round;

    stroke-linejoin: round;

    transition:
      transform .25s ease;
  }


  .lm-footer__input-wrap button:hover svg {

    transform: translateX(4px);
  }


  /* =========================================================
     FORM MESSAGE
  ========================================================= */

  .lm-footer__form-message {

    margin-top: 12px;

    color: var(--lm-footer-accent);

    font-size: 12px;
  }


  .lm-footer__form-message--error {

    color: #d99;
  }


  /* =========================================================
     TRUST BADGES
  ========================================================= */

  .lm-footer__badges {

    display: flex;

    flex-direction: column;

    gap: 10px;

    margin-top: 30px;
  }


  .lm-footer__badge {

    display: flex;

    align-items: center;

    gap: 9px;

    color: var(--lm-footer-muted);

    font-size: 11px;

    line-height: 1.5;
  }


  .lm-footer__check {

    display: flex;

    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 17px;
    height: 17px;

    border:
      1px solid var(--lm-footer-accent);

    border-radius: 50%;

    color: var(--lm-footer-accent);

    font-size: 10px;
  }


  /* =========================================================
     BOTTOM
  ========================================================= */

  .lm-footer__bottom {

    display: grid;

    grid-template-columns:
      1fr
      auto
      1fr;

    align-items: center;

    column-gap: 30px;

    padding-top: 22px;

    color: var(--lm-footer-muted);

    font-size: 11px;

    line-height: 1.5;
  }


  .lm-footer__copyright {
    text-align: left;
  }


  .lm-footer__policies {

    display: flex;

    flex-wrap: wrap;

    align-items: center;

    justify-content: center;

    gap: 8px 20px;
  }


  .lm-footer__policies a {

    color: var(--lm-footer-muted);

    text-decoration: none;

    transition:
      color .2s ease;
  }


  .lm-footer__policies a:hover {

    color: var(--lm-footer-accent);
  }


  .lm-footer__location {

    text-align: right;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 1100px) {

    .lm-footer__grid {

      grid-template-columns:
        1.3fr
        1fr
        1fr;

      row-gap: 48px;
    }


    .lm-footer__brand {
      grid-column: span 3;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    .lm-footer {
      padding-top: 70px;
      padding-bottom: 35px;
    }


    .lm-footer__container {

      width: min(
        calc(100% - 40px),
        var(--lm-footer-max-width)
      );
    }


    .lm-footer__grid {

      grid-template-columns: 1fr 1fr;

      gap: 42px 24px;

      padding-bottom: 45px;
    }


    .lm-footer__brand {

      grid-column: span 2;
    }


    .lm-footer__newsletter {

      grid-column: span 2;
    }


    .lm-footer__bottom {

      display: flex;

      flex-direction: column;

      gap: 16px;

      text-align: center;
    }


    .lm-footer__copyright,
    .lm-footer__location {

      text-align: center;
    }


    .lm-footer__policies {

      order: 2;
    }


    .lm-footer__location {

      order: 3;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 480px) {

    .lm-footer__grid {

      grid-template-columns: 1fr;

      gap: 35px;
    }


    .lm-footer__brand,
    .lm-footer__newsletter {

      grid-column: span 1;
    }


    .lm-footer__description {

      max-width: 300px;
    }


    .lm-footer__curve {

      height: 80px;
    }

  }

</style>


{% schema %}
{
  "name": "Luxury footer",
  "tag": "footer",
  "class": "luxury-footer-section",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    {
      "type": "checkbox",
      "id": "show_curve",
      "label": "Show decorative curve",
      "default": true
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1C0B12"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#F7F1E6"
    },

    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#B8ADB0"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B99A63"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#49343B"
    },

    {
      "type": "header",
      "content": "Brand"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand description",
      "default": "<p>Designer Indian couture on rent — lehengas, sarees and anarkalis from the country's finest names, without the strings of buying.</p>"
    },

    {
      "type": "header",
      "content": "Shop"
    },

    {
      "type": "text",
      "id": "shop_heading",
      "label": "Heading",
      "default": "Shop"
    },

    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Menu"
    },

    {
      "type": "header",
      "content": "The Basics"
    },

    {
      "type": "text",
      "id": "basics_heading",
      "label": "Heading",
      "default": "The Basics"
    },

    {
      "type": "link_list",
      "id": "basics_menu",
      "label": "Menu"
    },

    {
      "type": "header",
      "content": "Company"
    },

    {
      "type": "text",
      "id": "company_heading",
      "label": "Heading",
      "default": "Company"
    },

    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Menu"
    },

    {
      "type": "header",
      "content": "Newsletter"
    },

    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay in the know"
    },

    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Description",
      "default": "<p>New arrivals, designer drops and stories from the world of couture.</p>"
    },

    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },

    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing."
    },

    {
      "type": "header",
      "content": "Trust badges"
    },

    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show trust badges",
      "default": true
    },

