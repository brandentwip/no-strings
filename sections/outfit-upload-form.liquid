
{% comment %}
  OUTFIT UPLOAD FORM
  Shopify + FormSubmit (with client-side image compression)

  FormSubmit:
  Endpoint: https://formsubmit.co/ajax/website@brandent.in

  IMPORTANT:
  1. FormSubmit may send a one-time confirmation email to the destination
     address before submissions begin arriving normally.
  2. Images are resized and compressed in the browser before submission.
  3. PDF files are passed through without compression.
{% endcomment %}

<section
  id="outfit-upload-{{ section.id }}"
  class="ouc-section"
>

  <div class="ouc-container">

    <!-- HEADER -->
    <div class="ouc-header">

      <h1>
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.intro != blank %}
        <p>
          {{ section.settings.intro }}
        </p>
      {% endif %}

    </div>


    <!-- FORM -->
    <form
      id="ouc-form-{{ section.id }}"
      class="ouc-form"
      enctype="multipart/form-data"
      novalidate
    >

      <!-- ==============================
           FORMSUBMIT CONFIGURATION
      =============================== -->

      <input
        type="hidden"
        name="_subject"
        value="New Outfit Submission"
      >

      <input
        type="hidden"
        name="_captcha"
        value="false"
      >

      <input
        type="hidden"
        name="_template"
        value="table"
      >


      <!-- ==============================
           PERSONAL INFORMATION
      =============================== -->

      <div class="ouc-section-title">

        <span>01</span>

        <h2>
          Personal Information
        </h2>

      </div>


      <div class="ouc-grid ouc-grid-2">

        <!-- NAME -->
        <div class="ouc-field">

          <label>
            Full Name <span>*</span>
          </label>

          <input
            type="text"
            name="full_name"
            placeholder="Full Name"
            autocomplete="name"
            required
          >

          <small class="ouc-error"></small>

        </div>


        <!-- CITY -->
        <div class="ouc-field">

          <label>
            City <span>*</span>
          </label>

          <input
            type="text"
            name="city"
            placeholder="City"
            required
          >

          <small class="ouc-error"></small>

        </div>


        <!-- EMAIL -->
        <div class="ouc-field">

          <label>
            Email ID <span>*</span>
          </label>

          <input
            type="email"
            name="email"
            placeholder="Email ID"
            autocomplete="email"
            required
          >

          <small class="ouc-error"></small>

        </div>


        <!-- PHONE -->
        <div class="ouc-field">

          <label>
            Contact Number <span>*</span>
          </label>

          <div class="ouc-phone">

            <select
              name="country_code"
              aria-label="Country code"
            >
              <option value="+91">+91</option>
              <option value="+1">+1</option>
              <option value="+44">+44</option>
              <option value="+61">+61</option>
              <option value="+971">+971</option>
              <option value="+65">+65</option>
              <option value="+92">+92</option>
              <option value="+880">+880</option>
              <option value="+94">+94</option>
              <option value="+977">+977</option>
              <option value="+49">+49</option>
              <option value="+33">+33</option>
              <option value="+39">+39</option>
              <option value="+81">+81</option>
              <option value="+82">+82</option>
              <option value="+86">+86</option>
            </select>

            <input
              type="tel"
              name="phone"
              placeholder="Phone number"
              autocomplete="tel"
              required
            >

          </div>

          <small class="ouc-error"></small>

        </div>

      </div>


      <!-- ==============================
           OUTFIT DETAILS
      =============================== -->

      <div class="ouc-section-title">

        <span>02</span>

        <h2>
          Outfit Details
        </h2>

      </div>


      <div class="ouc-grid ouc-grid-2">

        <!-- DESIGNER -->
        <div class="ouc-field">

          <label>
            Name of Designer <span>*</span>
          </label>

          <input
            type="text"
            name="designer"
            placeholder="Name of Designer"
            required
          >

          <small class="ouc-error"></small>

        </div>


        <!-- PRICE -->
        <div class="ouc-field">

          <label>
            Price of Outfit <span>*</span>
          </label>

          <div class="ouc-price">

            <select
              name="currency"
              required
            >
              <option value="INR">₹ INR</option>
              <option value="USD">$ USD</option>
              <option value="GBP">£ GBP</option>
              <option value="AED">د.إ AED</option>
              <option value="EUR">€ EUR</option>
            </select>

            <input
              type="number"
              name="outfit_price"
              placeholder="Price"
              min="0"
              step="0.01"
              required
            >

          </div>

          <small class="ouc-error"></small>

        </div>


        <!-- YEAR -->
        <div class="ouc-field">

          <label>
            Year of Purchase <span>*</span>
          </label>

          <select
            name="year_of_purchase"
            required
          >

            <option value="">
              Select year
            </option>

            {% assign current_year = 'now' | date: '%Y' | plus: 0 %}

            {% for year in (2000..current_year) reversed %}
              <option value="{{ year }}">
                {{ year }}
              </option>
            {% endfor %}

          </select>

          <small class="ouc-error"></small>

        </div>


        <!-- SIZE -->
        <div class="ouc-field">

          <label>
            Outfit Size <span>*</span>
          </label>

          <select
            name="outfit_size"
            required
          >

            <option value="">
              Select size
            </option>

            <option value="XXS">XXS</option>
            <option value="XS">XS</option>
            <option value="S">S</option>
            <option value="M">M</option>
            <option value="L">L</option>
            <option value="XL">XL</option>
            <option value="XXL">XXL</option>
            <option value="XXXL">XXXL</option>
            <option value="Custom">Custom</option>
            <option value="Free Size">Free Size</option>

          </select>

          <small class="ouc-error"></small>

        </div>

      </div>


      <!-- ==============================
           MEASUREMENTS
      =============================== -->

      <div class="ouc-subtitle">

        Exact Measurements

        <span>
          (if applicable)
        </span>

      </div>


      <div class="ouc-grid ouc-grid-4">

        <div class="ouc-field">

          <label>Chest</label>

          <input
            type="text"
            name="chest"
            placeholder="Chest"
          >

        </div>


        <div class="ouc-field">

          <label>Waist</label>

          <input
            type="text"
            name="waist"
            placeholder="Waist"
          >

        </div>


        <div class="ouc-field">

          <label>Bicep</label>

          <input
            type="text"
            name="bicep"
            placeholder="Bicep"
          >

        </div>


        <div class="ouc-field">

          <label>Height</label>

          <input
            type="text"
            name="height"
            placeholder="Height"
          >

        </div>

      </div>


      <!-- ==============================
           OUTFIT IMAGES
      =============================== -->

      <div class="ouc-section-title">

        <span>03</span>

        <h2>
          Upload Outfit Images
        </h2>

      </div>


      <p class="ouc-help">
        Please upload clear images of the outfit.
        Front, back and label images are required.
      </p>


      <div class="ouc-upload-grid">

        <!-- FRONT -->
        <div class="ouc-upload">

          <input
            id="ouc-front-{{ section.id }}"
            type="file"
            name="front_outfit"
            accept="image/*"
            required
          >

          <label
            for="ouc-front-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Front of Outfit
            </strong>

            <small>
              Required · JPG, PNG, WEBP
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>


        <!-- BACK -->
        <div class="ouc-upload">

          <input
            id="ouc-back-{{ section.id }}"
            type="file"
            name="back_outfit"
            accept="image/*"
            required
          >

          <label
            for="ouc-back-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Back of Outfit
            </strong>

            <small>
              Required · JPG, PNG, WEBP
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>


        <!-- LABEL -->
        <div class="ouc-upload">

          <input
            id="ouc-label-{{ section.id }}"
            type="file"
            name="outfit_label"
            accept="image/*"
            required
          >

          <label
            for="ouc-label-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Outfit Label
            </strong>

            <small>
              Required · JPG, PNG, WEBP
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>


        <!-- DAMAGE -->
        <div class="ouc-upload">

          <input
            id="ouc-damage-{{ section.id }}"
            type="file"
            name="outfit_damage"
            accept="image/*"
          >

          <label
            for="ouc-damage-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Outfit Damage
            </strong>

            <small>
              Optional · If applicable
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>


        <!-- ADDITIONAL -->
        <div class="ouc-upload ouc-upload-wide">

          <input
            id="ouc-additional-{{ section.id }}"
            type="file"
            name="additional_detail_shots"
            accept="image/*"
            multiple
          >

          <label
            for="ouc-additional-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Additional Detail Shots
            </strong>

            <small>
              Optional · Multiple images allowed
            </small>

            <span class="ouc-file-name">
              No files selected
            </span>

          </label>

        </div>

      </div>


      <!-- ==============================
           PROOF & PACKAGING
      =============================== -->

      <div class="ouc-section-title">

        <span>04</span>

        <h2>
          Proof & Packaging
        </h2>

      </div>


      <div class="ouc-grid ouc-grid-2">

        <!-- PROOF -->
        <div class="ouc-upload">

          <input
            id="ouc-proof-{{ section.id }}"
            type="file"
            name="proof_of_purchase"
            accept="image/*,.pdf"
            required
          >

          <label
            for="ouc-proof-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Proof of Purchase
            </strong>

            <small>
              Required · Invoice / transaction / email
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>


        <!-- PACKAGING -->
        <div class="ouc-field">

          <label>
            Packaging Available? <span>*</span>
          </label>

          <select
            name="packaging_available"
            required
          >

            <option value="">
              Select option
            </option>

            <option value="Yes">
              Yes
            </option>

            <option value="No">
              No
            </option>

          </select>

          <small class="ouc-error"></small>

        </div>

      </div>


      <!-- PACKAGING IMAGE -->
      <div class="ouc-packaging-upload">

        <div class="ouc-upload">

          <input
            id="ouc-packaging-image-{{ section.id }}"
            type="file"
            name="packaging_image"
            accept="image/*"
          >

          <label
            for="ouc-packaging-image-{{ section.id }}"
            class="ouc-upload-label"
          >

            <span class="ouc-upload-icon">+</span>

            <strong>
              Packaging Image
            </strong>

            <small>
              Optional · If available
            </small>

            <span class="ouc-file-name">
              No file selected
            </span>

          </label>

        </div>

      </div>


      <!-- ==============================
           CONDITION
      =============================== -->

      <div class="ouc-section-title">

        <span>05</span>

        <h2>
          Outfit Condition
        </h2>

      </div>


      <div class="ouc-grid ouc-grid-3">

        <!-- CONDITION -->
        <div class="ouc-field">

          <label>
            Outfit Condition <span>*</span>
          </label>

          <select
            name="outfit_condition"
            required
          >

            <option value="">
              Select condition
            </option>

            <option value="Brand New">
              Brand New
            </option>

            <option value="Like New">
              Like New
            </option>

            <option value="Excellent">
              Excellent
            </option>

            <option value="Very Good">
              Very Good
            </option>

            <option value="Good">
              Good
            </option>

            <option value="Fair">
              Fair
            </option>

          </select>

          <small class="ouc-error"></small>

        </div>


        <!-- TIMES WORN -->
        <div class="ouc-field">

          <label>
            Number of Times Worn <span>*</span>
          </label>

          <select
            name="times_worn"
            required
          >

            <option value="">
              Select
            </option>

            <option value="Never">
              Never
            </option>

            <option value="1 time">
              1 time
            </option>

            <option value="2-3 times">
              2–3 times
            </option>

            <option value="4-5 times">
              4–5 times
            </option>

            <option value="6-10 times">
              6–10 times
            </option>

            <option value="10+ times">
              10+ times
            </option>

          </select>

          <small class="ouc-error"></small>

        </div>


        <!-- SELL / RENT -->
        <div class="ouc-field">

          <label>
            Sell or Rent? <span>*</span>
          </label>

          <select
            name="sell_or_rent"
            required
          >

            <option value="">
              Select option
            </option>

            <option value="Sell">
              Sell
            </option>

            <option value="Rent">
              Rent
            </option>

            <option value="Both">
              Both
            </option>

          </select>

          <small class="ouc-error"></small>

        </div>

      </div>


      <!-- ==============================
           DISCLAIMER
      =============================== -->

      <div class="ouc-disclaimer">

        <button
          type="button"
          class="ouc-disclaimer-toggle"
          aria-expanded="false"
        >

          <span>
            Submission & Consignment Disclaimer
          </span>

          <span class="ouc-disclaimer-plus">
            +
          </span>

        </button>


        <div class="ouc-disclaimer-content">

          <p>
            Thank you for submitting your outfit details. Our team will review
            the information provided and contact you to discuss the valuation,
            pricing, and next steps. Submission of this form does not guarantee
            that your outfit will be accepted for sale or rental on our platform.
          </p>

          <p>
            If both parties agree to proceed, your outfit may be listed on our
            website and other sales channels. To promote your listing, the
            company may use your outfit for marketing and promotional activities,
            including professional photoshoots, videos, social media content,
            digital advertisements, website content, email campaigns, and other
            promotional material.
          </p>

          <p>
            If your outfit is accepted, it will be offered for sale and/or rental
            at a mutually agreed price. The company will retain an agreed
            commission on every successful sale and on each rental transaction
            before the remaining proceeds are paid to you, in accordance with
            the terms communicated at the time of onboarding.
          </p>

          <p>
            <strong>
              By submitting this form, you confirm that:
            </strong>
          </p>

          <ul>

            <li>
              You are the legal owner of the outfit and have the right to consign it.
            </li>

            <li>
              All information provided is true and accurate.
            </li>

            <li>
              You have disclosed any alterations, defects, repairs, or damage.
            </li>

            <li>
              You understand that acceptance of the outfit is at the discretion
              of the company.
            </li>

            <li>
              You agree to the promotional use of your outfit.
            </li>

            <li>
              You agree that final commercial terms will be confirmed separately
              before your outfit is listed.
            </li>

          </ul>

        </div>

      </div>


      <!-- ==============================
           AGREEMENT
      =============================== -->

      <div class="ouc-agreement">

        <label class="ouc-checkbox">

          <input
            type="checkbox"
            name="disclaimer_agreement"
            value="Agreed"
            required
          >

          <span
            class="ouc-checkmark"
            aria-hidden="true"
          ></span>

          <span class="ouc-agreement-text">

            I have read and agree to the Submission & Consignment Disclaimer
            and confirm that the information provided is accurate.

          </span>

        </label>

        <small class="ouc-error"></small>

      </div>


      <!-- ==============================
           SUBMIT
      =============================== -->

      <div class="ouc-submit-wrapper">

        <button
          type="submit"
          class="ouc-submit"
        >

          <span class="ouc-submit-text">
            Continue
          </span>

          <span class="ouc-submit-loader">

            <span></span>
            <span></span>
            <span></span>

          </span>

        </button>

      </div>


      <!-- SUCCESS -->
      <div
        class="ouc-success"
        role="alert"
        aria-live="polite"
      >

        <div class="ouc-success-icon">
          ✓
        </div>

        <h3>
          Thank you for your submission.
        </h3>

        <p>
          We've received your outfit details and will review your submission.
          Our team will contact you regarding the next steps.
        </p>

      </div>


      <!-- ERROR -->
      <div
        class="ouc-form-error"
        role="alert"
        aria-live="polite"
      >
        Something went wrong. Please try again.
      </div>

    </form>

  </div>

</section>


<style>

/* ==========================================
   VARIABLES
========================================== */

#outfit-upload-{{ section.id }} {

  --ouc-text: #171717;
  --ouc-muted: #777;
  --ouc-border: #dedbd6;
  --ouc-light: #f8f7f5;
  --ouc-white: #fff;
  --ouc-accent: #171717;

  width: 100%;

  background: {{ section.settings.background_color }};

  color: var(--ouc-text);

}


/* ==========================================
   RESET
========================================== */

#outfit-upload-{{ section.id }} *,
#outfit-upload-{{ section.id }} *::before,
#outfit-upload-{{ section.id }} *::after {

  box-sizing: border-box;

}


/* ==========================================
   CONTAINER
========================================== */

#outfit-upload-{{ section.id }} .ouc-container {

  width:
    min(
      {{ section.settings.max_width }}px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding-top:
    {{ section.settings.padding_top }}px;

  padding-bottom:
    {{ section.settings.padding_bottom }}px;

}


/* ==========================================
   HEADER
========================================== */

#outfit-upload-{{ section.id }} .ouc-header {

  max-width: 800px;

  margin:
    0 auto 65px;

  text-align: center;

}


#outfit-upload-{{ section.id }} .ouc-header h1 {

  margin: 0 0 16px;

  font-size:
    {{ section.settings.heading_size }}px;

  line-height: 1.15;

  font-weight: 400;

  letter-spacing: -.025em;

}


#outfit-upload-{{ section.id }} .ouc-header p {

  margin: 0;

  color: var(--ouc-muted);

  font-size: 15px;

  line-height: 1.7;

}


/* ==========================================
   SECTION TITLES
========================================== */

#outfit-upload-{{ section.id }} .ouc-section-title {

  display: flex;

  align-items: center;

  gap: 15px;

  margin-top: 55px;

  margin-bottom: 30px;

  padding-bottom: 17px;

  border-bottom:
    1px solid var(--ouc-border);

}


#outfit-upload-{{ section.id }} .ouc-section-title > span {

  color: #999;

  font-size: 11px;

  letter-spacing: .12em;

}


#outfit-upload-{{ section.id }} .ouc-section-title h2 {

  margin: 0;

  font-size: 19px;

  font-weight: 500;

}


/* ==========================================
   GRID
========================================== */

#outfit-upload-{{ section.id }} .ouc-grid {

  display: grid;

  gap: 25px;

}


#outfit-upload-{{ section.id }} .ouc-grid-2 {

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

}


#outfit-upload-{{ section.id }} .ouc-grid-3 {

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

}


#outfit-upload-{{ section.id }} .ouc-grid-4 {

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

}


/* ==========================================
   FIELDS
========================================== */

#outfit-upload-{{ section.id }} .ouc-field {

  min-width: 0;

}


#outfit-upload-{{ section.id }} .ouc-field > label {

  display: block;

  margin-bottom: 9px;

  font-size: 12px;

  font-weight: 500;

  letter-spacing: .06em;

  text-transform: uppercase;

}


#outfit-upload-{{ section.id }} .ouc-field > label span {

  color: #a40000;

}


/* ==========================================
   INPUTS
========================================== */

#outfit-upload-{{ section.id }}
input[type="text"],
#outfit-upload-{{ section.id }}
input[type="email"],
#outfit-upload-{{ section.id }}
input[type="tel"],
#outfit-upload-{{ section.id }}
input[type="number"],
#outfit-upload-{{ section.id }}
select {

  width: 100%;

  height: 52px;

  padding: 0 15px;

  border: 1px solid var(--ouc-border);

  border-radius: 0;

  background: #fff;

  color: var(--ouc-text);

  font-family: inherit;

  font-size: 14px;

  outline: none;

  appearance: auto;

}


#outfit-upload-{{ section.id }}
input[type="text"]:focus,
#outfit-upload-{{ section.id }}
input[type="email"]:focus,
#outfit-upload-{{ section.id }}
input[type="tel"]:focus,
#outfit-upload-{{ section.id }}
input[type="number"]:focus,
#outfit-upload-{{ section.id }}
select:focus {

  border-color: #777;

  box-shadow:
    0 0 0 1px #777;

}


/* ==========================================
   PHONE / PRICE
========================================== */

#outfit-upload-{{ section.id }} .ouc-phone {

  display: grid;

  grid-template-columns: 105px 1fr;

  gap: 8px;

}


#outfit-upload-{{ section.id }} .ouc-price {

  display: grid;

  grid-template-columns: 115px 1fr;

  gap: 8px;

}


/* ==========================================
   SUBTITLE
========================================== */

#outfit-upload-{{ section.id }} .ouc-subtitle {

  margin: 38px 0 20px;

  font-size: 13px;

  font-weight: 500;

}


#outfit-upload-{{ section.id }} .ouc-subtitle span {

  color: #999;

  font-weight: 400;

}


/* ==========================================
   HELP
========================================== */

#outfit-upload-{{ section.id }} .ouc-help {

  margin: -10px 0 25px;

  color: var(--ouc-muted);

  font-size: 13px;

  line-height: 1.6;

}


/* ==========================================
   UPLOADS
========================================== */

#outfit-upload-{{ section.id }} .ouc-upload-grid {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 16px;

}


