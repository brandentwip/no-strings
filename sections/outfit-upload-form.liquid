</style>


<script>

(function() {

  var root = document.getElementById(
    'outfit-upload-{{ section.id }}'
  );

  if (!root) return;


  var form = root.querySelector(
    '#ouc-form-{{ section.id }}'
  );

  if (!form) return;


  /* ==========================================
     FORMSUBMIT CONFIGURATION
  ========================================== */

  var FORMSUBMIT_ENDPOINT =
    'https://formsubmit.co/ajax/website@brandent.in';


  /* ==========================================
     IMAGE COMPRESSION
  ========================================== */

  var COMPRESS_MAX_DIMENSION = 1600;

  var COMPRESS_QUALITY = 0.75;


  function compressImage(
    file,
    maxDimension,
    quality
  ) {

    return new Promise(
      function(resolve) {

        if (
          !file.type ||
          file.type.indexOf('image/') !== 0
        ) {

          resolve(file);

          return;

        }


        var objectUrl =
          URL.createObjectURL(file);

        var img = new Image();


        img.onload = function() {

          URL.revokeObjectURL(objectUrl);


          var largestSide =
            Math.max(
              img.width,
              img.height
            );


          var scale =
            Math.min(
              1,
              maxDimension / largestSide
            );


          var canvas =
            document.createElement('canvas');


          canvas.width =
            Math.round(
              img.width * scale
            );


          canvas.height =
            Math.round(
              img.height * scale
            );


          var ctx =
            canvas.getContext('2d');


          if (!ctx) {

            resolve(file);

            return;

          }


          ctx.drawImage(
            img,
            0,
            0,
            canvas.width,
            canvas.height
          );


          canvas.toBlob(
            function(blob) {

              if (!blob) {

                resolve(file);

                return;

              }


              var newName =
                file.name.replace(
                  /\.[^.]+$/,
                  '.jpg'
                );


              resolve(
                new File(
                  [blob],
                  newName,
                  {
                    type: 'image/jpeg'
                  }
                )
              );

            },
            'image/jpeg',
            quality
          );

        };


        img.onerror = function() {

          URL.revokeObjectURL(objectUrl);

          resolve(file);

        };


        img.src = objectUrl;

      }
    );

  }


  async function buildCompressedFormData(
    formElement
  ) {

    var formData =
      new FormData();


    var fileInputs =
      formElement.querySelectorAll(
        'input[type="file"]'
      );


    var fileInputNames = [];


    fileInputs.forEach(
      function(input) {

        fileInputNames.push(
          input.name
        );

      }
    );


    /* Copy non-file fields */

    var elements =
      formElement.elements;


    for (
      var i = 0;
      i < elements.length;
      i++
    ) {

      var el = elements[i];


      if (
        !el.name ||
        fileInputNames.indexOf(el.name) !== -1
      ) {

        continue;

      }


      if (
        el.type === 'checkbox' &&
        !el.checked
      ) {

        continue;

      }


      if (
        el.type === 'radio' &&
        !el.checked
      ) {

        continue;

      }


      formData.append(
        el.name,
        el.value
      );

    }


    /* Compress files */

    for (
      var j = 0;
      j < fileInputs.length;
      j++
    ) {

      var input =
        fileInputs[j];


      for (
        var k = 0;
        k < input.files.length;
        k++
      ) {

        var compressedFile =
          await compressImage(
            input.files[k],
            COMPRESS_MAX_DIMENSION,
            COMPRESS_QUALITY
          );


        formData.append(
          input.name,
          compressedFile,
          compressedFile.name
        );

      }

    }


    return formData;

  }


  /* ==========================================
     FILE DISPLAY
  ========================================== */

  var fileInputs =
    root.querySelectorAll(
      'input[type="file"]'
    );


  fileInputs.forEach(
    function(input) {

      input.addEventListener(
        'change',
        function() {

          var label =
            input.nextElementSibling;


          if (!label) return;


          var nameElement =
            label.querySelector(
              '.ouc-file-name'
            );


          if (!nameElement) return;


          if (
            !input.files ||
            input.files.length === 0
          ) {

            nameElement.textContent =
              input.multiple
                ? 'No files selected'
                : 'No file selected';

            return;

          }


          if (
            input.files.length === 1
          ) {

            nameElement.textContent =
              input.files[0].name;

          } else {

            nameElement.textContent =
              input.files.length +
              ' files selected';

          }

        }
      );

    }
  );


  /* ==========================================
     DISCLAIMER
  ========================================== */

  var disclaimerButton =
    root.querySelector(
      '.ouc-disclaimer-toggle'
    );


  var disclaimerContent =
    root.querySelector(
      '.ouc-disclaimer-content'
    );


  if (
    disclaimerButton &&
    disclaimerContent
  ) {

    disclaimerButton.addEventListener(
      'click',
      function() {

        var expanded =
          disclaimerButton.getAttribute(
            'aria-expanded'
          ) === 'true';


        disclaimerButton.setAttribute(
          'aria-expanded',
          String(!expanded)
        );


        disclaimerContent.classList.toggle(
          'is-open',
          !expanded
        );

      }
    );

  }


  /* ==========================================
     CLEAR ERRORS
  ========================================== */

  function clearErrors() {

    var fields =
      root.querySelectorAll(
        '.ouc-field'
      );


    fields.forEach(
      function(field) {

        field.classList.remove(
          'has-error'
        );


        var error =
          field.querySelector(
            '.ouc-error'
          );


        if (error) {

          error.textContent = '';

        }

      }
    );


    var agreement =
      root.querySelector(
        '.ouc-agreement'
      );


    if (agreement) {

      agreement.classList.remove(
        'has-error'
      );


      var agreementError =
        agreement.querySelector(
          '.ouc-error'
        );


      if (agreementError) {

        agreementError.textContent = '';

      }

    }


    var uploadLabels =
      root.querySelectorAll(
        '.ouc-upload-label'
      );


    uploadLabels.forEach(
      function(label) {

        label.style.borderColor = '';

      }
    );


    var formError =
      root.querySelector(
        '.ouc-form-error'
      );


    if (formError) {

      formError.classList.remove(
        'is-visible'
      );

    }

  }


  /* ==========================================
     FIELD ERROR
  ========================================== */

  function showFieldError(
    element,
    message
  ) {

    var field =
      element.closest(
        '.ouc-field'
      );


    if (!field) return;


    field.classList.add(
      'has-error'
    );


    var error =
      field.querySelector(
        '.ouc-error'
      );


    if (error) {

      error.textContent =
        message;

    }

  }


  /* ==========================================
     VALIDATION
  ========================================== */

  function validateForm() {

    clearErrors();


    var valid = true;


    var requiredFields =
      form.querySelectorAll(
        '[required]'
      );


    requiredFields.forEach(
      function(field) {

        /* CHECKBOX */

        if (
          field.type === 'checkbox'
        ) {

          if (!field.checked) {

            var agreement =
              root.querySelector(
                '.ouc-agreement'
              );


            if (agreement) {

              agreement.classList.add(
                'has-error'
              );


              var error =
                agreement.querySelector(
                  '.ouc-error'
                );


              if (error) {

                error.textContent =
                  'Please accept the disclaimer before continuing.';

              }

            }


            valid = false;

          }


          return;

        }


        /* FILE */

        if (
          field.type === 'file'
        ) {

          if (
            !field.files ||
            field.files.length === 0
          ) {

            var upload =
              field.closest(
                '.ouc-upload'
              );


            if (upload) {

              var label =
                upload.querySelector(
                  '.ouc-upload-label'
                );


              if (label) {

                label.style.borderColor =
                  '#a40000';

              }

            }


            valid = false;

          }


          return;

        }


        /* TEXT / SELECT */

        if (
          !field.value ||
          !String(field.value).trim()
        ) {

          showFieldError(
            field,
            'This field is required.'
          );


          valid = false;

        }

      }
    );


    /* EMAIL VALIDATION */

    var email =
      form.querySelector(
        '[name="email"]'
      );


    if (
      email &&
      email.value &&
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
        email.value
      )
    ) {

      showFieldError(
        email,
        'Please enter a valid email address.'
      );


      valid = false;

    }


    /* PHONE VALIDATION */

    var phone =
      form.querySelector(
        '[name="phone"]'
      );


    if (
      phone &&
      phone.value &&
      !/^[0-9\s()+\-]{7,20}$/.test(
        phone.value
      )
    ) {

      showFieldError(
        phone,
        'Please enter a valid phone number.'
      );


      valid = false;

    }


    return valid;

  }


  /* ==========================================
     SUBMIT
  ========================================== */

  form.addEventListener(
    'submit',
    async function(event) {

      event.preventDefault();


      if (!validateForm()) {

        var firstError =
          root.querySelector(
            '.has-error'
          );


        if (firstError) {

          firstError.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

        }


        return;

      }


      /* BUTTON */

      var submitButton =
        form.querySelector(
          '.ouc-submit'
        );


      var submitText =
        form.querySelector(
          '.ouc-submit-text'
        );


      var loader =
        form.querySelector(
          '.ouc-submit-loader'
        );


      var success =
        form.querySelector(
          '.ouc-success'
        );


      var errorMessage =
        form.querySelector(
          '.ouc-form-error'
        );


      submitButton.disabled =
        true;


      if (submitText) {

        submitText.style.display =
          'none';

      }


      if (loader) {

        loader.style.display =
          'flex';

      }


      try {

        /* Build compressed FormData */

        var formData =
          await buildCompressedFormData(
            form
          );


        /* Submit */

        var response =
          await fetch(
            FORMSUBMIT_ENDPOINT,
            {
              method: 'POST',

              body: formData,

              headers: {
                'Accept': 'application/json'
              }
            }
          );


        if (!response.ok) {

          throw new Error(
            'FormSubmit returned status ' +
            response.status
          );

        }


        var result =
          await response.json();


        console.log(
          'FormSubmit SUCCESS:',
          result
        );


        /* Reset form */

        form.reset();


        /* Reset file labels */

        fileInputs.forEach(
          function(input) {

            var label =
              input.nextElementSibling;


            if (!label) return;


            var nameElement =
              label.querySelector(
                '.ouc-file-name'
              );


            if (!nameElement) return;


            nameElement.textContent =
              input.multiple
                ? 'No files selected'
                : 'No file selected';

          }
        );


        /* Hide submit button */

        submitButton.style.display =
          'none';


        /* Show success */

        if (success) {

          success.classList.add(
            'is-visible'
          );


          success.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

        }


      } catch (error) {

        console.error(
          'FormSubmit ERROR:',
          error
        );


        if (errorMessage) {

          errorMessage.textContent =
            'We could not submit your form. Please check your information and try again.';


          errorMessage.classList.add(
            'is-visible'
          );

        }


        submitButton.disabled =
          false;


        if (submitText) {

          submitText.style.display =
            'inline';

        }


        if (loader) {

          loader.style.display =
            'none';

        }

      }

    }
  );


})();

</script>


