{{ 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Fraunces:ital,opsz,wght@1,9..144,400&family=Jost:wght@300;400;500&display=swap' | stylesheet_tag }}

<style>
  /* ============================================================
     nostringscouture — "Our Story" section
     All selectors are scoped under .nsc-story so this cannot leak
     into the rest of the theme (header/footer/other sections).
     ============================================================ */
  .nsc-story{
    --nsc-ink:#2A1015;
    --nsc-ink-soft:#3D1E22;
    --nsc-ivory:#F7F1E6;
    --nsc-ivory-deep:#EFE5D4;
    --nsc-gold:#B8935A;
    --nsc-gold-bright:#D4AC72;
    --nsc-text:#2A1015;
    --nsc-text-soft:#6B4C48;

    background:var(--nsc-ivory);
    color:var(--nsc-text);
    font-family:'Jost', sans-serif;
    font-weight:300;
    overflow-x:hidden;
  }
  .nsc-story, .nsc-story *{ box-sizing:border-box; }
  .nsc-story h1, .nsc-story h2, .nsc-story h3, .nsc-story h4{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
    color:var(--nsc-ink);
    margin:0;
  }
  .nsc-story p, .nsc-story ul, .nsc-story blockquote{ margin:0; padding:0; }
  .nsc-story ul{ list-style:none; }
  .nsc-story a{ color:inherit; text-decoration:none; }
  .nsc-story button, .nsc-story input{ font-family:'Jost', sans-serif; }

  .nsc-story__eyebrow{
    font-family:'Jost', sans-serif;
    text-transform:uppercase;
    letter-spacing:0.22em;
    font-size:11px;
    color:var(--nsc-gold);
    font-weight:500;
    display:block;
  }
  .nsc-story__wrap{ max-width:1240px; margin:0 auto; padding:0 48px; }
  @media(max-width:768px){ .nsc-story__wrap{ padding:0 22px; } }

  /* drape line signature */
  .nsc-story .nsc-drape-svg{ position:absolute; pointer-events:none; }
  .nsc-story .nsc-drape-path{
    fill:none; stroke:var(--nsc-gold); stroke-width:1.4;
    stroke-dasharray:1400; stroke-dashoffset:1400;
    animation:nsc-draw 2.6s ease forwards 0.3s;
  }
  @keyframes nsc-draw{ to{ stroke-dashoffset:0; } }
  @media (prefers-reduced-motion: reduce){ .nsc-story .nsc-drape-path{ animation:none; stroke-dashoffset:0; } }

  /* generic image placeholder block (used until a real image is set) */
  .nsc-img-block{
    background:linear-gradient(150deg,#D9C4A8 0%, #C79A66 45%, #8C5A44 100%);
    background-size:cover; background-position:center;
    position:relative; overflow:hidden;
  }
  .nsc-img-block::before{
    content:''; position:absolute; inset:0;
    background-image:repeating-linear-gradient(115deg, rgba(255,255,255,0.05) 0 2px, transparent 2px 26px);
  }
  .nsc-img-block.nsc-has-image::before{ display:none; }

  /* breadcrumb */
  .nsc-breadcrumb{ padding:18px 0; }
  .nsc-breadcrumb__wrap{ font-size:12px; color:var(--nsc-text-soft); display:flex; align-items:center; gap:8px; }
  .nsc-breadcrumb__wrap a:hover{ color:var(--nsc-gold); }
  .nsc-breadcrumb__wrap .nsc-current{ color:var(--nsc-ink); }

  /* story hero */
  .nsc-story-hero{ padding:70px 0 50px; text-align:center; position:relative; overflow:hidden; }
  .nsc-story-hero__drape{ position:absolute; top:0; left:50%; transform:translateX(-50%); width:240px; height:80px; opacity:0.6; }
  .nsc-story-hero h1{ font-size:clamp(32px,4.4vw,54px); margin-top:14px; }

  /* why-us bento grid */
  .nsc-whyus{ padding:100px 0 110px; }
  .nsc-whyus__head{ text-align:center; margin-bottom:60px; }
  .nsc-whyus__head h2{ font-size:clamp(28px,3.4vw,42px); margin-top:12px; }

  .nsc-bento-grid{
    display:grid;
    grid-template-columns:repeat(6, 1fr);
    grid-auto-rows:minmax(140px, auto);
    gap:2px;
    background:rgba(42,16,21,0.1);
    border:1px solid rgba(42,16,21,0.1);
  }
  .nsc-bento-cell{
    background:var(--nsc-ivory); padding:36px 34px; position:relative; overflow:hidden;
    display:flex; flex-direction:column; justify-content:center;
    transition:background .3s ease;
    grid-column:span 2; grid-row:span 2;
  }
  .nsc-bento-cell:hover{ background:var(--nsc-ivory-deep); }
  .nsc-bento-cell__num{
    font-family:'Fraunces'; font-style:italic; color:rgba(184,147,90,0.4); position:absolute;
    top:10px; right:18px; line-height:1; font-size:44px;
  }
  .nsc-bento-cell__icon{
    width:44px; height:44px; border-radius:50%; border:1px solid rgba(184,147,90,0.4);
    display:flex; align-items:center; justify-content:center; margin-bottom:18px; flex-shrink:0;
  }
  .nsc-bento-cell__icon svg{ width:18px; height:18px; stroke:var(--nsc-gold); fill:none; stroke-width:1.3; }
  .nsc-bento-cell h3{ font-family:'Fraunces'; font-weight:500; color:var(--nsc-ink); line-height:1.25; font-size:17px; }
  .nsc-bento-cell p{ color:var(--nsc-text-soft); line-height:1.7; margin-top:12px; font-size:12.5px; }

  .nsc-bento-cell--feature{ grid-column:span 4; grid-row:span 2; background:var(--nsc-ink); }
  .nsc-bento-cell--feature:hover{ background:var(--nsc-ink-soft); }
  .nsc-bento-cell--feature .nsc-bento-cell__num{ color:rgba(212,172,114,0.3); font-size:64px; }
  .nsc-bento-cell--feature .nsc-bento-cell__icon{ border-color:rgba(212,172,114,0.4); width:52px; height:52px; }
  .nsc-bento-cell--feature .nsc-bento-cell__icon svg{ stroke:var(--nsc-gold-bright); width:21px; height:21px; }
  .nsc-bento-cell--feature h3{ color:var(--nsc-ivory); font-size:26px; max-width:340px; }
  .nsc-bento-cell--feature p{ color:rgba(247,241,230,0.65); font-size:14.5px; max-width:360px; }

  .nsc-bento-cell--gold{ background:var(--nsc-gold); }
  .nsc-bento-cell--gold:hover{ background:var(--nsc-gold-bright); }
  .nsc-bento-cell--gold .nsc-bento-cell__num{ color:rgba(42,16,21,0.25); }
  .nsc-bento-cell--gold .nsc-bento-cell__icon{ border-color:rgba(42,16,21,0.35); }
  .nsc-bento-cell--gold .nsc-bento-cell__icon svg{ stroke:var(--nsc-ink); }
  .nsc-bento-cell--gold h3{ color:var(--nsc-ink); }
  .nsc-bento-cell--gold p{ color:rgba(42,16,21,0.65); }

  .nsc-bento-cell--wide{
    grid-column:span 6; grid-row:span 1; flex-direction:row; align-items:center; gap:28px; padding:30px 34px;
  }
  .nsc-bento-cell--wide .nsc-bento-cell__icon{ margin-bottom:0; }
  .nsc-bento-cell--wide .nsc-bento-cell__num{ position:static; font-size:36px; margin-right:4px; }
  .nsc-bento-cell--wide h3{ margin-bottom:0; }
  .nsc-bento-cell--wide p{ margin-top:4px; }
  .nsc-bento-cell--wide .nsc-bento-cell__text{ display:flex; flex-direction:column; justify-content:center; }

  @media(max-width:900px){
    .nsc-bento-grid{ grid-template-columns:repeat(2,1fr); }
    .nsc-bento-cell, .nsc-bento-cell--feature, .nsc-bento-cell--gold{ grid-column:span 2; grid-row:span 1; }
    .nsc-bento-cell--feature h3{ font-size:21px; }
    .nsc-bento-cell--wide{ grid-column:span 2; flex-direction:column; align-items:flex-start; text-align:left; }
    .nsc-bento-cell--wide .nsc-bento-cell__num{ position:absolute; top:10px; right:18px; }
  }
  @media(max-width:560px){ .nsc-bento-cell{ padding:26px 22px; } }

  /* know our customers */
  .nsc-customers{ background:var(--nsc-ivory-deep); padding:100px 0 110px; }
  .nsc-customers__head{ text-align:center; margin-bottom:60px; }
  .nsc-customers__head h2{ font-style:italic; font-weight:400; color:var(--nsc-gold); font-size:clamp(30px,3.6vw,46px); margin-top:14px; }
  .nsc-testimonial-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:26px; }
  @media(max-width:1000px){ .nsc-testimonial-grid{ grid-template-columns:repeat(2,1fr); } }
  @media(max-width:560px){ .nsc-testimonial-grid{ grid-template-columns:1fr; } }

  .nsc-testi-card{ background:var(--nsc-ivory); border-radius:2px; overflow:hidden; }
  .nsc-testi-card__media{ position:relative; aspect-ratio:4/5; overflow:hidden; background:var(--nsc-ink); }
  .nsc-testi-card__media .nsc-img-block{ height:100%; }
  .nsc-testi-card__video-wrap{ position:absolute; inset:0; overflow:hidden; }
  .nsc-testi-card__video-wrap iframe{
    position:absolute; inset:0; width:100%; height:100%; border:0; pointer-events:none;
  }
  .nsc-testi-card__unmute{
    position:absolute; top:14px; left:14px; z-index:2; background:rgba(20,7,9,0.55); color:var(--nsc-ivory);
    font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; padding:6px 12px; border-radius:100px;
  }
  .nsc-testi-card__caption{
    position:absolute; left:14px; right:14px; bottom:16px; z-index:2; background:rgba(20,7,9,0.6);
    color:var(--nsc-ivory); font-size:12px; padding:8px 12px; border-radius:2px; text-align:center; line-height:1.4;
  }
  .nsc-testi-card__body{ padding:22px 20px; }
  .nsc-testi-card__body h4{ font-family:'Fraunces'; font-size:15.5px; font-weight:500; line-height:1.35; margin-bottom:10px; }
  .nsc-testi-card__body p{ font-size:12.5px; color:var(--nsc-text-soft); line-height:1.65; font-style:italic; margin-bottom:16px; }
  .nsc-testi-card__meta{ border-top:1px solid rgba(42,16,21,0.08); padding-top:12px; font-size:11.5px; color:var(--nsc-text-soft); display:flex; flex-direction:column; gap:2px; }
  .nsc-testi-card__meta .nsc-t-name{ color:var(--nsc-ink); font-weight:500; }
  .nsc-testi-card__save{
    margin-top:10px; display:inline-block; background:var(--nsc-ivory-deep); color:var(--nsc-gold);
    font-size:10.5px; letter-spacing:0.03em; padding:5px 10px; border-radius:100px; font-weight:500;
  }

  /* featured testimonial — single wide quote below testimonials */
  .nsc-featured-testimonial{
    padding:0 0 110px;
    background:var(--nsc-ivory-deep);
  }
  .nsc-featured-testimonial__card{
    position:relative;
    border:1px solid rgba(42,16,21,0.10);
    background:var(--nsc-ivory);
    padding:58px 80px 64px;
    overflow:hidden;
  }
  .nsc-featured-testimonial__quote-mark{
    position:absolute;
    left:52px;
    top:48px;
    font-family:'Fraunces', serif;
    font-size:74px;
    line-height:1;
    color:rgba(184,147,90,0.48);
    font-style:italic;
  }
  .nsc-featured-testimonial__quote{
    position:relative;
    z-index:1;
    max-width:1160px;
    margin:0 auto;
    font-family:'Fraunces', serif;
    font-size:clamp(23px,2.2vw,31px);
    line-height:1.55;
    font-weight:500;
    font-style:italic;
    color:var(--nsc-ink);
  }
  .nsc-featured-testimonial__meta{
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    gap:12px;
    margin-top:30px;
    font-size:12px;
    color:var(--nsc-text-soft);
  }
  .nsc-featured-testimonial__name{
    color:var(--nsc-ink);
    font-weight:500;
  }
  .nsc-featured-testimonial__dot{ color:var(--nsc-gold); }
  .nsc-featured-testimonial__saved{
    display:inline-block;
    background:var(--nsc-ivory-deep);
    color:var(--nsc-gold);
    font-size:10.5px;
    letter-spacing:.03em;
    padding:7px 12px;
    border-radius:100px;
    font-weight:500;
    margin-left:4px;
  }
  @media(max-width:768px){
    .nsc-featured-testimonial{ padding-bottom:75px; }
    .nsc-featured-testimonial__card{ padding:44px 28px 42px; }
    .nsc-featured-testimonial__quote-mark{ left:18px; top:25px; font-size:56px; }
    .nsc-featured-testimonial__quote{ font-size:22px; line-height:1.5; }
    .nsc-featured-testimonial__meta{ flex-wrap:wrap; gap:8px; margin-top:24px; }
  }

  /* cta band */
  .nsc-cta{ padding:110px 0; text-align:center; }
  .nsc-cta h2{ font-size:clamp(30px,4vw,50px); max-width:640px; margin:0 auto 30px; }
  .nsc-cta__actions{ display:flex; gap:16px; align-items:center; justify-content:center; flex-wrap:wrap; }
  .nsc-btn-primary{
    background:var(--nsc-ink); color:var(--nsc-ivory); padding:16px 34px;
    border-radius:2px; font-size:13px; letter-spacing:0.08em; text-transform:uppercase;
    transition:background .3s ease; display:inline-block;
  }
  .nsc-btn-primary:hover{ background:var(--nsc-ink-soft); }
  .nsc-btn-ghost{
    font-size:13px; letter-spacing:0.05em; border-bottom:1px solid var(--nsc-gold); padding-bottom:3px; display:inline-block;
  }
</style>

<div class="nsc-story">

  {%- if section.settings.show_breadcrumb -%}
    <div class="nsc-breadcrumb">
      <div class="nsc-story__wrap nsc-breadcrumb__wrap">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label }}</a>
        <span>/</span>
        <span class="nsc-current">{{ section.settings.breadcrumb_current_label }}</span>
      </div>
    </div>
  {%- endif -%}

  <section class="nsc-story-hero">
    <svg class="nsc-drape-svg nsc-story-hero__drape" viewBox="0 0 240 80" preserveAspectRatio="none">
      <path class="nsc-drape-path" style="stroke-width:1;" d="M 10 8 C 80 60, 140 -10, 230 40"/>
    </svg>
    <div class="nsc-story__wrap">
      <span class="nsc-story__eyebrow">{{ section.settings.hero_eyebrow }}</span>
      <h1>{{ section.settings.hero_heading }}</h1>
    </div>
  </section>

  <section class="nsc-whyus">
    <div class="nsc-story__wrap">
      <div class="nsc-whyus__head">
        <span class="nsc-story__eyebrow">{{ section.settings.whyus_eyebrow }}</span>
        <h2>{{ section.settings.whyus_heading }}</h2>
      </div>

      <div class="nsc-bento-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bento_item' -%}
            {%- liquid
              assign cell_classes = 'nsc-bento-cell'
              if block.settings.layout == 'feature'
                assign cell_classes = cell_classes | append: ' nsc-bento-cell--feature'
              elsif block.settings.layout == 'wide'
                assign cell_classes = cell_classes | append: ' nsc-bento-cell--wide'
              endif
              if block.settings.gold_accent
                assign cell_classes = cell_classes | append: ' nsc-bento-cell--gold'
              endif
            -%}
            <div class="{{ cell_classes }}" {{ block.shopify_attributes }}>
              {%- if block.settings.layout == 'wide' -%}
                <span class="nsc-bento-cell__num">{{ block.settings.number_label }}</span>
                <div class="nsc-bento-cell__icon">
                  {%- render 'nsc-story-icon', icon: block.settings.icon -%}
                </div>
                <div class="nsc-bento-cell__text">
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- else -%}
                <span class="nsc-bento-cell__num">{{ block.settings.number_label }}</span>
                <div class="nsc-bento-cell__icon">
                  {%- render 'nsc-story-icon', icon: block.settings.icon -%}
                </div>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="nsc-customers">
    <div class="nsc-story__wrap">
      <div class="nsc-customers__head">
        <span class="nsc-story__eyebrow">{{ section.settings.customers_eyebrow }}</span>
        <h2>{{ section.settings.customers_heading }}</h2>
      </div>

      <div class="nsc-testimonial-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- liquid
              assign vimeo_id = ''
              if block.settings.vimeo_url != blank
                assign vimeo_clean = block.settings.vimeo_url | split: '?' | first
                assign vimeo_parts = vimeo_clean | split: '/'
                assign vimeo_id = vimeo_parts | last
              endif
            -%}
            <div class="nsc-testi-card" {{ block.shopify_attributes }}>
              <div class="nsc-testi-card__media">
                {%- if vimeo_id != blank -%}
                  <div class="nsc-testi-card__video-wrap">
                    <iframe
                      src="https://player.vimeo.com/video/{{ vimeo_id }}?background=1&autoplay=1&loop=1&muted=1&playsinline=1"
                      allow="autoplay; fullscreen; picture-in-picture"
                      title="{{ block.settings.customer_name | escape }} testimonial video"
                      data-nsc-vimeo-player
                    ></iframe>
                  </div>
                  {%- if block.settings.unmute_label != blank -%}
                    <span class="nsc-testi-card__unmute" data-nsc-unmute-btn>{{ block.settings.unmute_label }}</span>
                  {%- endif -%}
                {%- else -%}
                  <div class="nsc-img-block{% if block.settings.image %} nsc-has-image{% endif %}"
                    {%- if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 800 }});"{% endif %}>
                  </div>
                {%- endif -%}
                {%- if block.settings.video_caption != blank -%}
                  <div class="nsc-testi-card__caption">{{ block.settings.video_caption }}</div>
                {%- endif -%}
              </div>
              <div class="nsc-testi-card__body">
                <h4>{{ block.settings.headline }}</h4>
                <p>{{ block.settings.quote }}</p>
                <div class="nsc-testi-card__meta">
                  <span class="nsc-t-name">{{ block.settings.customer_name }}</span>
                  <span>{{ block.settings.location }}</span>
                </div>
                {%- if block.settings.amount_saved != blank -%}
                  <span class="nsc-testi-card__save">{{ block.settings.amount_saved }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {% if section.settings.show_featured_testimonial %}
    <section class="nsc-featured-testimonial">
      <div class="nsc-story__wrap">
        <div class="nsc-featured-testimonial__card">
          <span class="nsc-featured-testimonial__quote-mark" aria-hidden="true">“</span>
          {% if section.settings.featured_testimonial_quote != blank %}
            <blockquote class="nsc-featured-testimonial__quote">
              {{ section.settings.featured_testimonial_quote }}
            </blockquote>
          {% endif %}
          <div class="nsc-featured-testimonial__meta">
            {% if section.settings.featured_testimonial_name != blank %}
              <span class="nsc-featured-testimonial__name">{{ section.settings.featured_testimonial_name }}</span>
            {% endif %}
            {% if section.settings.featured_testimonial_name != blank and section.settings.featured_testimonial_location != blank %}
              <span class="nsc-featured-testimonial__dot">·</span>
            {% endif %}
            {% if section.settings.featured_testimonial_location != blank %}
              <span>{{ section.settings.featured_testimonial_location }}</span>
            {% endif %}
            {% if section.settings.featured_testimonial_saved != blank %}
              <span class="nsc-featured-testimonial__saved">{{ section.settings.featured_testimonial_saved }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="nsc-cta">
    <div class="nsc-story__wrap">
      <h2>{{ section.settings.cta_heading }}</h2>
      <div class="nsc-cta__actions">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_link | default: '#' }}" class="nsc-btn-primary">{{ section.settings.cta_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="nsc-btn-ghost">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      function nscInitPlayers(iframes) {
        iframes.forEach(function (iframe) {
          if (iframe.dataset.nscInit) return;
          iframe.dataset.nscInit = 'true';
          var player = new window.Vimeo.Player(iframe);
          player.setMuted(true);
          var card = iframe.closest('.nsc-testi-card__media');
          var btn = card ? card.querySelector('[data-nsc-unmute-btn]') : null;
          if (!btn) return;
          var muted = true;
          var unmuteLabel = btn.textContent;
          btn.addEventListener('click', function () {
            muted = !muted;
            player.setMuted(muted);
            btn.textContent = muted ? unmuteLabel : 'Mute';
          });
        });
      }

      function nscReady() {
        var iframes = Array.prototype.slice.call(
          document.querySelectorAll('.nsc-story [data-nsc-vimeo-player]:not([data-nsc-init])')
        );
        if (!iframes.length) return;

        if (window.Vimeo && window.Vimeo.Player) {
          nscInitPlayers(iframes);
          return;
        }
        if (window.nscVimeoScriptLoading) {
          var tries = 0;
          var iv = setInterval(function () {
            tries += 1;
            if (window.Vimeo && window.Vimeo.Player) {
              clearInterval(iv);
              nscInitPlayers(iframes);
            } else if (tries > 50) {
              clearInterval(iv);
            }
          }, 100);
          return;
        }
        window.nscVimeoScriptLoading = true;
        var script = document.createElement('script');
        script.src = 'https://player.vimeo.com/api/player.js';
        script.onload = function () {
          nscInitPlayers(iframes);
        };
        document.head.appendChild(script);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', nscReady);
      } else {
        nscReady();
      }
    })();
  </script>
</div>

