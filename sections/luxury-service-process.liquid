{% comment %}
  Section: Luxury Service Process
  - Repeatable image + text blocks
  - Alternating layout
  - Consistent spacing
  - Divider between blocks
  - Responsive mobile layout
{% endcomment %}

<section
  id="luxury-service-process-{{ section.id }}"
  class="luxury-service-process"
  style="
    --lsp-bg: {{ section.settings.background_color }};
    --lsp-text: {{ section.settings.text_color }};
    --lsp-muted: {{ section.settings.muted_color }};
    --lsp-divider: {{ section.settings.divider_color }};
    --lsp-max-width: {{ section.settings.max_width }}px;
    --lsp-row-gap: {{ section.settings.row_gap }}px;
    --lsp-column-gap: {{ section.settings.column_gap }}px;
    --lsp-image-height: {{ section.settings.image_height }}px;
  "
>

  <div class="lsp-container">

    {% if section.settings.section_label != blank or section.settings.section_title != blank %}
      <div class="lsp-header">

        {% if section.settings.section_label != blank %}
          <div class="lsp-label">
            {{ section.settings.section_label }}
          </div>
        {% endif %}

        {% if section.settings.section_title != blank %}
          <h2 class="lsp-title">
            {{ section.settings.section_title }}
          </h2>
        {% endif %}

        {% if section.settings.section_description != blank %}
          <div class="lsp-intro">
            {{ section.settings.section_description }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    <div class="lsp-list">

      {% for block in section.blocks %}

        <article
          class="lsp-item lsp-item--{{ block.settings.layout }}"
          {{ block.shopify_attributes }}
        >

          <div class="lsp-grid">

            {% if block.settings.layout == 'image-left' %}

              <!-- IMAGE -->
              <div class="lsp-image-block">

                {% if block.settings.image != blank %}

                  <div class="lsp-image-wrapper">

                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        class: 'lsp-image'
                    }}

                  </div>

                {% else %}

                  <div class="lsp-image-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>

                {% endif %}

              </div>


              <!-- TEXT -->
              <div class="lsp-text-block">

                <div class="lsp-text-inner">

                  {% if block.settings.eyebrow != blank %}
                    <div class="lsp-eyebrow">
                      {{ block.settings.eyebrow }}
                    </div>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <h3 class="lsp-heading">
                      {{ block.settings.heading }}
                    </h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="lsp-description">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <a
                      href="{{ block.settings.button_link }}"
                      class="lsp-link"
                    >
                      {{ block.settings.button_label }}
                      <span>→</span>
                    </a>
                  {% endif %}

                </div>

              </div>


            {% else %}

              <!-- TEXT -->
              <div class="lsp-text-block">

                <div class="lsp-text-inner">

                  {% if block.settings.eyebrow != blank %}
                    <div class="lsp-eyebrow">
                      {{ block.settings.eyebrow }}
                    </div>
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <h3 class="lsp-heading">
                      {{ block.settings.heading }}
                    </h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="lsp-description">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <a
                      href="{{ block.settings.button_link }}"
                      class="lsp-link"
                    >
                      {{ block.settings.button_label }}
                      <span>→</span>
                    </a>
                  {% endif %}

                </div>

              </div>


              <!-- IMAGE -->
              <div class="lsp-image-block">

                {% if block.settings.image != blank %}

                  <div class="lsp-image-wrapper">

                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        class: 'lsp-image'
                    }}

                  </div>

                {% else %}

                  <div class="lsp-image-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>

                {% endif %}

              </div>

            {% endif %}

          </div>

          <!-- DIVIDER -->
          {% if section.settings.show_dividers %}
            <div class="lsp-divider"></div>
          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

  /* =========================================================
     MAIN SECTION
  ========================================================= */

  #luxury-service-process-{{ section.id }} {
    background: var(--lsp-bg);
    color: var(--lsp-text);
    width: 100%;
  }

  #luxury-service-process-{{ section.id }} .lsp-container {
    width: min(
      calc(100% - 80px),
      var(--lsp-max-width)
    );
    margin: 0 auto;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-header {
    max-width: 720px;
    margin: 0 auto 90px;
    text-align: center;
  }

  #luxury-service-process-{{ section.id }} .lsp-label {
    font-family: inherit;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lsp-muted);
    margin-bottom: 14px;
  }

  #luxury-service-process-{{ section.id }} .lsp-title {
    margin: 0;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--lsp-text);
  }

  #luxury-service-process-{{ section.id }} .lsp-intro {
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--lsp-muted);
  }


  /* =========================================================
     CONTENT LIST
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-list {
    width: 100%;
  }


  /* =========================================================
     EACH ROW
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-item {
    width: 100%;
  }

  #luxury-service-process-{{ section.id }} .lsp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--lsp-column-gap);
    align-items: center;
    min-height: var(--lsp-image-height);
  }


  /* =========================================================
     IMAGE
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-image-block {
    width: 100%;
    min-width: 0;
  }

  #luxury-service-process-{{ section.id }} .lsp-image-wrapper {
    width: 100%;
    height: var(--lsp-image-height);
    overflow: hidden;
    background: #f5f4f1;
  }

  #luxury-service-process-{{ section.id }} .lsp-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  #luxury-service-process-{{ section.id }} .lsp-image-wrapper:hover .lsp-image {
    transform: scale(1.025);
  }

  #luxury-service-process-{{ section.id }} .lsp-image-placeholder {
    width: 100%;
    height: var(--lsp-image-height);
    background: #f5f4f1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #luxury-service-process-{{ section.id }} .lsp-image-placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.25;
  }


  /* =========================================================
     TEXT
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-text-block {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  #luxury-service-process-{{ section.id }} .lsp-text-inner {
    width: 100%;
    max-width: 430px;
  }

  #luxury-service-process-{{ section.id }} .lsp-item--image-left .lsp-text-inner {
    margin-left: auto;
  }

  #luxury-service-process-{{ section.id }} .lsp-item--image-right .lsp-text-inner {
    margin-right: auto;
  }


  /* =========================================================
     TYPOGRAPHY
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-eyebrow {
    margin-bottom: 14px;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lsp-muted);
  }

  #luxury-service-process-{{ section.id }} .lsp-heading {
    margin: 0 0 18px;
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--lsp-text);
  }

  #luxury-service-process-{{ section.id }} .lsp-description {
    font-size: 12px;
    line-height: 1.7;
    color: var(--lsp-muted);
    max-width: 420px;
  }

  #luxury-service-process-{{ section.id }} .lsp-description p {
    margin: 0 0 10px;
  }

  #luxury-service-process-{{ section.id }} .lsp-description p:last-child {
    margin-bottom: 0;
  }


  /* =========================================================
     LINK
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--lsp-text);
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }

  #luxury-service-process-{{ section.id }} .lsp-link span {
    transition: transform 0.2s ease;
  }

  #luxury-service-process-{{ section.id }} .lsp-link:hover span {
    transform: translateX(4px);
  }


  /* =========================================================
     DIVIDER
  ========================================================= */

  #luxury-service-process-{{ section.id }} .lsp-divider {
    width: 100%;
    height: 1px;
    background: var(--lsp-divider);
    margin: var(--lsp-row-gap) 0;
  }

  #luxury-service-process-{{ section.id }} .lsp-item:last-child .lsp-divider {
    display: none;
  }


  /* =========================================================
     DESKTOP SPACING
  ========================================================= */

  @media screen and (min-width: 990px) {

    #luxury-service-process-{{ section.id }} .lsp-item:first-child {
      padding-top: 0;
    }

    #luxury-service-process-{{ section.id }} .lsp-item {
      padding-bottom: 0;
    }

  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 989px) {

    #luxury-service-process-{{ section.id }} .lsp-container {
      width: min(
        calc(100% - 48px),
        var(--lsp-max-width)
      );
    }

    #luxury-service-process-{{ section.id }} .lsp-grid {
      column-gap: 30px;
      min-height: 340px;
    }

    #luxury-service-process-{{ section.id }} .lsp-image-wrapper,
    #luxury-service-process-{{ section.id }} .lsp-image-placeholder {
      height: 340px;
    }

    #luxury-service-process-{{ section.id }} .lsp-heading {
      font-size: 22px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    #luxury-service-process-{{ section.id }} .lsp-container {
      width: calc(100% - 32px);
    }

    #luxury-service-process-{{ section.id }} .lsp-header {
      margin-bottom: 50px;
      text-align: left;
    }

    #luxury-service-process-{{ section.id }} .lsp-title {
      font-size: 30px;
    }

    #luxury-service-process-{{ section.id }} .lsp-intro {
      font-size: 12px;
    }

    #luxury-service-process-{{ section.id }} .lsp-grid {
      display: flex;
      flex-direction: column;
      gap: 28px;
      min-height: auto;
    }

    /*
      Always show image first on mobile.
      This prevents alternating desktop layouts
      from creating awkward mobile spacing.
    */

    #luxury-service-process-{{ section.id }} .lsp-image-block {
      order: 1;
    }

    #luxury-service-process-{{ section.id }} .lsp-text-block {
      order: 2;
      width: 100%;
    }

    #luxury-service-process-{{ section.id }} .lsp-item--image-right .lsp-image-block {
      order: 1;
    }

    #luxury-service-process-{{ section.id }} .lsp-item--image-right .lsp-text-block {
      order: 2;
    }

    #luxury-service-process-{{ section.id }} .lsp-text-inner {
      max-width: none;
      margin: 0 !important;
    }

    #luxury-service-process-{{ section.id }} .lsp-image-wrapper,
    #luxury-service-process-{{ section.id }} .lsp-image-placeholder {
      height: auto;
      aspect-ratio: 1 / 0.72;
    }

    #luxury-service-process-{{ section.id }} .lsp-heading {
      font-size: 21px;
      margin-bottom: 12px;
    }

    #luxury-service-process-{{ section.id }} .lsp-description {
      font-size: 12px;
      line-height: 1.65;
    }

    #luxury-service-process-{{ section.id }} .lsp-divider {
      margin: 45px 0;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 480px) {

    #luxury-service-process-{{ section.id }} .lsp-container {
      width: calc(100% - 28px);
    }

    #luxury-service-process-{{ section.id }} .lsp-header {
      margin-bottom: 40px;
    }

    #luxury-service-process-{{ section.id }} .lsp-title {
      font-size: 27px;
    }

    #luxury-service-process-{{ section.id }} .lsp-grid {
      gap: 22px;
    }

    #luxury-service-process-{{ section.id }} .lsp-image-wrapper,
    #luxury-service-process-{{ section.id }} .lsp-image-placeholder {
      aspect-ratio: 1 / 0.75;
    }

    #luxury-service-process-{{ section.id }} .lsp-heading {
      font-size: 20px;
    }

    #luxury-service-process-{{ section.id }} .lsp-divider {
      margin: 38px 0;
    }

  }

</style>


{% schema %}
{
  "name": "Luxury Service Process",
  "tag": "section",
  "class": "section-luxury-service-process",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "Our Process"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Care Behind Every Garment"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section description"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e5e5e5"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop image position",
          "options": [
            {
              "value": "image-left",
              "label": "Image left / Text right"
            },
            {
              "value": "image-right",
              "label": "Text left / Image right"
            }
          ],
          "default": "image-left"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Inspection and Sorting"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>The cleaning process begins with a thorough inspection and sorting of the garments returned by customers. Our trained professionals carefully examine each garment to identify any damage, stains, or wear and tear.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Optional"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Service Process",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "layout": "image-right",
            "eyebrow": "01",
            "heading": "Inspection and Sorting",
            "text": "<p>The cleaning process begins with a thorough inspection and sorting of the garments returned by customers. Our trained professionals carefully examine each garment to identify any damage, stains, or wear and tear.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "layout": "image-left",
            "eyebrow": "02",
            "heading": "Specialized Cleaning and Fabric Care",
            "text": "<p>Indian luxury garments often feature intricate embroidery, delicate fabrics, and unique embellishments that require specialized attention. Our experienced cleaners employ a range of techniques, including steaming, spot treatment, and dry cleaning.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "layout": "image-right",
            "eyebrow": "03",
            "heading": "Quality Control and Storing",
            "text": "<p>After the cleaning process, each garment undergoes a meticulous quality control check. Our team ensures that every item meets our stringent standards for cleanliness, appearance, and overall condition.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "layout": "image-left",
            "eyebrow": "04",
            "heading": "Luxury Packaging",
            "text": "<p>Our commitment to sustainability extends to reusable, sturdy packaging designed specifically to protect Indian luxury garments during transportation.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}