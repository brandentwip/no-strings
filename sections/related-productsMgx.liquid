{% comment %}
  Related Products
  - Designed to match the supplied reference image
  - Uses Shopify product recommendations when available
  - Falls back to manually selected products
{% endcomment %}

{%- liquid
  assign current_product = product
  assign recommendation_products = recommendations.products
  assign manual_products = section.settings.manual_products

  assign products_to_show = recommendation_products

  if products_to_show == blank or products_to_show.size == 0
    assign products_to_show = manual_products
  endif
-%}

<section
  id="RelatedProducts-{{ section.id }}"
  class="rp-section"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
>
  <div class="rp-container">

    {%- if section.settings.heading != blank -%}
      <div class="rp-header">
        <h2 class="rp-heading">
          {{ section.settings.heading }}
        </h2>

        {%- if section.settings.subheading != blank -%}
          <div class="rp-subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="rp-grid rp-grid--{{ section.settings.columns_desktop }}"
      data-rp-grid
    >
      {%- if products_to_show != blank -%}

        {%- for related_product in products_to_show limit: section.settings.products_to_show -%}

          {%- assign product_image = related_product.featured_image -%}

          <article class="rp-card">

            <a
              href="{{ related_product.url }}"
              class="rp-image-link"
              aria-label="{{ related_product.title | escape }}"
            >

              <div class="rp-image-wrapper">

                {%- if product_image != blank -%}

                  {{
                    product_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900, 1200',
                      sizes: '(min-width: 990px) 33vw, 50vw',
                      class: 'rp-image'
                  }}

                {%- else -%}

                  <div class="rp-image-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>

                {%- endif -%}

                {%- if section.settings.show_badge -%}
                  <span class="rp-badge">
                    {{ section.settings.badge_text }}
                  </span>
                {%- endif -%}

              </div>

            </a>

            <div class="rp-info">

              {%- if section.settings.show_vendor and related_product.vendor != blank -%}
                <div class="rp-vendor">
                  {{ related_product.vendor }}
                </div>
              {%- endif -%}

              <a
                href="{{ related_product.url }}"
                class="rp-title"
              >
                {{ related_product.title }}
              </a>

              {%- if section.settings.show_price -%}

                <div class="rp-price-wrapper">

                  {%- if related_product.compare_at_price > related_product.price -%}

                    <span class="rp-compare-price">
                      {{ related_product.compare_at_price | money }}
                    </span>

                  {%- endif -%}

                  <span class="rp-price">
                    {{ related_product.price | money }}
                  </span>

                </div>

              {%- endif -%}

            </div>

          </article>

        {%- endfor -%}

      {%- else -%}

        <div class="rp-empty">
          <p>{{ section.settings.empty_text }}</p>
        </div>

      {%- endif -%}
    </div>

  </div>
</section>


<style>
  #RelatedProducts-{{ section.id }} {
    --rp-background: {{ section.settings.background_color }};
    --rp-text: {{ section.settings.text_color }};
    --rp-vendor: {{ section.settings.vendor_color }};
    --rp-price: {{ section.settings.price_color }};
    --rp-compare-price: {{ section.settings.compare_price_color }};
    --rp-badge-background: {{ section.settings.badge_background }};
    --rp-badge-text: {{ section.settings.badge_text_color }};
    --rp-card-gap: {{ section.settings.card_gap }}px;
    --rp-top-padding: {{ section.settings.padding_top }}px;
    --rp-bottom-padding: {{ section.settings.padding_bottom }}px;
    --rp-image-radius: {{ section.settings.image_radius }}px;
    --rp-badge-radius: {{ section.settings.badge_radius }}px;
  }

  #RelatedProducts-{{ section.id }} {
    width: 100%;
    background: var(--rp-background);
    padding-top: var(--rp-top-padding);
    padding-bottom: var(--rp-bottom-padding);
    box-sizing: border-box;
  }

  #RelatedProducts-{{ section.id }} *,
  #RelatedProducts-{{ section.id }} *::before,
  #RelatedProducts-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #RelatedProducts-{{ section.id }} .rp-container {
    width: min(
      calc(100% - {{ section.settings.horizontal_padding }}px),
      {{ section.settings.max_width }}px
    );
    margin: 0 auto;
  }

  /* Header */

  #RelatedProducts-{{ section.id }} .rp-header {
    margin-bottom: {{ section.settings.heading_spacing }}px;
    text-align: {{ section.settings.heading_alignment }};
  }

  #RelatedProducts-{{ section.id }} .rp-heading {
    margin: 0;
    color: var(--rp-text);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #RelatedProducts-{{ section.id }} .rp-subheading {
    margin-top: 10px;
    color: var(--rp-text);
    opacity: 0.75;
    font-size: 15px;
    line-height: 1.5;
  }

  /* Grid */

  #RelatedProducts-{{ section.id }} .rp-grid {
    display: grid;
    gap: var(--rp-card-gap);
    width: 100%;
  }

  #RelatedProducts-{{ section.id }} .rp-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #RelatedProducts-{{ section.id }} .rp-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #RelatedProducts-{{ section.id }} .rp-grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* Product Card */

  #RelatedProducts-{{ section.id }} .rp-card {
    min-width: 0;
  }

  #RelatedProducts-{{ section.id }} .rp-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #RelatedProducts-{{ section.id }} .rp-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: #eee;
    border-radius: var(--rp-image-radius);
  }

  #RelatedProducts-{{ section.id }} .rp-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transition:
      transform {{ section.settings.hover_speed }}ms ease,
      opacity {{ section.settings.hover_speed }}ms ease;
  }

  #RelatedProducts-{{ section.id }} .rp-image-link:hover .rp-image {
    transform: scale({{ section.settings.hover_scale }});
  }

  /* Badge */

  #RelatedProducts-{{ section.id }} .rp-badge {
    position: absolute;
    top: {{ section.settings.badge_top }}px;
    left: {{ section.settings.badge_left }}px;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: {{ section.settings.badge_height }}px;
    padding: 0 {{ section.settings.badge_horizontal_padding }}px;

    background: var(--rp-badge-background);
    color: var(--rp-badge-text);

    border-radius: var(--rp-badge-radius);

    font-size: {{ section.settings.badge_font_size }}px;
    line-height: 1;
    font-weight: {{ section.settings.badge_font_weight }};
    letter-spacing: {{ section.settings.badge_letter_spacing }}px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Product Info */

  #RelatedProducts-{{ section.id }} .rp-info {
    padding-top: {{ section.settings.info_spacing }}px;
  }

  #RelatedProducts-{{ section.id }} .rp-vendor {
    margin-bottom: 8px;
    color: var(--rp-vendor);
    font-size: {{ section.settings.vendor_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.vendor_weight }};
    letter-spacing: {{ section.settings.vendor_letter_spacing }}px;
    text-transform: uppercase;
  }

  #RelatedProducts-{{ section.id }} .rp-title {
    display: block;
    margin: 0;
    color: var(--rp-text);
    font-size: {{ section.settings.title_size }}px;
    line-height: {{ section.settings.title_line_height }};
    font-weight: {{ section.settings.title_weight }};
    text-decoration: none;
  }

  #RelatedProducts-{{ section.id }} .rp-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Price */

  #RelatedProducts-{{ section.id }} .rp-price-wrapper {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: {{ section.settings.price_spacing }}px;
  }

  #RelatedProducts-{{ section.id }} .rp-compare-price {
    color: var(--rp-compare-price);
    font-size: {{ section.settings.compare_price_size }}px;
    line-height: 1.2;
    text-decoration: line-through;
    opacity: 0.65;
  }

  #RelatedProducts-{{ section.id }} .rp-price {
    color: var(--rp-price);
    font-size: {{ section.settings.price_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.price_weight }};
  }

  /* Empty */

  #RelatedProducts-{{ section.id }} .rp-empty {
    grid-column: 1 / -1;
    padding: 40px 20px;
    text-align: center;
  }

  #RelatedProducts-{{ section.id }} .rp-empty p {
    margin: 0;
    color: var(--rp-text);
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    #RelatedProducts-{{ section.id }} .rp-container {
      width: min(
        calc(100% - {{ section.settings.horizontal_padding_tablet }}px),
        {{ section.settings.max_width }}px
      );
    }

    #RelatedProducts-{{ section.id }} .rp-grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #RelatedProducts-{{ section.id }} .rp-heading {
      font-size: {{ section.settings.heading_size_tablet }}px;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #RelatedProducts-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-container {
      width: calc(100% - {{ section.settings.horizontal_padding_mobile }}px);
    }

    #RelatedProducts-{{ section.id }} .rp-header {
      margin-bottom: {{ section.settings.heading_spacing_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-grid {
      gap: {{ section.settings.card_gap_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-grid--3,
    #RelatedProducts-{{ section.id }} .rp-grid--4 {
      grid-template-columns: repeat(
        {{ section.settings.columns_mobile }},
        minmax(0, 1fr)
      );
    }

    #RelatedProducts-{{ section.id }} .rp-grid--2 {
      grid-template-columns: repeat(
        {{ section.settings.columns_mobile }},
        minmax(0, 1fr)
      );
    }

    #RelatedProducts-{{ section.id }} .rp-info {
      padding-top: {{ section.settings.info_spacing_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-vendor {
      margin-bottom: 6px;
      font-size: {{ section.settings.vendor_size_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-price-wrapper {
      gap: 6px;
      margin-top: {{ section.settings.price_spacing_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-compare-price {
      font-size: {{ section.settings.compare_price_size_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-price {
      font-size: {{ section.settings.price_size_mobile }}px;
    }

    #RelatedProducts-{{ section.id }} .rp-badge {
      top: {{ section.settings.badge_top_mobile }}px;
      left: {{ section.settings.badge_left_mobile }}px;
      min-height: {{ section.settings.badge_height_mobile }}px;
      padding: 0 {{ section.settings.badge_horizontal_padding_mobile }}px;
      font-size: {{ section.settings.badge_font_size_mobile }}px;
    }
  }
</style>


{% schema %}
{
  "name": "Related_prd",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
