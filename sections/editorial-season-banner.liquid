{% comment %}
  Editorial Season Banner
  - Desktop + Mobile background images
  - Top editorial text
  - Main editorial content
  - Responsive editorial layout
  - Top text inherits typography/colors from main content
{% endcomment %}

<section
  id="editorial-season-banner-{{ section.id }}"
  class="editorial-season-banner"
  style="
    --esb-bg-color: {{ section.settings.background_color }};
    --esb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --esb-content-width: {{ section.settings.content_width }}px;
    --esb-desktop-height: {{ section.settings.desktop_height }}px;
    --esb-mobile-height: {{ section.settings.mobile_height }}px;

    --esb-heading-size: {{ section.settings.heading_size }}px;
    --esb-heading-mobile-size: {{ section.settings.heading_mobile_size }}px;
    --esb-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --esb-caption-size: {{ section.settings.caption_size }}px;

    --esb-content-left: {{ section.settings.content_left }}%;
    --esb-content-bottom: {{ section.settings.content_bottom }}%;

    --esb-button-width: {{ section.settings.button_width }}px;

    --esb-text-color: {{ section.settings.text_color }};
    --esb-accent-color: {{ section.settings.accent_color }};
    --esb-eyebrow-color: {{ section.settings.eyebrow_color }};
    --esb-caption-color: {{ section.settings.caption_color }};

    --esb-top-left: {{ section.settings.top_left }}%;
    --esb-top-top: {{ section.settings.top_top }}%;
  "
>

  {% if section.settings.desktop_image != blank %}
    <div
      class="editorial-season-banner__background editorial-season-banner__background--desktop"
      style="
        background-image:
          linear-gradient(
            rgba(0, 0, 0, var(--esb-overlay)),
            rgba(0, 0, 0, var(--esb-overlay))
          ),
          url('{{ section.settings.desktop_image | image_url: width: 2400 }}');
      "
    ></div>
  {% else %}
    <div class="editorial-season-banner__background editorial-season-banner__background--desktop"></div>
  {% endif %}


  {% if section.settings.mobile_image != blank %}
    <div
      class="editorial-season-banner__background editorial-season-banner__background--mobile"
      style="
        background-image:
          linear-gradient(
            rgba(0, 0, 0, var(--esb-overlay)),
            rgba(0, 0, 0, var(--esb-overlay))
          ),
          url('{{ section.settings.mobile_image | image_url: width: 1600 }}');
      "
    ></div>

  {% elsif section.settings.desktop_image != blank %}

    <div
      class="editorial-season-banner__background editorial-season-banner__background--mobile"
      style="
        background-image:
          linear-gradient(
            rgba(0, 0, 0, var(--esb-overlay)),
            rgba(0, 0, 0, var(--esb-overlay))
          ),
          url('{{ section.settings.desktop_image | image_url: width: 1600 }}');
      "
    ></div>

  {% else %}

    <div class="editorial-season-banner__background editorial-season-banner__background--mobile"></div>

  {% endif %}


  <div class="editorial-season-banner__inner">


    {% comment %}
      =========================================================
      TOP EDITORIAL TEXT
      Inherits typography from the main content
      =========================================================
    {% endcomment %}

    {% if section.settings.top_label != blank
      or section.settings.top_title != blank
      or section.settings.top_subtitle != blank
    %}

      <div class="editorial-season-banner__top-text">

        {% if section.settings.top_label != blank %}
          <div class="editorial-season-banner__top-label">
            {{ section.settings.top_label }}
          </div>
        {% endif %}


        {% if section.settings.top_title != blank %}
          <div class="editorial-season-banner__top-title">
            {{ section.settings.top_title }}
          </div>
        {% endif %}


        {% if section.settings.top_subtitle != blank %}
          <div class="editorial-season-banner__top-subtitle">
            {{ section.settings.top_subtitle }}
          </div>
        {% endif %}

      </div>

    {% endif %}


    {% comment %}
      =========================================================
      MAIN EDITORIAL CONTENT
      =========================================================
    {% endcomment %}

    <div class="editorial-season-banner__content">

      {% if section.settings.eyebrow != blank %}

        <div class="editorial-season-banner__eyebrow">
          {{ section.settings.eyebrow }}
        </div>

      {% endif %}


      {% if section.settings.heading_text != blank
        or section.settings.heading_accent != blank
      %}

        <h2 class="editorial-season-banner__heading">

          {% if section.settings.heading_text != blank %}
            <span class="editorial-season-banner__heading-main">
              {{ section.settings.heading_text }}
            </span>
          {% endif %}


          {% if section.settings.heading_accent != blank %}
            <span class="editorial-season-banner__heading-accent">
              {{ section.settings.heading_accent }}
            </span>
          {% endif %}

        </h2>

      {% endif %}

    </div>


    {% comment %}
      =========================================================
      BUTTON
      =========================================================
    {% endcomment %}

    {% if section.settings.button_text != blank %}

      <div class="editorial-season-banner__button-wrap">

        <a
          href="{{ section.settings.button_link }}"
          class="editorial-season-banner__button"
        >
          {{ section.settings.button_text }}
        </a>

      </div>

    {% endif %}


    {% comment %}
      =========================================================
      BOTTOM CAPTION
      =========================================================
    {% endcomment %}

    {% if section.settings.caption != blank %}

      <div class="editorial-season-banner__caption">
        {{ section.settings.caption }}
      </div>

    {% endif %}


    {% comment %}
      =========================================================
      INDICATORS
      =========================================================
    {% endcomment %}

    {% if section.settings.show_indicators %}

      <div class="editorial-season-banner__indicators">

        <span class="editorial-season-banner__indicator editorial-season-banner__indicator--active"></span>

        <span class="editorial-season-banner__indicator"></span>

        <span class="editorial-season-banner__indicator"></span>

      </div>

    {% endif %}

  </div>

</section>


<style>

/* =========================================================
   MAIN SECTION
========================================================= */

#editorial-season-banner-{{ section.id }} {
  position: relative;

  width: 100%;
  height: var(--esb-desktop-height);

  overflow: hidden;

  background: var(--esb-bg-color);

  isolation: isolate;
}


/* =========================================================
   BACKGROUND
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__background {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  background-color: var(--esb-bg-color);

  background-position: center center;
  background-repeat: no-repeat;
  background-size: cover;

  z-index: -2;
}


/*
  IMPORTANT:
  No texture, pattern, grain, stripes or pseudo-element
  is applied to the background.
*/


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__background--mobile {
  display: none;
}


/* =========================================================
   INNER
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__inner {
  position: relative;

  width: 100%;
  height: 100%;
}


/* =========================================================
   TOP EDITORIAL TEXT
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__top-text {
  position: absolute;

  top: var(--esb-top-top);
  left: var(--esb-top-left);

  width: min(
    600px,
    calc(100% - 40px)
  );

  z-index: 2;
}


/* ---------------------------------------------------------
   TOP LABEL
   Inherits the same typography as the bottom eyebrow
--------------------------------------------------------- */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__top-label {
  margin-bottom: 22px;

  font-size: var(--esb-eyebrow-size);
  line-height: 1.2;

  font-weight: 500;

  letter-spacing: 0.22em;

  text-transform: uppercase;

  color: var(--esb-eyebrow-color);
}


/* ---------------------------------------------------------
   TOP TITLE
   Inherits the same typography as the bottom heading
--------------------------------------------------------- */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__top-title {
  margin: 0;

  font-size: var(--esb-heading-size);
  line-height: 0.95;

  font-weight: 400;

  letter-spacing: -0.045em;

  text-transform: uppercase;

  color: var(--esb-text-color);
}


/* ---------------------------------------------------------
   TOP SUBTITLE
   Inherits the same typography as the bottom accent
--------------------------------------------------------- */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__top-subtitle {
  margin-top: 18px;

  font-size: 40px;
  line-height: 0.95;

  font-weight: 400;

  letter-spacing: -0.045em;

  font-style: italic;

  color: var(--esb-accent-color);
}


/* =========================================================
   MAIN CONTENT
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__content {
  position: absolute;

  left: var(--esb-content-left);
  bottom: var(--esb-content-bottom);

  width: min(
    var(--esb-content-width),
    calc(100% - 40px)
  );

  transform: translateX(-50%);
}


/* =========================================================
   EYEBROW
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__eyebrow {
  margin-bottom: 24px;

  font-size: var(--esb-eyebrow-size);
  line-height: 1.2;

  font-weight: 500;

  letter-spacing: 0.22em;

  text-transform: uppercase;

  color: var(--esb-eyebrow-color);
}


/* =========================================================
   HEADING
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__heading {
  margin: 0;

  font-size: var(--esb-heading-size);
  line-height: 0.95;

  font-weight: 400;

  letter-spacing: -0.045em;

  color: var(--esb-text-color);
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__heading-main {
  display: inline;
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__heading-accent {
  display: inline;

  margin-left: 8px;

  color: var(--esb-accent-color);

  font-style: italic;
  font-weight: 400;
}


/* =========================================================
   BUTTON
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__button-wrap {
  position: absolute;

  right: 3.7%;
  bottom: var(--esb-content-bottom);

  transform: translateY(8%);
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__button {
  display: flex;

  align-items: center;
  justify-content: center;

  width: var(--esb-button-width);

  min-height: 76px;

  padding: 18px 28px;

  background: #f6f0e7;
  color: #35120f;

  text-decoration: none;

  font-size: 14px;
  line-height: 1.2;

  font-weight: 400;

  letter-spacing: 0.09em;

  text-transform: uppercase;

  transition:
    background-color 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__button:hover {
  background: #ffffff;

  color: #35120f;

  transform: translateY(-2px);
}


/* =========================================================
   CAPTION
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__caption {
  position: absolute;

  left: 50%;
  bottom: 17px;

  transform: translateX(-50%);

  width: max-content;

  max-width: calc(100% - 40px);

  color: var(--esb-caption-color);

  font-size: var(--esb-caption-size);
  line-height: 1.2;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  text-align: center;
}


/* =========================================================
   INDICATORS
========================================================= */

#editorial-season-banner-{{ section.id }}
.editorial-season-banner__indicators {
  position: absolute;

  right: 3.7%;
  bottom: 26px;

  display: flex;

  align-items: center;

  gap: 12px;
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__indicator {
  display: block;

  width: 36px;
  height: 3px;

  background: rgba(255,255,255,0.4);
}


#editorial-season-banner-{{ section.id }}
.editorial-season-banner__indicator--active {
  background: var(--esb-accent-color);
}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 990px) {

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-text {
    top: 6%;
    left: 6%;

    width: min(
      520px,
      calc(100% - 40px)
    );
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__content {
    left: 6%;

    bottom: 16%;

    transform: none;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__button-wrap {
    right: 6%;

    bottom: 16%;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  #editorial-season-banner-{{ section.id }} {
    height: var(--esb-mobile-height);
  }


  /* Mobile background */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__background--desktop {
    display: none;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__background--mobile {
    display: block;
  }


  /* -------------------------------------------------------
     TOP TEXT
  ------------------------------------------------------- */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-text {
    top: 30px;

    left: 22px;
    right: 22px;

    width: auto;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-label {
    margin-bottom: 12px;

    font-size: var(--esb-eyebrow-size);

    letter-spacing: 0.18em;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-title {
    font-size: var(--esb-heading-mobile-size);

    line-height: 0.98;

    letter-spacing: -0.035em;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-subtitle {
    margin-top: 10px;

    font-size: var(--esb-heading-mobile-size);

    line-height: 0.98;

    letter-spacing: -0.035em;
  }


  /* -------------------------------------------------------
     MAIN CONTENT
  ------------------------------------------------------- */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__content {
    left: 22px;
    right: 22px;

    bottom: 120px;

    width: auto;

    transform: none;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__eyebrow {
    margin-bottom: 16px;

    font-size: 10px;

    letter-spacing: 0.18em;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__heading {
    font-size: var(--esb-heading-mobile-size);

    line-height: 0.98;

    letter-spacing: -0.035em;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__heading-accent {
    margin-left: 4px;
  }


  /* -------------------------------------------------------
     BUTTON
  ------------------------------------------------------- */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__button-wrap {
    left: 22px;
    right: 22px;

    bottom: 45px;

    transform: none;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__button {
    width: 100%;

    min-height: 58px;

    font-size: 12px;
  }


  /* -------------------------------------------------------
     CAPTION
  ------------------------------------------------------- */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__caption {
    display: none;
  }


  /* -------------------------------------------------------
     INDICATORS
  ------------------------------------------------------- */

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__indicators {
    right: 22px;

    bottom: 18px;

    gap: 7px;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__indicator {
    width: 25px;
    height: 2px;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media screen and (max-width: 480px) {

  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-text {
    top: 24px;

    left: 18px;
    right: 18px;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-label {
    margin-bottom: 10px;

    font-size: 9px;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-title {
    font-size: calc(
      var(--esb-heading-mobile-size) * 0.88
    );
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__top-subtitle {
    margin-top: 8px;

    font-size: calc(
      var(--esb-heading-mobile-size) * 0.88
    );
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__content {
    bottom: 112px;
  }


  #editorial-season-banner-{{ section.id }}
  .editorial-season-banner__heading {
    font-size: calc(
      var(--esb-heading-mobile-size) * 0.88
    );
  }

}

</style>


{% schema %}

{
  "name": "Editorial season banner",
  "tag": "section",
  "class": "section-editorial-season-banner",

  "settings": [

    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "If left empty, the desktop image will be used on mobile."
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#35120F"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 15
    },


    {
      "type": "header",
      "content": "Top editorial text"
    },

    {
      "type": "text",
      "id": "top_label",
      "label": "Top label",
      "default": "In frame"
    },

    {
      "type": "text",
      "id": "top_title",
      "label": "Top title",
      "default": "Sawan Gandhi"
    },

    {
      "type": "text",
      "id": "top_subtitle",
      "label": "Top subtitle",
      "default": "Gold Ombre Lehenga Set"
    },


    {
      "type": "header",
      "content": "Top text position"
    },

    {
      "type": "range",
      "id": "top_top",
      "label": "Top position",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 7
    },

    {
      "type": "range",
      "id": "top_left",
      "label": "Left position",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 9
    },


    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Wedding Season Edit"
    },

    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Season's"
    },

    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Freshest"
    },

    {
      "type": "text",
      "id": "caption",
      "label": "Bottom caption",
      "default": "Seasonal Banner — Full Bleed Editorial"
    },


    {
      "type": "header",
      "content": "Button"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop the edit"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 250
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#F7F0E8"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#D5A45B"
    },

    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#D5A45B"
    },

    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color",
      "default": "#8F7773"
    },


    {
      "type": "header",
      "content": "Desktop layout"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Banner height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 730
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 840
    },

    {
      "type": "range",
      "id": "content_left",
      "label": "Content horizontal position",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 28
    },

    {
      "type": "range",
      "id": "content_bottom",
      "label": "Content bottom position",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 10
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 86
    },

    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "Mobile heading size",
      "min": 30,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 48
    },

    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "caption_size",
      "label": "Caption size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },


    {
      "type": "header",
      "content": "Mobile layout"
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile banner height",
      "min": 450,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 650
    },


    {
      "type": "header",
      "content": "Indicators"
    },

