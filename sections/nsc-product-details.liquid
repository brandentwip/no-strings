{% comment %}
  Nostring-style Product Detail Page
  - Dynamic Shopify product data
  - Variant selection
  - Product image gallery
  - Standard size / custom measurement toggle
  - Quantity + AJAX add-to-cart
  - WhatsApp CTA
  - Security deposit notice
  - Trust badges
  - Configurable accordions
{% endcomment %}

{%- liquid
  assign current_product = product
  assign current_variant = current_product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: current_product.featured_image
  assign product_form_id = 'pdp-form-' | append: section.id
-%}

<section
  id="PDP-{{ section.id }}"
  class="nsc-pdp"
  style="
    --nsc-ink: {{ section.settings.color_ink }};
    --nsc-ink-soft: {{ section.settings.color_ink_soft }};
    --nsc-ivory: {{ section.settings.color_ivory }};
    --nsc-ivory-deep: {{ section.settings.color_ivory_deep }};
    --nsc-gold: {{ section.settings.color_gold }};
    --nsc-text-soft: {{ section.settings.color_text_soft }};
    --nsc-max-width: {{ section.settings.max_width }}px;
    --nsc-gallery-width: {{ section.settings.gallery_width }}%;
    --nsc-info-width: {{ 100 | minus: section.settings.gallery_width }}%;
  "
>
  {%- if section.settings.show_breadcrumbs -%}
    <div class="nsc-pdp__breadcrumb">
      <div class="nsc-pdp__wrap">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        {%- if current_product.collections.first -%}
          <a href="{{ current_product.collections.first.url }}">{{ current_product.collections.first.title }}</a>
          <span>/</span>
        {%- endif -%}
        <span class="nsc-pdp__breadcrumb-current">{{ current_product.title }}</span>
      </div>
    </div>
  {%- endif -%}

  <div class="nsc-pdp__wrap nsc-pdp__section">
    <div class="nsc-pdp__layout">

      {%- comment -%} GALLERY {%- endcomment -%}
      <div class="nsc-pdp__gallery">
        <div class="nsc-pdp__main-image" data-main-image>
          {%- if featured_image -%}
            {{
              featured_image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                widths: '600,800,1000,1200,1500,1800',
                sizes: '(min-width: 901px) 55vw, 100vw',
                class: 'nsc-pdp__image',
                alt: featured_image.alt | default: current_product.title | escape
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'nsc-pdp__image nsc-pdp__placeholder' }}
          {%- endif -%}
        </div>

        {%- if current_product.images.size > 1 -%}
          <div class="nsc-pdp__thumbs" role="list">
            {%- for image in current_product.images -%}
              <button
                type="button"
                class="nsc-pdp__thumb{% if image.id == featured_image.id %} is-active{% endif %}"
                data-image-thumb
                data-image-url="{{ image | image_url: width: 1800 }}"
                data-image-alt="{{ image.alt | default: current_product.title | escape }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{
                  image
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    widths: '120,180,240,300',
                    sizes: '80px',
                    alt: image.alt | default: current_product.title | escape
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} PRODUCT INFORMATION {%- endcomment -%}
      <div class="nsc-pdp__info">
        {%- if section.settings.show_vendor and current_product.vendor != blank -%}
          <div class="nsc-pdp__vendor">{{ current_product.vendor }}</div>
        {%- endif -%}

        <h1 class="nsc-pdp__title">{{ current_product.title }}</h1>

        <div class="nsc-pdp__price-row" data-price-row>
          <span class="nsc-pdp__price" data-price>
            {{ current_variant.price | money }}
          </span>
          <span
            class="nsc-pdp__compare{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}"
            data-compare
          >
            {{ current_variant.compare_at_price | money }}
          </span>
        </div>

        {%- if section.settings.show_tax_note -%}
          <p class="nsc-pdp__tax-note">{{ section.settings.tax_note }}</p>
        {%- endif -%}

        {%- if section.settings.show_price_compare -%}
          <div class="nsc-pdp__price-compare">
            <div>
              <span class="nsc-pdp__small-label">{{ section.settings.rental_label }}</span>
              <span class="nsc-pdp__compare-value" data-rental-price>{{ current_variant.price | money }}</span>
            </div>
            <div>
              <span class="nsc-pdp__small-label">{{ section.settings.designer_label }}</span>
              <span class="nsc-pdp__compare-value" data-designer-price>
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  {{ current_variant.compare_at_price | money }}
                {%- else -%}
                  —
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endif -%}

        <product-form class="nsc-pdp__form">
          {%- form 'product',
            current_product,
            id: product_form_id,
            class: 'nsc-pdp__product-form',
            data-type: 'add-to-cart-form'
          -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- for option in current_product.options_with_values -%}
              {%- assign option_name_downcase = option.name | downcase -%}
              {%- assign is_size = false -%}
              {%- assign is_color = false -%}
              {%- if option_name_downcase contains 'size' or option_name_downcase contains 'fit' -%}
                {%- assign is_size = true -%}
              {%- endif -%}
              {%- if option_name_downcase contains 'color' or option_name_downcase contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- endif -%}

              <div class="nsc-pdp__field" data-option-group data-option-index="{{ forloop.index0 }}">
                <span class="nsc-pdp__field-label">
                  {{ option.name }}
                </span>

                {%- if is_size and section.settings.show_measurement_toggle -%}
                  <div class="nsc-pdp__fit-toggle">
                    <button type="button" class="nsc-pdp__fit-tab is-active" data-fit-tab="standard">
                      {{ section.settings.standard_size_label }}
                    </button>
                    <button type="button" class="nsc-pdp__fit-tab" data-fit-tab="custom">
                      {{ section.settings.custom_size_label }}
                    </button>
                  </div>
                {%- endif -%}

                <div class="nsc-pdp__standard-panel is-active" data-standard-panel>
                  <div class="nsc-pdp__options{% if is_color %} nsc-pdp__options--color{% endif %}">
                    {%- for value in option.values -%}
                      {%- assign value_index = forloop.index0 -%}
                      {%- assign is_selected = false -%}
                      {%- if option.selected_value == value -%}
                        {%- assign is_selected = true -%}
                      {%- endif -%}

                      <button
                        type="button"
                        class="
                          nsc-pdp__option
                          {% if is_selected %}is-selected{% endif %}
                          {% if is_color %}nsc-pdp__color-option{% endif %}
                        "
                        data-option-value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        {% if is_color %}
                          style="--swatch: {{ value | downcase | escape }};"
                          title="{{ value | escape }}"
                          aria-label="{{ value | escape }}"
                        {% endif %}
                      >
                        <span class="{% if is_color %}nsc-pdp__swatch{% endif %}">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                </div>

                {%- if is_size and section.settings.show_measurement_toggle -%}
                  <div class="nsc-pdp__custom-panel" data-custom-panel>
                    <div class="nsc-pdp__measure-grid">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'measurement' -%}
                          <div class="nsc-pdp__measure-field" {{ block.shopify_attributes }}>
                            <label for="Measurement-{{ section.id }}-{{ block.id }}">{{ block.settings.label }}</label>
                            <input
                              id="Measurement-{{ section.id }}-{{ block.id }}"
                              type="{{ block.settings.input_type }}"
                              name="properties[{{ block.settings.property_name | escape }}]"
                              placeholder="{{ block.settings.placeholder | escape }}"
                              {% if block.settings.required %}required{% endif %}
                            >
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- if section.settings.measurement_note != blank -%}
                      <p class="nsc-pdp__measure-note">{{ section.settings.measurement_note }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- if section.settings.show_quantity -%}
              <div class="nsc-pdp__field">
                <span class="nsc-pdp__field-label">{{ section.settings.quantity_label }}</span>
                <div class="nsc-pdp__qty-cta">
                  <div class="nsc-pdp__qty">
                    <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
                    <input type="number" name="quantity" value="1" min="1" data-quantity aria-label="Quantity">
                    <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                  </div>

                  <button
                    type="submit"
                    name="add"
                    class="nsc-pdp__add"
                    data-add-to-cart
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if current_variant.available -%}
                        {{ section.settings.add_button_label }}
                      {%- else -%}
                        {{ section.settings.sold_out_label }}
                      {%- endif -%}
                    </span>
                  </button>
                </div>
              </div>
            {%- else -%}
              <button
                type="submit"
                name="add"
                class="nsc-pdp__add nsc-pdp__add--full"
                data-add-to-cart
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-add-label>
                  {%- if current_variant.available -%}
                    {{ section.settings.add_button_label }}
                  {%- else -%}
                    {{ section.settings.sold_out_label }}
                  {%- endif -%}
                </span>
              </button>
            {%- endif -%}
          {%- endform -%}
        </product-form>

        {%- if section.settings.show_whatsapp and section.settings.whatsapp_number != blank -%}
          <a
            class="nsc-pdp__whatsapp"
            href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-4.4 7.4 8.5 8.5 0 0 1-8.9-.6L3 20l1.7-4.7a8.5 8.5 0 1 1 13.3 0Z"/></svg>
            {{ section.settings.whatsapp_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_deposit -%}
          <div class="nsc-pdp__deposit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7v5c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7l-8-4Z"/></svg>
            <span>
              <strong>{{ section.settings.deposit_heading }}</strong>
              {{ section.settings.deposit_text }}
            </span>
          </div>
        {%- endif -%}

        {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
        {%- if trust_blocks.size > 0 -%}
          <div class="nsc-pdp__trust">
            {%- for block in trust_blocks -%}
              <div class="nsc-pdp__trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="nsc-pdp__trust-icon">{{ block.settings.icon }}</span>
                {%- endif -%}
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="nsc-pdp__accordion">
          {%- if section.settings.show_description -%}
            <details class="nsc-pdp__acc" open>
              <summary>{{ section.settings.description_heading }}</summary>
              <div class="nsc-pdp__acc-body rte">
                {{ current_product.description }}
              </div>
            </details>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="nsc-pdp__acc" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="nsc-pdp__acc-body rte">
                  {{ block.settings.content }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}

          {%- if section.settings.show_variant_summary -%}
            <details class="nsc-pdp__acc">
              <summary>{{ section.settings.variant_summary_heading }}</summary>
              <div class="nsc-pdp__acc-body">
                <p data-variant-summary>{{ current_variant.title }}</p>
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.show_related_products -%}
    {%- assign related_collection = section.settings.related_collection -%}

    {%- if related_collection != blank -%}
      {%- assign related_products = related_collection.products -%}
    {%- else -%}
      {%- assign related_products = current_product.collections.first.products -%}
    {%- endif -%}

    {%- if related_products != blank -%}
      <section class="nsc-pdp__related">
        <div class="nsc-pdp__related-wrap">
          <div class="nsc-pdp__related-head">
            {%- if section.settings.related_eyebrow != blank -%}
              <span class="nsc-pdp__related-eyebrow">{{ section.settings.related_eyebrow }}</span>
            {%- endif -%}
            <h2>{{ section.settings.related_heading }}</h2>
          </div>

          <div class="nsc-pdp__related-grid">
            {%- assign related_count = 0 -%}
            {%- for related_product in related_products -%}
              {%- if related_product.id != current_product.id and related_count < section.settings.related_limit -%}
                {%- assign related_count = related_count | plus: 1 -%}
                {%- assign related_variant = related_product.selected_or_first_available_variant -%}
                <article class="nsc-related-card">
                  <a href="{{ related_product.url }}" class="nsc-related-card__media">
                    {%- if section.settings.related_show_badge -%}
                      <span class="nsc-related-card__badge">{{ section.settings.related_badge }}</span>
                    {%- endif -%}

                    {%- if related_product.featured_image -%}
                      {{
                        related_product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '300,400,500,600,800',
                          sizes: '(min-width: 1100px) 25vw, (min-width: 601px) 33vw, 50vw',
                          alt: related_product.featured_image.alt | default: related_product.title | escape
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'nsc-related-card__placeholder' }}
                    {%- endif -%}

                    {%- if section.settings.related_show_quick_add -%}
                      <span class="nsc-related-card__quick-add">{{ section.settings.related_quick_add_label }}</span>
                    {%- endif -%}
                  </a>

                  <div class="nsc-related-card__info">
                    {%- if section.settings.related_show_vendor and related_product.vendor != blank -%}
                      <div class="nsc-related-card__vendor">{{ related_product.vendor }}</div>
                    {%- endif -%}

                    <h3>
                      <a href="{{ related_product.url }}">{{ related_product.title }}</a>
                    </h3>

                    <div class="nsc-related-card__price">
                      {%- if related_variant.compare_at_price > related_variant.price -%}
                        <span class="nsc-related-card__strike">{{ related_variant.compare_at_price | money }}</span>
                      {%- endif -%}
                      <span class="nsc-related-card__now">{{ related_variant.price | money }}</span>
                      {%- if section.settings.related_show_rental_label -%}
                        <span class="nsc-related-card__unit">{{ section.settings.related_rental_label }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

</section>

<style>
  #PDP-{{ section.id }} {
    background: var(--nsc-ivory);
    color: var(--nsc-ink);
  }

  #PDP-{{ section.id }} *,
  #PDP-{{ section.id }} *::before,
  #PDP-{{ section.id }} *::after { box-sizing: border-box; }

  #PDP-{{ section.id }} a { color: inherit; text-decoration: none; }

  #PDP-{{ section.id }} .nsc-pdp__wrap {
    width: min(100% - 44px, var(--nsc-max-width));
    margin-inline: auto;
  }

  #PDP-{{ section.id }} .nsc-pdp__breadcrumb {
    border-bottom: 1px solid rgba(42,16,21,.08);
    padding: 22px 0;
    font-size: 12px;
    color: var(--nsc-text-soft);
  }

  #PDP-{{ section.id }} .nsc-pdp__breadcrumb .nsc-pdp__wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  #PDP-{{ section.id }} .nsc-pdp__breadcrumb a:hover { color: var(--nsc-gold); }
  #PDP-{{ section.id }} .nsc-pdp__breadcrumb-current { color: var(--nsc-ink); }

  #PDP-{{ section.id }} .nsc-pdp__section { padding: 36px 0 100px; }

  #PDP-{{ section.id }} .nsc-pdp__layout {
    display: grid;
    grid-template-columns: var(--nsc-gallery-width) var(--nsc-info-width);
    gap: 56px;
    align-items: start;
  }

  #PDP-{{ section.id }} .nsc-pdp__gallery {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    min-width: 0;
  }

  #PDP-{{ section.id }} .nsc-pdp__main-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: {{ section.settings.image_radius }}px;
    background: var(--nsc-ivory-deep);
  }

  #PDP-{{ section.id }} .nsc-pdp__image,
  #PDP-{{ section.id }} .nsc-pdp__main-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
  }

  #PDP-{{ section.id }} .nsc-pdp__placeholder {
    fill: var(--nsc-ivory-deep);
  }

  #PDP-{{ section.id }} .nsc-pdp__thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-top: 12px;
  }

  #PDP-{{ section.id }} .nsc-pdp__thumb {
    appearance: none;
    border: 1.5px solid transparent;
    padding: 0;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    cursor: pointer;
    background: var(--nsc-ivory-deep);
  }

  #PDP-{{ section.id }} .nsc-pdp__thumb.is-active { border-color: var(--nsc-gold); }
  #PDP-{{ section.id }} .nsc-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  #PDP-{{ section.id }} .nsc-pdp__info { min-width: 0; padding-top: 2px; }

  #PDP-{{ section.id }} .nsc-pdp__vendor {
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--nsc-gold);
    margin-bottom: 10px;
    font-weight: 500;
  }

  #PDP-{{ section.id }} .nsc-pdp__title {
    margin: 0 0 16px;
    font-size: clamp(28px, 2.6vw, 42px);
    line-height: 1.18;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  #PDP-{{ section.id }} .nsc-pdp__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 6px;
  }

  #PDP-{{ section.id }} .nsc-pdp__price {
    font-size: 28px;
    font-style: italic;
    color: var(--nsc-ink);
  }

  #PDP-{{ section.id }} .nsc-pdp__compare {
    font-size: 16px;
    color: var(--nsc-text-soft);
    text-decoration: line-through;
    opacity: .55;
  }

  #PDP-{{ section.id }} .nsc-pdp__compare.is-hidden { display: none; }

  #PDP-{{ section.id }} .nsc-pdp__tax-note {
    font-size: 12px;
    color: var(--nsc-text-soft);
    margin: 0 0 26px;
  }

  #PDP-{{ section.id }} .nsc-pdp__price-compare {
    display: flex;
    gap: 28px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(42,16,21,.1);
  }

  #PDP-{{ section.id }} .nsc-pdp__price-compare > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #PDP-{{ section.id }} .nsc-pdp__small-label,
  #PDP-{{ section.id }} .nsc-pdp__field-label {
    display: block;
    font-size: 10.5px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--nsc-text-soft);
  }

  #PDP-{{ section.id }} .nsc-pdp__compare-value {
    font-size: 17px;
    font-style: italic;
    color: var(--nsc-ink);
  }

  #PDP-{{ section.id }} .nsc-pdp__field { margin-bottom: 24px; }
  #PDP-{{ section.id }} .nsc-pdp__field-label { margin-bottom: 12px; font-size: 11.5px; }

  #PDP-{{ section.id }} .nsc-pdp__fit-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  #PDP-{{ section.id }} .nsc-pdp__fit-tab {
    flex: 1;
    border: 1px solid rgba(42,16,21,.2);
    background: transparent;
    color: var(--nsc-text-soft);
    border-radius: 2px;
    padding: 10px 8px;
    cursor: pointer;
    font-size: 11.5px;
    letter-spacing: .04em;
  }

  #PDP-{{ section.id }} .nsc-pdp__fit-tab.is-active {
    background: var(--nsc-ink);
    border-color: var(--nsc-ink);
    color: var(--nsc-ivory);
  }

  #PDP-{{ section.id }} .nsc-pdp__custom-panel { display: none; }
  #PDP-{{ section.id }} .nsc-pdp__custom-panel.is-active { display: block; }
  #PDP-{{ section.id }} .nsc-pdp__standard-panel.is-active { display: block; }

  #PDP-{{ section.id }} .nsc-pdp__standard-panel { display: none; }
  #PDP-{{ section.id }} .nsc-pdp__standard-panel.is-active { display: block; }

  #PDP-{{ section.id }} .nsc-pdp__options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #PDP-{{ section.id }} .nsc-pdp__option {
    min-width: 46px;
    height: 46px;
    padding: 0 14px;
    border: 1px solid rgba(42,16,21,.25);
    border-radius: 50px;
    background: transparent;
    color: var(--nsc-ink);
    cursor: pointer;
    font: inherit;
    transition: .2s ease;
  }

  #PDP-{{ section.id }} .nsc-pdp__option.is-selected {
    background: var(--nsc-ink);
    border-color: var(--nsc-ink);
