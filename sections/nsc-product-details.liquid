<script>
  (function() {
    const root = document.getElementById('PDP-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const variants = {{ current_product.variants | json }};
    const form = root.querySelector('#{{ product_form_id }}');
    const variantInput = root.querySelector('[data-variant-id]');
    const priceEl = root.querySelector('[data-price]');
    const compareEl = root.querySelector('[data-compare]');
    const rentalEl = root.querySelector('[data-rental-price]');
    const designerPriceEl = root.querySelector('[data-designer-price]');
    const addButton = root.querySelector('[data-add-to-cart]');
    const addLabel = root.querySelector('[data-add-label]');
    const variantSummary = root.querySelector('[data-variant-summary]');
    const quantity = root.querySelector('[data-quantity]');
    const mainImage = root.querySelector('[data-main-image]');

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, {{ shop.money_format | json }});
      }
      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: {{ cart.currency.iso_code | json }}
      });
    }

    function getSelectedOptions() {
      return Array.from(root.querySelectorAll('[data-option-group]')).map(function(group) {
        const selected = group.querySelector('.nsc-pdp__option.is-selected');
        return selected ? selected.dataset.optionValue : null;
      });
    }

    function findVariant() {
      const selected = getSelectedOptions();
      return variants.find(function(variant) {
        return variant.options.every(function(value, index) {
          return selected[index] === value;
        });
      });
    }

    function updateVariant() {
      const variant = findVariant();
      if (!variant) {
        if (addButton) addButton.disabled = true;
        if (addLabel) addLabel.textContent = {{ section.settings.unavailable_label | json }};
        return;
      }

      if (variantInput) variantInput.value = variant.id;

      if (priceEl) priceEl.textContent = formatMoney(variant.price);

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.classList.remove('is-hidden');
        } else {
          compareEl.classList.add('is-hidden');
        }
      }

      if (rentalEl) rentalEl.textContent = formatMoney(variant.price);

      if (designerPriceEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          designerPriceEl.textContent = formatMoney(variant.compare_at_price);
        } else {
          designerPriceEl.textContent = '—';
        }
      }

      if (variantSummary) variantSummary.textContent = variant.title;

      if (addButton) addButton.disabled = !variant.available;
      if (addLabel) {
        addLabel.textContent = variant.available
          ? {{ section.settings.add_button_label | json }}
          : {{ section.settings.sold_out_label | json }};
      }

      if (variant.featured_image && mainImage) {
        const imageUrl = variant.featured_image.src || variant.featured_image;
        const existing = mainImage.querySelector('img');
        if (existing && imageUrl) {
          existing.src = imageUrl;
          existing.removeAttribute('srcset');
        }
      }
    }

    root.querySelectorAll('[data-option-value]').forEach(function(button) {
      button.addEventListener('click', function() {
        const index = Number(this.dataset.optionIndex);
        const group = root.querySelector('[data-option-group][data-option-index="' + index + '"]');
        if (!group) return;

        group.querySelectorAll('.nsc-pdp__option').forEach(function(option) {
          option.classList.remove('is-selected');
        });

        this.classList.add('is-selected');
        updateVariant();
      });
    });

    root.querySelectorAll('[data-fit-tab]').forEach(function(tab) {
      tab.addEventListener('click', function() {
        const group = this.closest('[data-option-group]');
        if (!group) return;

        group.querySelectorAll('[data-fit-tab]').forEach(function(item) {
          item.classList.remove('is-active');
        });

        group.querySelectorAll('[data-standard-panel], [data-custom-panel]').forEach(function(panel) {
          panel.classList.remove('is-active');
        });

        this.classList.add('is-active');

        if (this.dataset.fitTab === 'standard') {
          const panel = group.querySelector('[data-standard-panel]');
          if (panel) panel.classList.add('is-active');
        } else {
          const panel = group.querySelector('[data-custom-panel]');
          if (panel) panel.classList.add('is-active');
        }
      });
    });

    const minus = root.querySelector('[data-qty-minus]');
    const plus = root.querySelector('[data-qty-plus]');

    if (minus && quantity) {
      minus.addEventListener('click', function() {
        quantity.value = Math.max(1, Number(quantity.value || 1) - 1);
      });
    }

    if (plus && quantity) {
      plus.addEventListener('click', function() {
        quantity.value = Math.max(1, Number(quantity.value || 1) + 1);
      });
    }

    function switchMainImage(thumb) {
      if (!thumb || !mainImage) return;

      const url = thumb.getAttribute('data-image-url');
      const alt = thumb.getAttribute('data-image-alt') || '';
      if (!url) return;

      let img = mainImage.querySelector('img');

      if (!img) {
        img = document.createElement('img');
        img.className = 'nsc-pdp__image';
        mainImage.replaceChildren(img);
      }

      // Use the Shopify CDN URL stored on the thumbnail.
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.src = url;
      img.alt = alt;

      root.querySelectorAll('[data-image-thumb]').forEach(function(item) {
        item.classList.remove('is-active');
        item.setAttribute('aria-current', 'false');
      });

      thumb.classList.add('is-active');
      thumb.setAttribute('aria-current', 'true');
    }

    root.querySelectorAll('[data-image-thumb]').forEach(function(thumb) {
      thumb.addEventListener('click', function(event) {
        event.preventDefault();
        switchMainImage(this);
      });
    });

    if (form) {
      form.addEventListener('submit', function(event) {
        event.preventDefault();

        const button = form.querySelector('[data-add-to-cart]');
        const originalLabel = addLabel ? addLabel.textContent : '';

        if (!variantInput || !variantInput.value || (button && button.disabled)) return;

        if (button) button.disabled = true;
        if (addLabel) addLabel.textContent = {{ section.settings.adding_label | json }};

        const body = new FormData(form);

        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: body
        })
        .then(function(response) {
          if (!response.ok) throw new Error('Add to cart failed');
          return response.json();
        })
        .then(function() {
          if (addLabel) addLabel.textContent = {{ section.settings.added_label | json }};

          document.dispatchEvent(new CustomEvent('cart:refresh', {
            bubbles: true,
            detail: { source: 'nsc-pdp' }
          }));

          return fetch('{{ routes.cart_url }}.js', { headers: { 'Accept': 'application/json' } });
        })
        .then(function(response) {
          return response.ok ? response.json() : null;
        })
        .then(function(cart) {
          if (window.Shopify && typeof Shopify.theme !== 'undefined') {
            document.dispatchEvent(new CustomEvent('cart:updated', {
              bubbles: true,
              detail: { cart: cart }
            }));
          }

          setTimeout(function() {
            if (addLabel) addLabel.textContent = originalLabel || {{ section.settings.add_button_label | json }};
            updateVariant();
          }, 1200);
        })
        .catch(function() {
          if (addLabel) addLabel.textContent = {{ section.settings.error_label | json }};
          setTimeout(function() {
            if (addLabel) addLabel.textContent = originalLabel || {{ section.settings.add_button_label | json }};
            updateVariant();
          }, 1500);
        });
      });
    }

    updateVariant();
  })();
</script>

