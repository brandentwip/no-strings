{% style %}
  .id-faq-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: 70px 20px;
  }

  .id-faq-{{ section.id }} .faq-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .id-faq-{{ section.id }} .faq-main-title {
    text-align: center;
    font-size: 46px;
    font-weight: 500;
    letter-spacing: 2px;
    margin: 0 0 60px;
    color: {{ section.settings.heading_color }};
    font-family: 'Jost', sans-serif;
  }

  .id-faq-{{ section.id }} .faq-list {
    border: 1px solid #d6d2cc;
    background: #ffffff;
  }

  .id-faq-{{ section.id }} .faq-item {
    border-bottom: 1px solid #d6d2cc;
  }

  .id-faq-{{ section.id }} .faq-item:last-child {
    border-bottom: none;
  }

  .id-faq-{{ section.id }} .faq-question {
    width: 100%;
    border: none;
    background: transparent;
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    text-align: left;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
    cursor: pointer;
    color: #1d1d1d;
  }

  .id-faq-{{ section.id }} .faq-question-text {
    flex: 1;
  }

  .id-faq-{{ section.id }} .faq-icon {
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .id-faq-{{ section.id }} .faq-answer {
    background: #fafafa;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .id-faq-{{ section.id }} .faq-answer-inner {
    overflow: hidden;
  }

  .id-faq-{{ section.id }} .faq-answer-content {
    padding: 0 20px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #666666;
    overflow-wrap: anywhere;
  }

  .id-faq-{{ section.id }} .faq-answer-content p {
    margin: 0;
  }

  .id-faq-{{ section.id }} .faq-answer-content a {
    color: #1d1d1d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .id-faq-{{ section.id }} .faq-item.active .faq-answer {
    grid-template-rows: 1fr;
  }

  .id-faq-{{ section.id }} .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  .id-faq-{{ section.id }} .faq-question:focus-visible {
    outline: 2px solid #1d1d1d;
    outline-offset: -3px;
  }

  @media screen and (max-width: 768px) {
    .id-faq-{{ section.id }} {
      padding: 50px 15px;
    }

    .id-faq-{{ section.id }} .faq-main-title {
      font-size: 32px;
      line-height: 1.3;
      letter-spacing: 1px;
      margin-bottom: 35px;
    }

    .id-faq-{{ section.id }} .faq-question {
      font-size: 14px;
      padding: 16px 14px;
      gap: 12px;
    }

    .id-faq-{{ section.id }} .faq-answer-content {
      padding: 0 14px 18px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .id-faq-{{ section.id }} .faq-answer,
    .id-faq-{{ section.id }} .faq-icon {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="id-faq-{{ section.id }}"
  id="id-faq-{{ section.id }}"
>
  <div class="faq-container">

    {% if section.settings.heading != blank %}
      <h2 class="faq-main-title">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="faq-list">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <div
            class="faq-item{% if block.settings.open_by_default %} active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button
              class="faq-question"
              type="button"
              aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
              aria-controls="faq-answer-{{ section.id }}-{{ block.id }}"
              id="faq-question-{{ section.id }}-{{ block.id }}"
            >
              <span class="faq-question-text">
                {{ block.settings.question | escape }}
              </span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>

            <div
              class="faq-answer"
              id="faq-answer-{{ section.id }}-{{ block.id }}"
              role="region"
              aria-labelledby="faq-question-{{ section.id }}-{{ block.id }}"
            >
              <div class="faq-answer-inner">
                <div class="faq-answer-content">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<script>
  (function () {
    var sectionId = 'id-faq-{{ section.id }}';

    function initFAQ(section) {
      if (!section || section.dataset.faqInitialized === 'true') return;

      section.dataset.faqInitialized = 'true';

      var items = section.querySelectorAll('.faq-item');

      items.forEach(function (item) {
        var button = item.querySelector('.faq-question');

        if (!button) return;

        button.addEventListener('click', function () {
          var isOpen = item.classList.contains('active');

          item.classList.toggle('active', !isOpen);
          button.setAttribute('aria-expanded', String(!isOpen));
        });
      });
    }

    function initCurrentSection() {
      initFAQ(document.getElementById(sectionId));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCurrentSection);
    } else {
      initCurrentSection();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initFAQ(document.getElementById(sectionId));
      }
    });
  })();
</script>

{% schema %}
{
  "name": "General FAQ",
  "tag": "section",
  "class": "custom-faq-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f7f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1d1d1d"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I list my designer outfit with nostringscouture?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Simply fill out our submission form with details of your garment, including the designer, original purchase price, condition and photographs. Our team will review your submission and get in touch with the next steps. Here is the link- (add link)</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "General FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "1. How can I list my designer outfit with nostringscouture?",
            "answer": "<p>Simply fill out our submission form with details of your garment, including the designer, original purchase price, condition and photographs. Our team will review your submission and get in touch with the next steps. Here is the link- (add link)</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "2. Can I choose whether to rent or sell my outfit?",
            "answer": "<p>Absolutely. You can indicate whether you’d prefer to rent, sell or explore both options. Our team will assess your garment and recommend the most suitable option based on its style, condition and potential demand.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "3. Is there a fee to list my garment?",
            "answer": "<p>There is no upfront fee to submit your garment for consideration. Any applicable commission or service charges will be communicated and agreed upon before your garment is listed.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "4. How is the rental or selling price of my garment determined?",
            "answer": "<p>Our team recommends pricing based on factors such as the designer, original retail value, condition, age, style and current market demand. The recommended price and applicable commission will be shared with you for approval before listing.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "5. Will I have to give my garment to nostringscouture?",
            "answer": "<p>Depending on the listing arrangement, we may require your garment to be physically available with us for quality checks, storage, fittings, rentals or sale fulfilment. Our team will communicate the requirements before proceeding.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "6. What happens after my garment is accepted?",
            "answer": "<p>Once accepted, we will coordinate the necessary quality checks, photography and listing details. Your garment will then be showcased on our platform, making it accessible to customers looking to rent or purchase designer wear.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "7. Will nostringscouture promote my garment?",
            "answer": "<p>Yes. We handle the presentation and promotion of garments listed on our platform through our website and relevant marketing channels. While we aim to maximise visibility, rentals and sales depend on customer demand.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "8. Can I list more than one garment?",
            "answer": "<p>Of course! You can submit multiple designer pieces for consideration. Each garment will be reviewed individually to ensure it meets our curation and quality standards.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "9. Can I list a garment that has been worn?",
