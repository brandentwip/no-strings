{%- comment -%}
  Section: Garment Selection Process
  Concept: "Quiet Ledger" — a slim hairline running the length of the page,
  each step marked with a plain numbered circle. One gold accent (eyebrow,
  rule, numeral) against ivory and near-black ink; everything else stays
  restrained so the page reads as considered rather than decorated.
{%- endcomment -%}

{%- assign sid = section.id -%}

<section id="gp-{{ sid }}" class="gp-section">

  {%- comment -%} ---------- Breadcrumb ---------- {%- endcomment -%}
  {%- if section.settings.show_breadcrumb -%}
    <nav class="gp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">{{ section.settings.breadcrumb_home | default: 'Home' }}</a>
      <span class="gp-breadcrumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.heading }}</span>
    </nav>
  {%- endif -%}

  {%- comment -%} ---------- Header ---------- {%- endcomment -%}
  <header class="gp-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gp-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="gp-heading">{{ section.settings.heading }}</h1>
    <span class="gp-rule" aria-hidden="true"></span>
    {%- if section.settings.intro != blank -%}
      <div class="gp-intro">{{ section.settings.intro }}</div>
    {%- endif -%}
  </header>

  {%- comment -%} ---------- Timeline ---------- {%- endcomment -%}
  <div class="gp-timeline">
    <div class="gp-thread" aria-hidden="true"></div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        {%- assign side = 'left' -%}
        {%- assign idx = forloop.index -%}
        {%- assign mod = idx | modulo: 2 -%}
        {%- if mod == 0 -%}{%- assign side = 'right' -%}{%- endif -%}
        {%- assign num = idx | prepend: '0' -%}
        {%- assign num = num | slice: -2, 2 -%}

        {%- assign icon_key = block.settings.icon -%}
        {%- if icon_key == 'auto' or icon_key == blank -%}
          {%- assign icon_mod = idx | modulo: 4 -%}
          {%- case icon_mod -%}
            {%- when 1 -%}{%- assign icon_key = 'research' -%}
            {%- when 2 -%}{%- assign icon_key = 'shortlist' -%}
            {%- when 3 -%}{%- assign icon_key = 'curate' -%}
            {%- when 0 -%}{%- assign icon_key = 'procure' -%}
          {%- endcase -%}
        {%- endif -%}

        <article class="gp-step gp-step--{{ side }}" {{ block.shopify_attributes }}>

          <div class="gp-tag" aria-hidden="true">
            <span class="gp-tag-number">{{ num }}</span>
          </div>

          <div class="gp-step-media">
            {%- if block.settings.image != blank -%}
              <div class="gp-step-photo">
                <img
                  class="gp-step-img"
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1300 }} 1300w"
                  sizes="(min-width: 990px) 340px, 70vw"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                >
              </div>
            {%- elsif icon_key != 'none' -%}
              <div class="gp-step-icon">
                {%- case icon_key -%}

                  {%- when 'research' -%}
                    <svg viewBox="0 0 140 140" aria-hidden="true">
                      <path d="M46 32 L46 96 Q46 101 51 101 L89 101 Q94 101 94 96 L94 32" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M46 32 L59 18 L81 18 L94 32" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <line x1="59" y1="18" x2="59" y2="34" stroke="currentColor" stroke-width="1.4"/>
                      <line x1="81" y1="18" x2="81" y2="34" stroke="currentColor" stroke-width="1.4"/>
                      <circle cx="93" cy="93" r="17" fill="var(--gp-parchment-soft)" stroke="currentColor" stroke-width="1.4"/>
                      <line x1="105" y1="105" x2="120" y2="120" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>

                  {%- when 'shortlist' -%}
                    <svg viewBox="0 0 140 140" aria-hidden="true">
                      <rect x="18" y="24" width="46" height="92" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <line x1="18" y1="49" x2="64" y2="49" stroke="currentColor" stroke-width="1"/>
                      <line x1="18" y1="74" x2="64" y2="74" stroke="currentColor" stroke-width="1"/>
                      <line x1="18" y1="99" x2="64" y2="99" stroke="currentColor" stroke-width="1"/>
                      <path d="M84 39 L122 39 M84 39 L91 46 M84 39 L91 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M84 66 L122 66 M84 66 L91 73 M84 66 L91 59" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M84 93 L122 93 M84 93 L91 100 M84 93 L91 86" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  {%- when 'curate' -%}
                    <svg viewBox="0 0 140 140" aria-hidden="true">
                      <circle cx="44" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M44 25 L44 35 M28 35 L60 35" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M28 35 L19 101 Q19 109 27 109 L61 109 Q69 109 69 101 L60 35 Z" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <circle cx="96" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M96 25 L96 35 M80 35 L112 35" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M80 35 L71 101 Q71 109 79 109 L113 109 Q121 109 121 101 L112 35 Z" fill="none" stroke="currentColor" stroke-width="1.4"/>
                    </svg>

                  {%- when 'procure' -%}
                    <svg viewBox="0 0 140 140" aria-hidden="true">
                      <rect x="34" y="24" width="56" height="40" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <text x="62" y="50" font-family="Georgia, serif" font-style="italic" font-size="15" text-anchor="middle" fill="currentColor">NSC</text>
                      <path d="M20 96 Q34 78 56 82 Q66 84 72 92 Q88 78 104 86 Q116 92 110 102 Q98 120 72 120 Q42 120 20 96 Z" fill="none" stroke="currentColor" stroke-width="1.4"/>
                    </svg>

                {%- endcase -%}
              </div>
            {%- endif -%}
          </div>

          <div class="gp-step-copy">
            <h2 class="gp-step-title">{{ block.settings.title }}</h2>
            <div class="gp-step-text">{{ block.settings.text }}</div>
          </div>

        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_label != blank -%}
    <div class="gp-cta-wrap">
      <a href="{{ section.settings.cta_link | default: '#' }}" class="gp-cta">
        <span>{{ section.settings.cta_label }}</span>
      </a>
    </div>
  {%- endif -%}

</section>

{%- style -%}

  /* NOTE: swap this @import for your theme's font picker settings in
     production — an @import here costs a render-blocking request. It's
     included so the section previews correctly on its own. */
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@400;500;600&display=swap');

  #gp-{{ sid }} {
    --gp-ink: #1c1712;
    --gp-ink-soft: #56493c;
    --gp-parchment: {{ section.settings.bg_color | default: '#f7f0e5' }};
    --gp-parchment-soft: #fbf7f0;
    --gp-gold: #a9853f;
    --gp-line: rgba(28, 23, 18, 0.12);
    --gp-font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --gp-font-body: 'Jost', 'Helvetica Neue', Arial, sans-serif;

    background: var(--gp-parchment);
    color: var(--gp-ink);
    font-family: var(--gp-font-body);
    padding: 88px clamp(24px, 5vw, 72px) 120px;
    overflow: hidden;
  }

  #gp-{{ sid }} * { box-sizing: border-box; }

  /* ---------- Breadcrumb ---------- */
  #gp-{{ sid }} .gp-breadcrumb {
    max-width: 1320px;
    margin: 0 auto 32px;
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: flex-start;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gp-ink-soft);
  }
  #gp-{{ sid }} .gp-breadcrumb a {
    color: var(--gp-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  #gp-{{ sid }} .gp-breadcrumb a:hover { border-color: var(--gp-ink-soft); }
  #gp-{{ sid }} .gp-breadcrumb-sep { opacity: 0.5; }

  /* ---------- Header ---------- */
  #gp-{{ sid }} .gp-header {
    max-width: 1320px;
    margin: 0 auto 72px;
    text-align: left;
  }
  #gp-{{ sid }} .gp-eyebrow {
    font-family: var(--gp-font-body);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gp-gold);
    margin: 0 0 18px;
  }
  #gp-{{ sid }} .gp-heading {
    font-family: var(--gp-font-display);
    font-weight: 500;
    font-size: clamp(38px, 5.5vw, 68px);
    line-height: 1.06;
    letter-spacing: 0.01em;
    margin: 0 0 28px;
  }
  #gp-{{ sid }} .gp-rule {
    display: block;
    width: 64px;
    height: 1px;
    background: var(--gp-gold);
    margin: 0 0 32px;
  }
  #gp-{{ sid }} .gp-intro {
    font-size: 16px;
    line-height: 1.8;
    color: var(--gp-ink-soft);
    max-width: 620px;
    margin: 0;
  }
  #gp-{{ sid }} .gp-intro p { margin: 0; }

  /* ---------- Timeline ---------- */
  #gp-{{ sid }} .gp-timeline {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
  }

  #gp-{{ sid }} .gp-thread {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--gp-line);
  }

  #gp-{{ sid }} .gp-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 72px;
    padding: 76px 0;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  #gp-{{ sid }} .gp-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #gp-{{ sid }} .gp-step--left .gp-step-media { grid-column: 1; order: 1; }
  #gp-{{ sid }} .gp-step--left .gp-step-copy  { grid-column: 2; order: 2; text-align: left; }
  #gp-{{ sid }} .gp-step--right .gp-step-media { grid-column: 2; order: 2; }
  #gp-{{ sid }} .gp-step--right .gp-step-copy  { grid-column: 1; order: 1; text-align: right; }

  /* Step marker, pinned on the hairline */
  #gp-{{ sid }} .gp-tag {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--gp-parchment);
    border: 1px solid var(--gp-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: border-color 0.3s ease;
  }
  #gp-{{ sid }} .gp-step:hover .gp-tag { border-color: var(--gp-gold); }

  #gp-{{ sid }} .gp-tag-number {
    font-family: var(--gp-font-display);
    font-style: italic;
    font-size: 19px;
    color: var(--gp-gold);
  }

  /* Media */
  #gp-{{ sid }} .gp-step-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #gp-{{ sid }} .gp-step--left .gp-step-media { justify-self: end; }
  #gp-{{ sid }} .gp-step--right .gp-step-media { justify-self: start; }

  #gp-{{ sid }} .gp-step-photo {
    width: 100%;
    max-width: 340px;
    aspect-ratio: 4 / 5;
    background: var(--gp-parchment-soft);
    border: 1px solid var(--gp-line);
    overflow: hidden;
  }
  #gp-{{ sid }} .gp-step-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #gp-{{ sid }} .gp-step-icon {
    width: clamp(96px, 9vw, 130px);
    height: clamp(96px, 9vw, 130px);
    color: var(--gp-ink);
  }
  #gp-{{ sid }} .gp-step-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Copy */
  #gp-{{ sid }} .gp-step-title {
    font-family: var(--gp-font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.2;
    margin: 0 0 14px;
  }
  #gp-{{ sid }} .gp-step-text {
    font-size: 15px;
    line-height: 1.75;
    color: var(--gp-ink-soft);
    max-width: 440px;
  }
  #gp-{{ sid }} .gp-step--left .gp-step-text { margin-right: auto; }
  #gp-{{ sid }} .gp-step--right .gp-step-text { margin-left: auto; }
  #gp-{{ sid }} .gp-step-text p { margin: 0 0 12px; }
  #gp-{{ sid }} .gp-step-text p:last-child { margin-bottom: 0; }

  /* CTA */
  #gp-{{ sid }} .gp-cta-wrap {
    text-align: center;
    margin-top: 72px;
  }
  #gp-{{ sid }} .gp-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--gp-font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gp-ink);
    text-decoration: none;
    padding: 16px 36px;
    border: 1px solid var(--gp-ink);
    transition: background 0.25s ease, color 0.25s ease;
  }
  #gp-{{ sid }} .gp-cta:hover {
    background: var(--gp-ink);
    color: var(--gp-parchment);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 989px) {
    #gp-{{ sid }} .gp-thread { left: 32px; }
    #gp-{{ sid }} .gp-step,
    #gp-{{ sid }} .gp-step--left,
    #gp-{{ sid }} .gp-step--right {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 40px 0 40px 72px;
    }
    #gp-{{ sid }} .gp-step--left .gp-step-media,
    #gp-{{ sid }} .gp-step--right .gp-step-media,
    #gp-{{ sid }} .gp-step--left .gp-step-copy,
    #gp-{{ sid }} .gp-step--right .gp-step-copy {
      grid-column: 1;
      order: initial;
      justify-self: start;
      text-align: left;
    }
    #gp-{{ sid }} .gp-step--left .gp-step-text,
    #gp-{{ sid }} .gp-step--right .gp-step-text { margin-left: 0; margin-right: 0; }
    #gp-{{ sid }} .gp-step-photo { max-width: 240px; }
    #gp-{{ sid }} .gp-step-icon { width: 88px; height: 88px; }
    #gp-{{ sid }} .gp-tag {
      left: 32px;
      width: 48px;
      height: 48px;
    }
  }

  @media (max-width: 480px) {
    #gp-{{ sid }} { padding: 40px 16px 64px; }
    #gp-{{ sid }} .gp-step-photo { max-width: 180px; }
    #gp-{{ sid }} .gp-step-icon { width: 84px; height: 84px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #gp-{{ sid }} .gp-step,
    #gp-{{ sid }} .gp-tag {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

{%- endstyle -%}

<script>
  (function () {
    var steps = document.querySelectorAll('#gp-{{ sid }} .gp-step');
    if (!('IntersectionObserver' in window) || !steps.length) {
      steps.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -60px 0px' }
    );
    steps.forEach(function (el) { observer.observe(el); });
  })();
</script>

