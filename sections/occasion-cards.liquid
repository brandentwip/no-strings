{% comment %}
  Section: Dressed for the Occasion
{% endcomment %}

<section
  id="dressed-occasion-{{ section.id }}"
  class="dressed-occasion"
  style="
    --do-bg: {{ section.settings.background_color }};
    --do-heading: {{ section.settings.heading_color }};
    --do-body: {{ section.settings.body_color }};
    --do-card-overlay: {{ section.settings.overlay_color }};
    --do-card-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --do-accent: {{ section.settings.accent_color }};
    --do-button-text: {{ section.settings.button_text_color }};
    --do-button-border: {{ section.settings.button_border_color }};
    --do-card-radius: {{ section.settings.card_radius }}px;
    --do-columns: {{ section.settings.columns_desktop }};
    --do-gap: {{ section.settings.card_gap }}px;
    --do-content-width: {{ section.settings.content_width }}%;
    --do-section-top: {{ section.settings.padding_top }}px;
    --do-section-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="dressed-occasion__container">

    {% comment %} Header {% endcomment %}
    <div class="dressed-occasion__intro">

      <div class="dressed-occasion__heading-wrap">

        {% if section.settings.eyebrow != blank %}
          <p class="dressed-occasion__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="dressed-occasion__heading">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {% endif %}

      </div>

      {% if section.settings.description != blank %}
        <div class="dressed-occasion__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    {% comment %} Cards {% endcomment %}
    <div class="dressed-occasion__grid">

      {% for block in section.blocks %}

        {% liquid
          assign image = block.settings.image
          assign mobile_image = block.settings.mobile_image | default: image
          assign card_link = block.settings.link
        %}

        {% if card_link != blank %}

          <a
            href="{{ card_link }}"
            class="dressed-occasion__card"
            aria-label="{{ block.settings.title | escape }}"
            {{ block.shopify_attributes }}
          >

        {% else %}

          <div
            class="dressed-occasion__card"
            {{ block.shopify_attributes }}
          >

        {% endif %}


            {% comment %} Image {% endcomment %}
            <div class="dressed-occasion__media">

              {% if image != blank %}

                <picture>

                  {% if mobile_image != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ mobile_image | image_url: width: 600 }} 600w,
                        {{ mobile_image | image_url: width: 900 }} 900w
                      "
                    >
                  {% endif %}

                  <img
                    src="{{ image | image_url: width: 1200 }}"
                    srcset="
                      {{ image | image_url: width: 600 }} 600w,
                      {{ image | image_url: width: 800 }} 800w,
                      {{ image | image_url: width: 1000 }} 1000w,
                      {{ image | image_url: width: 1200 }} 1200w
                    "
                    sizes="
                      (max-width: 749px) 82vw,
                      (max-width: 989px) 45vw,
                      25vw
                    "
                    alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}
                      fetchpriority="high"
                    {% endif %}
                  >

                </picture>

              {% else %}

                {{ 'image' | placeholder_svg_tag: 'dressed-occasion__placeholder' }}

              {% endif %}

            </div>


            {% comment %} Diagonal texture {% endcomment %}
            <div
              class="dressed-occasion__texture"
              aria-hidden="true"
            ></div>


            {% comment %} Gradient {% endcomment %}
            <div
              class="dressed-occasion__gradient"
              aria-hidden="true"
            ></div>


            {% comment %} Card content {% endcomment %}
            <div class="dressed-occasion__content">

              {% if block.settings.label != blank %}
                <p class="dressed-occasion__label">
                  {{ block.settings.label | escape }}
                </p>
              {% endif %}


              {% if block.settings.title != blank %}
                <h3 class="dressed-occasion__title">
                  {{ block.settings.title | escape | newline_to_br }}
                </h3>
              {% endif %}


              {% if block.settings.button_label != blank %}
                <span class="dressed-occasion__button">
                  {{ block.settings.button_label | escape }}
                </span>
              {% endif %}

            </div>


        {% if card_link != blank %}

          </a>

        {% else %}

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>


<style>

  #dressed-occasion-{{ section.id }} {
    background: var(--do-bg);
    color: var(--do-heading);
    padding-top: var(--do-section-top);
    padding-bottom: var(--do-section-bottom);
    overflow: hidden;
  }


  #dressed-occasion-{{ section.id }} *,
  #dressed-occasion-{{ section.id }} *::before,
  #dressed-occasion-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* Container */

  #dressed-occasion-{{ section.id }}
  .dressed-occasion__container {
    width: min(
      var(--do-content-width),
      calc(100% - 50px)
    );

    margin: 0 auto;
  }


  /* Header */

  #dressed-occasion-{{ section.id }}
  .dressed-occasion__intro {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(280px, 0.82fr);

    gap: 50px;

    align-items: start;

    margin-bottom: 68px;
  }


  .dressed-occasion__eyebrow {
    margin: 0 0 10px;

    color: var(--do-accent);

    font-size: 11px;
    line-height: 1.3;

    letter-spacing: 0.22em;
    text-transform: uppercase;
  }


  .dressed-occasion__heading {
    max-width: 620px;

    margin: 0;

    color: var(--do-heading);

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(46px, 5vw, 76px);

    font-weight: 400;

    line-height: 0.96;

    letter-spacing: -0.045em;
  }


  .dressed-occasion__description {
    max-width: 460px;

    margin: 7px 0 0 auto;

    color: var(--do-body);

    font-size: 15px;

    line-height: 1.8;

    letter-spacing: 0.015em;
  }


  /* Grid */

  .dressed-occasion__grid {
    display: grid;

    grid-template-columns:
      repeat(
        var(--do-columns),
        minmax(0, 1fr)
      );

    gap: var(--do-gap);
  }


  /* Card */

  .dressed-occasion__card {
    position: relative;

    display: block;

    min-width: 0;

    aspect-ratio: 0.66;

    overflow: hidden;

    border-radius: var(--do-card-radius);

    color: inherit;

    text-decoration: none;

    isolation: isolate;
  }


  /* Media */

  .dressed-occasion__media,
  .dressed-occasion__media picture,
  .dressed-occasion__media img,
  .dressed-occasion__placeholder {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }


  .dressed-occasion__media img {
    display: block;

    object-fit: cover;

    object-position: center;

    transition:
      transform 700ms
      cubic-bezier(.2, .65, .25, 1);
  }


  .dressed-occasion__placeholder {
    display: block;

    background: #d7b88f;

    fill: rgba(255, 255, 255, 0.25);
  }


  /* Diagonal texture */

  {% comment %} .dressed-occasion__texture {
    position: absolute;

    inset: 0;

    z-index: 1;

    pointer-events: none;

    opacity: 0.24;

    background-image:
      repeating-linear-gradient(
        117deg,
        transparent 0,
        transparent 25px,
        rgba(255, 255, 255, 0.28) 25.5px,
        rgba(255, 255, 255, 0.28) 27px
      );

    mix-blend-mode: screen;
  } {% endcomment %}


  /* Bottom gradient */

  .dressed-occasion__gradient {
    position: absolute;

    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0) 25%,
        color-mix(
          in srgb,
          var(--do-card-overlay)
          calc(
            var(--do-card-overlay-opacity) * 100%
          ),
          transparent
        ) 100%
      );
  }


  /* Card content */

  .dressed-occasion__content {
    position: absolute;

    z-index: 3;

    right: 26px;
    bottom: 26px;
    left: 26px;
  }


  .dressed-occasion__label {
    margin: 0 0 7px;

    color: var(--do-accent);

    font-size: 11px;

    font-weight: 500;

    line-height: 1.3;

    letter-spacing: 0.21em;

    text-transform: uppercase;
  }


  .dressed-occasion__title {
    margin: 0;

    color: #fff;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        25px,
        2.1vw,
        35px
      );

    font-weight: 400;

    line-height: 1.06;

    letter-spacing: -0.025em;
  }


  /* Button */

  .dressed-occasion__button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 45px;

    margin-top: 20px;

    padding: 0 24px;

    border: 1px solid var(--do-button-border);

    color: var(--do-button-text);

    background: transparent;

    font-size: 11px;

    font-weight: 500;

    line-height: 1;

    letter-spacing: 0.06em;

    text-transform: uppercase;

    transition:
      background-color 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }


  /* Hover */

  .dressed-occasion__card:hover
  .dressed-occasion__media img {
    transform: scale(1.035);
  }


  .dressed-occasion__card:hover
  .dressed-occasion__button {
    background: var(--do-button-text);

    border-color: var(--do-button-text);

    color: var(--do-card-overlay);
  }


  /* Tablet */

  @media screen and (max-width: 989px) {

    #dressed-occasion-{{ section.id }}
    .dressed-occasion__intro {
      grid-template-columns: 1fr;

      gap: 22px;

      margin-bottom: 45px;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__description {
      margin: 0;

      max-width: 600px;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__card {
      aspect-ratio: 0.72;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__title {
      font-size:
        clamp(
          26px,
          4vw,
          34px
        );
    }

  }


  /* Mobile */

  @media screen and (max-width: 749px) {

    #dressed-occasion-{{ section.id }} {
      padding-top:
        min(
          var(--do-section-top),
          55px
        );

      padding-bottom:
        min(
          var(--do-section-bottom),
          55px
        );
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__container {
      width: calc(100% - 32px);
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__intro {
      gap: 18px;

      margin-bottom: 34px;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__heading {
      font-size:
        clamp(
          43px,
          13vw,
          62px
        );

      line-height: 0.94;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__description {
      max-width: 100%;

      font-size: 14px;

      line-height: 1.65;
    }


    /* Horizontal mobile cards */

    #dressed-occasion-{{ section.id }}
    .dressed-occasion__grid {
      display: flex;

      gap: 14px;

      overflow-x: auto;

      margin-right: -16px;

      padding-right: 16px;
      padding-bottom: 5px;

      scroll-snap-type: x mandatory;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__grid::-webkit-scrollbar {
      display: none;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__card {
      flex: 0 0 82vw;

      width: 82vw;

      aspect-ratio: 0.68;

      scroll-snap-align: start;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__content {
      right: 22px;

      bottom: 22px;

      left: 22px;
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__title {
      font-size:
        clamp(
          28px,
          8vw,
          38px
        );
    }


    #dressed-occasion-{{ section.id }}
    .dressed-occasion__button {
      min-height: 43px;

      margin-top: 17px;

      padding: 0 20px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    #dressed-occasion-{{ section.id }}
    .dressed-occasion__media img,

    #dressed-occasion-{{ section.id }}
    .dressed-occasion__button {
      transition: none;
    }

  }

</style>


{% schema %}

{
  "name": "Dressed for the occasion",
  "tag": "section",
  "class": "section-dressed-occasion",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "text"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Dressed for the\noccasion"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From the mehendi to the reception — a piece for every function on the card.</p>"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 26
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 80,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },

    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 2
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 55
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 20
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F0E5"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#35151C"
    },

    {
      "type": "color",
      "id": "body_color",
      "label": "Description",
      "default": "#7D5C51"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Card label",
      "default": "#D8B16E"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Card overlay",
      "default": "#25100D"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border",
      "default": "#D9CFC3"
    }

  ],


  "blocks": [

    {
      "type": "occasion",
      "name": "Occasion card",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },

        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Desktop image is used if this is empty."
        },

        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },

        {
          "type": "text",
          "id": "label",
          "label": "Occasion label",
          "default": "WEDDING"
        },

        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "The Bride's Edit"
        },

        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "EXPLORE EDIT"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }

      ]
    }

  ],


  "presets": [

    {
      "name": "Dressed for the occasion",

      "blocks": [

        {
          "type": "occasion",

          "settings": {
            "label": "WEDDING",
            "title": "The Bride's Edit",
            "button_label": "EXPLORE EDIT"
          }
        },

        {
          "type": "occasion",

          "settings": {
            "label": "SANGEET",
            "title": "Dance-Ready Drapes",
            "button_label": "EXPLORE EDIT"
          }
        },

        {
          "type": "occasion",

          "settings": {
            "label": "COCKTAIL",
            "title": "After-Dark Silhouettes",
            "button_label": "EXPLORE EDIT"
          }
        },

        {
          "type": "occasion",

          "settings": {
            "label": "RECEPTION",
            "title": "Statement Gowns",
            "button_label": "EXPLORE EDIT"
          }
        }

      ]
    }

  ],

  "max_blocks": 8

}

{% endschema %}