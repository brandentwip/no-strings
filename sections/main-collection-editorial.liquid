    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F1E6"
    },
    {
      "type": "color",
      "id": "secondary_background_color",
      "label": "Secondary background",
      "default": "#EFE5D4"
    },
    {
      "type": "color",
      "id": "accent_color",
