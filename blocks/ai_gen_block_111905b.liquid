{% doc %}
  @prompt
    Create a footer brand info section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-brand-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-footer-brand__logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-footer-brand__logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    display: inline-block;
  }

  .ai-footer-brand__description-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.description_spacing }}px;
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-brand__description-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-footer-brand__description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-footer-brand__contact-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.contact_item_spacing }}px;
    {% if block.settings.text_alignment == 'center' %}
      align-items: center;
    {% elsif block.settings.text_alignment == 'right' %}
      align-items: flex-end;
    {% else %}
      align-items: flex-start;
    {% endif %}
  }

  .ai-footer-brand__contact-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.contact_font_size }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-footer-brand__contact-item-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-brand__contact-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-footer-brand__contact-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-brand-{{ ai_gen_id }} {
      width: 100%;
      text-align: {{ block.settings.mobile_text_alignment }};
    }

    .ai-footer-brand__contact-{{ ai_gen_id }} {
      {% if block.settings.mobile_text_alignment == 'center' %}
        align-items: center;
      {% elsif block.settings.mobile_text_alignment == 'right' %}
        align-items: flex-end;
      {% else %}
        align-items: flex-start;
      {% endif %}
    }

    .ai-footer-brand__logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-footer-brand-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_logo and block.settings.logo %}
    <div class="ai-footer-brand__logo-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.logo | image_url: width: 400 }}"
        alt="{{ shop.name }}"
        loading="lazy"
        width="{{ block.settings.logo.width }}"
        height="{{ block.settings.logo.height }}"
      >
    </div>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-footer-brand__description-{{ ai_gen_id }}">
      {{ block.settings.description }}
    </div>
  {% endif %}

  <div class="ai-footer-brand__contact-{{ ai_gen_id }}">
    {% if block.settings.show_email and block.settings.email != blank %}
      <a href="mailto:{{ block.settings.email }}" class="ai-footer-brand__contact-item-{{ ai_gen_id }}">
        <span class="ai-footer-brand__contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 6l10 7 10-7"/>
          </svg>
        </span>
        <span>{{ block.settings.email }}</span>
      </a>
    {% endif %}

    {% if block.settings.show_phone and block.settings.phone != blank %}
      <a href="tel:{{ block.settings.phone }}" class="ai-footer-brand__contact-item-{{ ai_gen_id }}">
        <span class="ai-footer-brand__contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <span>{{ block.settings.phone }}</span>
      </a>
    {% endif %}

    {% if block.settings.show_address and block.settings.address != blank %}
      <div class="ai-footer-brand__contact-item-{{ ai_gen_id }}">
        <span class="ai-footer-brand__contact-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <span>{{ block.settings.address }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Footer brand info",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Logo spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Brand description",
      "default": "<p>Share your brand story and connect with your customers.</p>"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Spacing below",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@example.com"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+1 234 567 8900"
    },
    {
      "type": "checkbox",
      "id": "show_address",
      "label": "Show address",
      "default": true
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Main Street, New York, NY 10001"
    },
    {
      "type": "range",
      "id": "contact_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "contact_item_spacing",
      "label": "Spacing between items",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Desktop text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Footer brand info"
    }
  ]
}
{% endschema %}
