{% doc %}
  @prompt
    little eyebrow text section to be placed above title of the product which contains designer name and it shoould be connected with metafield
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-designer-eyebrow-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin-bottom: {{ block.settings.spacing_below }}px;
  }

  .ai-designer-eyebrow-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family }};
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    font-weight: {{ block.settings.font_weight }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-designer-eyebrow-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-designer-eyebrow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.metafield_namespace != blank and block.settings.metafield_key != blank %}
    {% assign designer_name = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key] %}
    {% if designer_name != blank %}
      <p class="ai-designer-eyebrow-text-{{ ai_gen_id }}">{{ designer_name }}</p>
    {% else %}
      <p class="ai-designer-eyebrow-text-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
        {{ block.settings.fallback_text }}
      </p>
    {% endif %}
  {% else %}
    <p class="ai-designer-eyebrow-text-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
      Configure metafield namespace and key
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Designer eyebrow text",
  "settings": [
    {
      "type": "header",
      "content": "Metafield settings"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "info": "Example: custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "Example: designer_name"
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Designer name not set"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "var(--type-base-font)",
          "label": "Body"
        },
        {
          "value": "var(--type-subheading-font)",
          "label": "Subheading"
        },
        {
          "value": "var(--type-heading-font)",
          "label": "Heading"
        },
        {
          "value": "var(--type-accent-font)",
          "label": "Accent"
        }
      ],
      "default": "var(--type-base-font)"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "spacing_below",
      "label": "Spacing below",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Designer eyebrow text"
    }
  ]
}
{% endschema %}
