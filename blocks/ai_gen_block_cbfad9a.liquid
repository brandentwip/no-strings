{% doc %}
  @prompt
    Create a chat on whatsapp button linking to the query of the product and shall match my website theme, api.whatsapp.com is blocked
    api.whatsapp.com refused to connect.
    ERR_BLOCKED_BY_RESPONSE
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign whatsapp_phone = block.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}
{% capture whatsapp_message %}{{ block.settings.message_template | replace: '[product]', product.title | replace: '[url]', shop.url | append: product.url }}{% endcapture %}

{% style %}
  .ai-whatsapp-button-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; }
  .ai-whatsapp-button-{{ ai_gen_id }}__link { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 48px; padding: 14px 22px; border: {{ block.settings.border_width }}px solid {{ block.settings.button_border_color }}; border-radius: {{ block.settings.border_radius }}px; background: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }}; font-family: {{ block.settings.font.family }}, sans-serif; font-size: {{ block.settings.font_size }}px; line-height: 1.2; text-align: center; text-decoration: none; text-transform: {{ block.settings.text_case }}; cursor: pointer; }
  .ai-whatsapp-button-{{ ai_gen_id }}__link:hover { opacity: .82; }
  .ai-whatsapp-button-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid {{ block.settings.button_text_color }}; outline-offset: 3px; }
  .ai-whatsapp-button-{{ ai_gen_id }}__icon { display: inline-flex; flex: 0 0 auto; }
  .ai-whatsapp-button-{{ ai_gen_id }}__icon svg { width: 20px; height: 20px; fill: currentColor; }
{% endstyle %}

<div class="ai-whatsapp-button-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a class="ai-whatsapp-button-{{ ai_gen_id }}__link" href="https://wa.me/{{ whatsapp_phone }}?text={{ whatsapp_message | strip | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.button_label | escape }}">
    <span class="ai-whatsapp-button-{{ ai_gen_id }}__icon" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.53 0 .2 5.33.2 11.88c0 2.09.55 4.13 1.59 5.93L.1 24l6.34-1.66a11.86 11.86 0 0 0 5.64 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.18-1.24-6.16-3.45-8.41ZM12.09 21.7h-.01a9.84 9.84 0 0 1-5.02-1.37l-.36-.21-3.76.98 1-3.66-.23-.38a9.85 9.85 0 0 1-1.51-5.18C2.2 6.12 6.63 1.69 12.08 1.69c2.64 0 5.12 1.03 6.98 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.43 9.88-9.86 9.88Zm5.42-7.4c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.67-2.06-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.53.07-.81.38-.28.3-1.06 1.04-1.06 2.54s1.09 2.95 1.24 3.15c.15.2 2.14 3.27 5.19 4.59.73.32 1.3.51 1.75.65.74.24 1.41.2 1.94.12.59-.09 1.78-.73 2.03-1.44.25-.71.25-1.32.18-1.44-.07-.13-.28-.2-.58-.35Z"/></svg></span>
    <span>{{ block.settings.button_label }}</span>
  </a>
</div>

{% schema %}
{
  "name": "WhatsApp product chat",
  "settings": [
    { "type": "header", "content": "Message" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "919876543210" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Chat on WhatsApp" },
    { "type": "textarea", "id": "message_template", "label": "Message", "default": "Hello, I would like to know more about [product]. Product link: [url]" },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "red_hat_text_n4" },
    { "type": "select", "id": "text_case", "label": "Text case", "options": [{ "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "button_background", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_border_color", "label": "Border", "default": "#000000" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "WhatsApp product chat" }],
  "tag": null,
  "class": "whatsapp-product-chat-block"
}
{% endschema %}