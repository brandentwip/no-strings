{% doc %}
  @prompt
    BEFORE
    - Try it on the day you receive it to check the fit.
    - Apply perfume, hairspray and makeup before dressing, and let them dry.
    
    WHILE WEARING
    - Handle mirror work, zardozi and sequins gently.
    - Lift the hem when you sit or climb stairs.
    - Watch for snags from bangles and accessories, and stay away from candles and open flames.
    
    AFTER
    - Don't wash, dry clean, iron or steam it, and don't try to remove stains. Our team will take care of it.
    - Fold it gently and pack every piece back into the garment bag it arrived in. "Create a beautiful block with this text"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-care-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 28px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-care-guide-{{ ai_gen_id }}__heading {
    margin: 0 0 22px;
    color: {{ block.settings.text_color }};
    font-family: var(--font-heading--family, serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.15;
  }

  .ai-care-guide-{{ ai_gen_id }}__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .ai-care-guide-{{ ai_gen_id }}__group {
    padding: 0 22px;
    border-left: 1px solid {{ block.settings.border_color }};
  }

  .ai-care-guide-{{ ai_gen_id }}__group:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .ai-care-guide-{{ ai_gen_id }}__group:last-child {
    padding-right: 0;
  }

  .ai-care-guide-{{ ai_gen_id }}__label {
    margin: 0 0 14px;
    color: {{ block.settings.accent_color }};
    font-family: var(--font-subheading--family, sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-care-guide-{{ ai_gen_id }}__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-care-guide-{{ ai_gen_id }}__item {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: start;
    gap: 10px;
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px;
    line-height: 1.65;
  }

  .ai-care-guide-{{ ai_gen_id }}__marker {
    width: 6px;
    height: 6px;
    margin-top: 9px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-care-guide-{{ ai_gen_id }} {
      padding: 22px;
    }

    .ai-care-guide-{{ ai_gen_id }}__groups {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-care-guide-{{ ai_gen_id }}__group,
    .ai-care-guide-{{ ai_gen_id }}__group:first-child,
    .ai-care-guide-{{ ai_gen_id }}__group:last-child {
      padding: 0;
      border: 0;
    }

    .ai-care-guide-{{ ai_gen_id }}__group + .ai-care-guide-{{ ai_gen_id }}__group {
      padding-top: 18px;
      border-top: 1px solid {{ block.settings.border_color }};
    }
  }
{% endstyle %}

<div class="ai-care-guide-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-care-guide-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-care-guide-{{ ai_gen_id }}__groups">
    <section class="ai-care-guide-{{ ai_gen_id }}__group" aria-labelledby="ai-care-before-{{ ai_gen_id }}">
      <h3 class="ai-care-guide-{{ ai_gen_id }}__label" id="ai-care-before-{{ ai_gen_id }}">Before</h3>
      <ul class="ai-care-guide-{{ ai_gen_id }}__list">
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Try it on the day you receive it to check the fit.</span></li>
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Apply perfume, hairspray and makeup before dressing, and let them dry.</span></li>
      </ul>
    </section>
    <section class="ai-care-guide-{{ ai_gen_id }}__group" aria-labelledby="ai-care-wearing-{{ ai_gen_id }}">
      <h3 class="ai-care-guide-{{ ai_gen_id }}__label" id="ai-care-wearing-{{ ai_gen_id }}">While wearing</h3>
      <ul class="ai-care-guide-{{ ai_gen_id }}__list">
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Handle mirror work, zardozi and sequins gently.</span></li>
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Lift the hem when you sit or climb stairs.</span></li>
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Watch for snags from bangles and accessories, and stay away from candles and open flames.</span></li>
      </ul>
    </section>
    <section class="ai-care-guide-{{ ai_gen_id }}__group" aria-labelledby="ai-care-after-{{ ai_gen_id }}">
      <h3 class="ai-care-guide-{{ ai_gen_id }}__label" id="ai-care-after-{{ ai_gen_id }}">After</h3>
      <ul class="ai-care-guide-{{ ai_gen_id }}__list">
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Dont wash, dry clean, iron or steam it, and don't try to remove stains. Our team will take care of it.</span></li>
        <li class="ai-care-guide-{{ ai_gen_id }}__item"><span class="ai-care-guide-{{ ai_gen_id }}__marker" aria-hidden="true"></span><span>Place it back in the garment bag with the hanger and pack it in the same box for pick up.
</span></li>
      </ul>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Garment care guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little care goes a long way"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#17181B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2A1015"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#D8D4D1"
    }
  ],
  "presets": [
    {
      "name": "Garment care guide"
    }
  ],
  "tag": null,
  "class": "garment-care-guide"
}
{% endschema %}