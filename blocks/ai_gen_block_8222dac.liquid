{% doc %}
  @prompt
    Create a chat on whatsapp button linking to the query of the product
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign whatsapp_number = block.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}
{% capture whatsapp_message %}{{ block.settings.message }} {{ product.title }} — {{ shop.url }}{{ product.url }}{% endcapture %}

{% style %}
  .ai-whatsapp-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 14px 22px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-whatsapp-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-whatsapp-button-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-whatsapp-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }
{% endstyle %}

<a
  class="ai-whatsapp-button-{{ ai_gen_id }}"
  href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message | strip | url_encode }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ block.settings.button_label | escape }}"
  {{ block.shopify_attributes }}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.1-1.3-6.1-3.5-8.3ZM12.2 21.5c-1.7 0-3.3-.4-4.7-1.2l-.3-.2-3.9 1 1-3.8-.2-.3a9.7 9.7 0 1 1 8.1 4.5Zm5.3-7.3c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.6.1-.2.1-.4 0-.6-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.3c.2.2 2.3 3.5 5.6 4.9.8.3 1.4.5 1.9.6.8.2 1.5.1 2.1.1.7-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3Z"/>
  </svg>
  <span>{{ block.settings.button_label }}</span>
</a>

{% schema %}
{
  "name": "WhatsApp product chat",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "919876543210"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message prefix",
      "default": "Hi, I am interested in this product:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Background",
      "default": "#159B72"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background",
      "default": "#0B6B4C"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp product chat"
    }
  ],
  "tag": null,
  "class": "whatsapp-product-chat-block"
}
{% endschema %}