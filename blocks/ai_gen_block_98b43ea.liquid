{% doc %}
  @prompt
    Create a reusable block specifically for the Shopify product page template, inside the Product information section, to be placed directly below the existing Refundable security deposit badge. Do not create a homepage section or a sitewide section. Match the attached reference image: use a warm ivory/cream background approximately #F4EBDD, no visible border, minimal softly rounded corners, and refined dark taupe-gray editorial text approximately #4B4338. Display three benefits in one horizontal row on desktop with evenly distributed spacing: “Pan-India delivery” with a small muted champagne-gold check icon, “Dry-cleaned & quality-checked” with the same check icon, and “Easy returns” with a small muted champagne-gold circular return-arrow icon. Match the compact height, quiet premium fashion-rental aesthetic, and responsive mobile wrapping/stacking shown in the reference. Do not add shadows, gradients, bright colors, buttons, or extra decoration. Include theme-editor settings for the three labels, background, text and icon colors, typography size, spacing, padding, and corner radius. The block must be addable and movable within the product page’s Product information blocks, directly beneath the existing refundable security deposit badge.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-benefits-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }
  .ai-product-benefits__list-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: space-between; gap: {{ block.settings.item_spacing }}px; width: 100%; margin: 0; padding: 0; list-style: none; }
  .ai-product-benefits__item-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; gap: 8px; flex: 1 1 0; min-width: 0; text-align: center; font-family: {{ settings.type_body_font.family }}, sans-serif; font-size: {{ block.settings.text_size }}px; line-height: 1.35; letter-spacing: 0.01em; }
  .ai-product-benefits__icon-{{ ai_gen_id }} { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 14px; height: 14px; color: {{ block.settings.icon_color }}; }
  .ai-product-benefits__icon-{{ ai_gen_id }} svg { display: block; width: 100%; height: 100%; }
  @media screen and (max-width: 749px) {
    .ai-product-benefits-{{ ai_gen_id }} { width: 100%; }
    .ai-product-benefits__list-{{ ai_gen_id }} { flex-wrap: wrap; row-gap: {{ block.settings.item_spacing | divided_by: 2 }}px; }
    .ai-product-benefits__item-{{ ai_gen_id }} { flex: 1 1 calc(50% - {{ block.settings.item_spacing | divided_by: 2 }}px); }
    .ai-product-benefits__item-{{ ai_gen_id }}:last-child { flex-basis: 100%; }
  }
{% endstyle %}

<product-benefits-{{ ai_gen_id }} class="ai-product-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-product-benefits__list-{{ ai_gen_id }}" role="list">
    <li class="ai-product-benefits__item-{{ ai_gen_id }}"><span class="ai-product-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.25 8.25 6.5 11.5 12.75 4.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{{ block.settings.benefit_one }}</span></li>
    <li class="ai-product-benefits__item-{{ ai_gen_id }}"><span class="ai-product-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.25 8.25 6.5 11.5 12.75 4.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{{ block.settings.benefit_two }}</span></li>
    <li class="ai-product-benefits__item-{{ ai_gen_id }}"><span class="ai-product-benefits__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 6.25A5.25 5.25 0 1 0 13.2 9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M13 2.75v3.5H9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{{ block.settings.benefit_three }}</span></li>
  </ul>
</product-benefits-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('product-benefits-{{ ai_gen_id }}')) {
      class ProductBenefits{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('product-benefits-{{ ai_gen_id }}', ProductBenefits{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Product benefits",
  "settings": [
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "benefit_one", "label": "First label", "default": "Pan-India delivery" },
    { "type": "text", "id": "benefit_two", "label": "Second label", "default": "Dry-cleaned & quality-checked" },
    { "type": "text", "id": "benefit_three", "label": "Third label", "default": "Easy returns" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "item_spacing", "label": "Item spacing", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "horizontal_padding", "label": "Horizontal padding", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 3 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4EBDD" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B4338" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "#B39A6B" }
  ],
  "presets": [{ "name": "Product benefits" }],
  "tag": null,
  "class": "product-benefits-block"
}
{% endschema %}