 trying on several garments.","customer_name":"Arushi Sharma","location":"Delhi","amount_saved":"Saved ₹98,500"}},"testimonial_mhYHrW":{"type":"testimonial","settings":{"vimeo_url":"","unmute_label":"Unmute","video_caption":"\"...and found so many designer outfits\"","headline":"A happy customer","quote":"What I love most is that I don't need to spend a fortune on an outfit I'd probably only wear once or twice.","customer_name":"Arushi Sharma","location":"New Delhi","amount_saved":"Saved ₹98,500"}}},"block_order":["testimonial_CQfKbR","testimonial_hdjhPe","testimonial_Qyng3E","testimonial_mhYHrW"],"disabled":true,"name":"Our Story","settings":{"show_breadcrumb":true,"breadcrumb_home_label":"Home","breadcrumb_current_label":"Our Story","hero_eyebrow":"Our story","hero_heading":"Why nostringscouture?","whyus_eyebrow":"Why rent with us","whyus_heading":"A better way to wear couture","customers_eyebrow":"Real stories","customers_heading":"Know our customers","show_featured_testimonial":true,"featured_testimonial_quote":"Renting from nostringscouture meant I could wear an Anita Dongre lehenga for my cousin's sangeet without the guilt of a one-time-wear price tag. The fit was perfect, the piece arrived days early, and returning it was as easy as ordering it.","featured_testimonial_name":"Priya Malhotra","featured_testimonial_location":"Mumbai","featured_testimonial_saved":"Saved ₹85,000","cta_heading":"Ready to find your piece?","cta_primary_label":"Browse the edit","cta_primary_link":"","cta_secondary_label":"How renting works","cta_secondary_link":""}},"custom_liquid_UiFbFa":{"type":"custom-liquid","disabled":true,"custom_css":["p {font-size: 17px;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- ============================================================\n  \"Why Us\" content block - plain HTML\/CSS\/JS, no Liquid.\n  Paste this whole block into a \"Custom HTML\" \/ \"Custom Liquid\"\n  section in the Shopify theme editor (most themes have one).\n  Edit the text directly in this file wherever you see copy,\n  names, or numbers you want to change.\n============================================================ -->\n\n<link rel=\"stylesheet\" href=\"https:\/\/fonts.googleapis.com\/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Fraunces:ital,opsz,wght@1,9..144,400&family=Jost:wght@300;400;500&display=swap\">\n\n<style>\n.why-us-scope {\n  --ink:#2A1015;\n  --ink-soft:#3D1E22;\n  --ivory:#F7F1E6;\n  --ivory-deep:#EFE5D4;\n  --gold:#B8935A;\n  --gold-bright:#D4AC72;\n  --rose:#C79088;\n  --text:#2A1015;\n  --text-soft:#6B4C48;\n}\n.why-us-scope * {box-sizing:border-box;}\n.why-us-scope {\n  background:var(--ivory);\n  color:var(--text);\n  font-family:'Jost', sans-serif;\n  font-weight:300;\n  overflow-x:hidden;\n}\n.why-us-scope h1, .why-us-scope h2, .why-us-scope h3, .why-us-scope .serif {\n  font-family:'Fraunces', serif;\n  font-weight:500;\n  letter-spacing:-0.01em;\n  color:var(--ink);\n  margin:0;\n}\n.why-us-scope p { margin:0; }\n.why-us-scope .eyebrow {\n  font-family:'Jost',sans-serif;\n  text-transform:uppercase;\n  letter-spacing:0.22em;\n  font-size:11px;\n  color:var(--gold);\n  font-weight:500;\n}\n.why-us-scope a {color:inherit; text-decoration:none;}\n.why-us-scope .wrap {max-width:1240px; margin:0 auto; padding:0 48px;}\n@media(max-width:768px){.why-us-scope .wrap {padding:0 22px;}}\n\n\/* ===== drape line signature ===== *\/\n.why-us-scope .drape-svg {position:absolute; pointer-events:none;}\n.why-us-scope .drape-path {\n  fill:none; stroke:var(--gold); stroke-width:1.4;\n  stroke-dasharray:1400; stroke-dashoffset:1400;\n  animation:whyus-draw 2.6s ease forwards 0.3s;\n}\n@keyframes whyus-draw{to{stroke-dashoffset:0;}}\n@media (prefers-reduced-motion: reduce){.why-us-scope .drape-path {animation:none; stroke-dashoffset:0;}}\n\n\/* ===== breadcrumb ===== *\/\n.why-us-scope .breadcrumb {padding:18px 0; font-size:12px; letter-spacing:0.03em; color:var(--text-soft);}\n.why-us-scope .breadcrumb a:hover {color:var(--gold);}\n.why-us-scope .breadcrumb .sep {margin:0 8px; opacity:0.5;}\n.why-us-scope .breadcrumb .current {color:var(--ink);}\n\n\/* ===== shared buttons ===== *\/\n.why-us-scope .hero-cta {margin-top:38px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; justify-content:center;}\n.why-us-scope .btn-primary {\n  background:var(--ink); color:var(--ivory); padding:16px 34px;\n  border-radius:2px; font-size:13px; letter-spacing:0.08em; text-transform:uppercase;\n  transition:background .3s ease; display:inline-block;\n}\n.why-us-scope .btn-primary:hover {background:var(--ink-soft);}\n.why-us-scope .btn-ghost {\n  font-size:13px; letter-spacing:0.05em; border-bottom:1px solid var(--gold); padding-bottom:3px;\n}\n\n\/* ===== image placeholder block ===== *\/\n.why-us-scope .img-block {\n  background:linear-gradient(150deg,#D9C4A8 0%, #C79A66 45%, #8C5A44 100%);\n  display:flex; align-items:flex-end; justify-content:center;\n  color:rgba(255,255,255,0.75); font-family:'Jost'; font-size:11px; letter-spacing:0.12em; text-transform:uppercase;\n  position:relative; overflow:hidden; width:100%; height:100%;\n}\n.why-us-scope .img-block::before{\n  content:''; position:absolute; inset:0;\n  background-image:repeating-linear-gradient(115deg, rgba(255,255,255,0.05) 0 2px, transparent 2px 26px);\n}\n.why-us-scope .img-block img {position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}\n\n\/* ===== our story hero ===== *\/\n.why-us-scope .story-hero {padding:70px 0 50px; text-align:center; position:relative; overflow:hidden;}\n.why-us-scope .story-hero-drape {position:absolute; top:0; left:50%; transform:translateX(-50%); width:240px; height:80px; opacity:0.6; pointer-events:none;}\n.why-us-scope .story-hero h1 {font-size:clamp(32px,4.4vw,54px); margin-top:14px;}\n\n\/* -- why us: sticky video + scrolling benefits, merged with proof -- *\/\n.why-us-scope .whyus-section {padding:100px 0 120px;}\n.why-us-scope .whyus-head {text-align:center; margin-bottom:70px;}\n.why-us-scope .whyus-head .eyebrow {display:block; margin-bottom:14px;}\n.why-us-scope .whyus-head h2 {font-size:clamp(28px,3.4vw,42px); margin-top:12px;}\n\n.why-us-scope .whyus-layout {display:grid; grid-template-columns:0.9fr 1.1fr; gap:64px; align-items:start;}\n@media(max-width:900px){.why-us-scope .whyus-layout {grid-template-columns:1fr; gap:40px;}}\n\n.why-us-scope .whyus-video-col {position:sticky; top:100px;}\n@media(max-width:900px){.why-us-scope .whyus-video-col {position:static;}}\n.why-us-scope .whyus-video-frame {\n  position:relative; aspect-ratio:4\/5; border-radius:2px; overflow:hidden;\n  background:linear-gradient(150deg,#D9C4A8 0%, #C79A66 45%, #8C5A44 100%);\n}\n.why-us-scope .whyus-video-frame .img-block {height:100%;}\n.why-us-scope .whyus-video-item {\n  position:absolute; inset:0; opacity:0; z-index:0; pointer-events:none;\n  transition:opacity .5s ease;\n}\n.why-us-scope .whyus-video-item.is-active {opacity:1; z-index:1; pointer-events:auto;}\n.why-us-scope .whyus-video-item iframe {\n  position:absolute; inset:0; width:100%; height:100%; border:0; display:block;\n}\n.why-us-scope .whyus-unmute {\n  position:absolute; top:16px; left:16px; z-index:2; background:rgba(20,7,9,0.55); color:var(--ivory);\n  font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; padding:6px 12px; border-radius:100px;\n}\n.why-us-scope .whyus-caption {\n  position:absolute; left:16px; right:16px; bottom:18px; z-index:2; background:rgba(20,7,9,0.62);\n  color:var(--ivory); font-size:13px; padding:10px 14px; border-radius:2px; text-align:center; line-height:1.4;\n  transition:opacity .3s ease;\n}\n.why-us-scope .whyus-proof-card {\n  background:var(--ivory-deep); border-radius:2px; padding:22px 24px; margin-top:18px;\n  transition:opacity .3s ease;\n}\n.why-us-scope .whyus-proof-card p {font-size:13px; font-style:italic; color:var(--ink); line-height:1.7; margin-bottom:14px;}\n.why-us-scope .whyus-proof-meta {display:flex; justify-content:space-between; align-items:center; font-size:11.5px; color:var(--text-soft); flex-wrap:wrap; gap:6px;}\n.why-us-scope .whyus-proof-meta .t-name {color:var(--ink); font-weight:500;}\n.why-us-scope .whyus-proof-save {background:var(--ivory); color:var(--gold); font-size:10.5px; padding:5px 10px; border-radius:100px; font-weight:500;}\n\n.why-us-scope .whyus-points {display:flex; flex-direction:column;}\n.why-us-scope .whyus-point {\n  padding:44px 0; border-bottom:1px solid rgba(42,16,21,0.1);\n  display:flex; gap:22px;\n}\n.why-us-scope .whyus-point:first-child {padding-top:6px;}\n.why-us-scope .whyus-point-icon {\n  width:52px; height:52px; border-radius:50%; background:var(--gold); border:1px solid var(--gold); flex-shrink:0;\n  display:flex; align-items:center; justify-content:center;\n}\n.why-us-scope .whyus-point-icon svg {width:21px; height:21px; stroke:var(--ivory); fill:none; stroke-width:1.3;}\n.why-us-scope .whyus-point-text .num {font-family:'Fraunces'; font-style:italic; color:var(--gold); font-size:13px; display:block; margin-bottom:6px;}\n.why-us-scope .whyus-point-text h3 {font-size:19px; font-weight:400; font-family:'Fraunces'; color:var(--ink); margin-bottom:10px;}\n.why-us-scope .whyus-point-text p {font-size:14px; color:var(--text-soft); line-height:1.8; max-width:420px;}\n\n\/* ===== newsletter \/ cta band ===== *\/\n.why-us-scope .cta-band {padding:110px 0; text-align:center;}\n.why-us-scope .cta-band h2 {font-size:clamp(30px,4vw,50px); max-width:640px; margin:0 auto 30px;}\n<\/style>\n\n<div class=\"why-us-scope\" id=\"why-us-block\">\n\n  <div class=\"breadcrumb\">\n    <div class=\"wrap\">\n      <a href=\"\/\">Home<\/a>\n      <span class=\"sep\">\/<\/span>\n      <span class=\"current\">Our Story<\/span>\n    <\/div>\n  <\/div>\n\n  <section class=\"story-hero\">\n    <svg class=\"drape-svg story-hero-drape\" viewBox=\"0 0 240 80\" preserveAspectRatio=\"none\">\n      <path class=\"drape-path\" style=\"stroke-width:1;\" d=\"M 10 8 C 80 60, 140 -10, 230 40\"\/>\n    <\/svg>\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">Our story<\/span>\n      <h1>Why nostringscouture?<\/h1>\n    <\/div>\n  <\/section>\n\n  <section class=\"whyus-section\">\n    <div class=\"wrap\">\n      <div class=\"whyus-head\">\n        <span class=\"eyebrow\">Why rent with us<\/span>\n        <h2>A better way to wear couture<\/h2>\n      <\/div>\n\n      <div class=\"whyus-layout\">\n\n        <!-- STICKY VIDEO + PROOF -->\n        <div class=\"whyus-video-col\">\n          <div class=\"whyus-video-frame\" id=\"whyusVideoFrame\">\n\n            <!-- ===== VIDEO 1 - Arushi Sharma (shown by default) ===== -->\n            <div class=\"whyus-video-item is-active\" data-video-index=\"0\">\n              <iframe src=\"https:\/\/player.vimeo.com\/video\/897145429?background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0\"\n                      frameborder=\"0\" allow=\"autoplay; fullscreen\" allowfullscreen loading=\"lazy\"><\/iframe>\n            <\/div>\n\n            <!-- ===== VIDEO 2 - Anushka Sharma ===== -->\n            <div class=\"whyus-video-item\" data-video-index=\"1\">\n              <iframe src=\"https:\/\/player.vimeo.com\/video\/897145830?background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0\"\n                      frameborder=\"0\" allow=\"autoplay; fullscreen\" allowfullscreen loading=\"lazy\"><\/iframe>\n            <\/div>\n\n            <!-- ===== VIDEO 3 - Nilfa Saha Karmakar ===== -->\n            <div class=\"whyus-video-item\" data-video-index=\"2\">\n              <iframe src=\"https:\/\/player.vimeo.com\/video\/1003171680?background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0\"\n                      frameborder=\"0\" allow=\"autoplay; fullscreen\" allowfullscreen loading=\"lazy\"><\/iframe>\n            <\/div>\n\n            <!-- ===== VIDEO 4 - Reeti Sahai ===== -->\n            <div class=\"whyus-video-item\" data-video-index=\"3\">\n              <iframe src=\"https:\/\/player.vimeo.com\/video\/1003116613?background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0\"\n                      frameborder=\"0\" allow=\"autoplay; fullscreen\" allowfullscreen loading=\"lazy\"><\/iframe>\n            <\/div>\n\n            <span class=\"whyus-unmute\">Unmute<\/span>\n            <div class=\"whyus-caption\" id=\"whyusCaption\">\"...and found so many designer outfits\"<\/div>\n          <\/div>\n          <div class=\"whyus-proof-card\" id=\"whyusProofCard\">\n            <p id=\"whyusQuote\">\"You never have to repeat an outfit, because pieces are given for just one-time use, and the pricing is a cherry on top.\"<\/p>\n            <div class=\"whyus-proof-meta\">\n              <span><span class=\"t-name\" id=\"whyusName\">Arushi Sharma<\/span> &middot; <span id=\"whyusLoc\">Chandigarh<\/span><\/span>\n              <span class=\"whyus-proof-save\" id=\"whyusSave\">Saved &#8377;98,500<\/span>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <!-- SCROLLING POINTS -->\n        <div class=\"whyus-points\">\n\n          <div class=\"whyus-point\" data-testi=\"0\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3 4 7v5c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7l-8-4Z\"\/><path d=\"M9 12l2 2 4-4\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">01<\/span>\n              <h3>Limited access<\/h3>\n              <p>Each lehenga and sharara set is offered only a limited number of times, to keep the collection exclusive.<\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"whyus-point\" data-testi=\"1\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 7l1 12a1.2 1.2 0 0 0 1.2 1.1h11.6A1.2 1.2 0 0 0 19 19L20 7M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">02<\/span>\n              <h3>Access to a fresh catalog<\/h3>\n              <p>Every piece is freshly sourced straight from designer houses, part of their newest collections.<\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"whyus-point\" data-testi=\"2\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3v18M8 7.5c0-1.5 1.8-2.5 4-2.5s4 1 4 2.5-1.8 2-4 2.5-4 1-4 2.5 1.8 2.5 4 2.5 4-1 4-2.5\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">03<\/span>\n              <h3>Cost effective<\/h3>\n              <p>We've got every function of the wedding covered, at a fraction of what buying would cost.<\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"whyus-point\" data-testi=\"3\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12h13M11 6l6 6-6 6M17 6h4v12h-4\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">04<\/span>\n              <h3>Short delivery timelines<\/h3>\n              <p>We take orders as late as 7 days before your occasion, a rare thing when it comes to Indian couture.<\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"whyus-point\" data-testi=\"0\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 4.5 12 3l6 1.5v6c0 5-2.7 8-6 10-3.3-2-6-5-6-10v-6Z\"\/><path d=\"M9.5 12l1.8 1.8L15 10\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">05<\/span>\n              <h3>Customised couture<\/h3>\n              <p>Every garment is customised to your exact measurements before it reaches you, so it fits like a glove.<\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"whyus-point\" data-testi=\"1\">\n            <div class=\"whyus-point-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3c1.2 2.2 3.3 3.4 5.5 3.6-.4 4.6-2.4 8.6-5.5 9.9-3.1-1.3-5.1-5.3-5.5-9.9C8.7 6.4 10.8 5.2 12 3Z\"\/><\/svg><\/div>\n            <div class=\"whyus-point-text\">\n              <span class=\"num\">06<\/span>\n              <h3>Flexibility to experiment<\/h3>\n              <p>Experiment with your style, without the pressure of investing only in \"evergreen\" outfits.<\/p>\n            <\/div>\n          <\/div>\n\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"cta-band\">\n    <div class=\"wrap\">\n      <h2>Ready to find your piece?<\/h2>\n      <div class=\"hero-cta\">\n        <a href=\"#\" class=\"btn-primary\">Browse the edit<\/a>\n        <a href=\"#\" class=\"btn-ghost\">How renting works<\/a>\n      <\/div>\n    <\/div>\n  <\/section>\n\n<\/div>\n\n<script>\n(function(){\n  var testimonials = [\n    { caption: '\"...and found so many designer outfits\"', quote: '\"You never have to repeat an outfit, because pieces are given for just one-time use, and the pricing is a cherry on top.\"', name: 'Arushi Sharma', loc: 'Chandigarh', save: 'Saved \\u20B998,500' },\n    { caption: '\"I chose a platform...\"', quote: '\"nostringscouture is a great fit for someone like me who doesn\\'t like repeating outfits or storing heavy lehengas in my closet.\"', name: 'Anushka Sharma', loc: 'Toronto, Canada', save: 'Saved \\u20B998,500' },\n    { caption: '\"...free experience\"', quote: '\"The seamless process spared me the whole experience and trouble of going to multiple stores and trying on several garments.\"', name: 'Nilfa Saha Karmakar', loc: 'Delhi', save: 'Saved \\u20B975,500' },\n    { caption: '\"...to actually choose and wear\"', quote: '\"What I love most is that I don\\'t need to spend a fortune on an outfit I\\'d probably only wear once or twice.\"', name: 'Reeti Sahai', loc: 'New Delhi', save: 'Saved \\u20B998,500' }\n  ];\n\n  var root = document.getElementById('why-us-block');\n  if(!root) return;\n\n  var points = root.querySelectorAll('.whyus-point');\n  var captionEl = document.getElementById('whyusCaption');\n  var quoteEl = document.getElementById('whyusQuote');\n  var nameEl = document.getElementById('whyusName');\n  var locEl = document.getElementById('whyusLoc');\n  var saveEl = document.getElementById('whyusSave');\n  var proofCard = document.getElementById('whyusProofCard');\n  var videoItems = root.querySelectorAll('.whyus-video-item');\n\n  function setActive(idx){\n    var t = testimonials[idx];\n    if(!t) return;\n\n    videoItems.forEach(function(v){\n      v.classList.toggle('is-active', parseInt(v.dataset.videoIndex, 10) === idx);\n    });\n\n    proofCard.style.opacity = 0;\n    captionEl.style.opacity = 0;\n    setTimeout(function(){\n      captionEl.textContent = t.caption;\n      quoteEl.textContent = t.quote;\n      nameEl.textContent = t.name;\n      locEl.textContent = t.loc;\n      saveEl.textContent = t.save;\n      proofCard.style.opacity = 1;\n      captionEl.style.opacity = 1;\n    }, 150);\n  }\n\n  if('IntersectionObserver' in window){\n    var observer = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if(entry.isIntersecting){\n          setActive(parseInt(entry.target.dataset.testi, 10));\n        }\n      });\n    }, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });\n    points.forEach(function(p){ observer.observe(p); });\n  }\n})();\n<\/script>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"why_us_6bXHX8":{"type":"why-us","blocks":{"bento_item_NVGhjC":{"type":"bento_item","settings":{"number_label":"01","icon":"cost","heading":"Cost effective","text":"Designerwear, without the price tag- Dress for every wedding function in designer wear, at a fraction of the cost of buying each look","layout":"feature","gold_accent":false}},"bento_item_AR4UXL":{"type":"bento_item","settings":{"number_label":"02","icon":"limited","heading":"Limited access","text":"Exclusively Yours- Each piece is offered only 