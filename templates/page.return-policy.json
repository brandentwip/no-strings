{"sections":{"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"t:names.title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{"text_color":""},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"background_color":"{{ settings.color_palette.background }}","padding-block-start":40,"padding-block-end":80}},"custom_liquid_7qzLci":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- ============================================================\n     RETURN POLICY SECTION — nostringscouture\n     Paste this whole block into your page template, inside <body>.\n     It is self-contained: styles are scoped under .nsc-return so\n     they won't leak onto the rest of your site.\n     ============================================================ -->\n<section class=\"nsc-return\" id=\"return-policy\" aria-labelledby=\"nsc-return-title\">\n  <div class=\"nsc-return__container\">\n\n    <header class=\"nsc-return__header\">\n      <p class=\"nsc-return__eyebrow\">Legal<\/p>\n      <h1 id=\"nsc-return-title\" class=\"nsc-return__title\">Return Policy<\/h1>\n      <p class=\"nsc-return__intro\">\n        What to expect when returning a Product, extending your rental, and getting your Security Deposit back.\n      <\/p>\n    <\/header>\n\n    <article class=\"nsc-return__body\">\n\n      <section class=\"nsc-return__section\">\n        <h2>Returning Your Product<\/h2>\n        <p>Once an order is delivered to you in accordance with our Terms of Use, you agree to return the Product(s) to us on the last day of the Rental Period.<\/p>\n        <p class=\"nsc-return__callout\">Failure to timely return a Product is a violation of our Terms of Use, and it will invite a daily penalty of 20% of the retail value of the Product for the initial 3 days. We may charge this penalty by deducting the amount from your Security Deposit, and\/or take other legal action as appropriate.<\/p>\n      <\/section>\n\n      <section class=\"nsc-return__section\">\n        <h2>Extending Your Rental<\/h2>\n        <p>You may extend your order for a Product by reaching out to us prior to the expiry of the Rental Period. Extensions are subject to:<\/p>\n        <ul>\n          <li>Availability of the Product, i.e. it not being reserved for other orders during the extension window; and<\/li>\n          <li>Pre-payment of the additional Rental Fee applicable to the Product for the period of the extension.<\/li>\n        <\/ul>\n      <\/section>\n\n      <section class=\"nsc-return__section\">\n        <h2>Getting Your Security Deposit Back<\/h2>\n        <p>If you comply with our Return Policy, and once the final quality check is performed on the Product you rented, and no damage is found:<\/p>\n        <ul>\n          <li>Your Security Deposit will be refunded within <strong>10 working days<\/strong> after the Product is returned to us; or<\/li>\n          <li>At the time of pickup, for Cash on Delivery orders.<\/li>\n        <\/ul>\n      <\/section>\n\n    <\/article>\n  <\/div>\n<\/section>\n\n<style>\n  \/* ---- nostringscouture \/ return policy — scoped styles ---- *\/\n  .nsc-return {\n    --nsc-ink: #241f1c;\n    --nsc-ink-soft: #5c534c;\n    --nsc-paper: #faf7f2;\n    --nsc-line: #e3dcd1;\n    --nsc-accent: #8a3b2b;\n    --nsc-serif: Georgia, \"Iowan Old Style\", \"Palatino Linotype\", serif;\n    --nsc-sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\n\n    display: block;\n    width: 100%;\n    max-width: none;\n    box-sizing: border-box;\n    background: var(--nsc-paper);\n    color: var(--nsc-ink);\n    font-family: var(--nsc-sans);\n    line-height: 1.65;\n    padding: 4rem clamp(1.5rem, 5vw, 4rem) 6rem;\n  }\n\n  .nsc-return *,\n  .nsc-return *::before,\n  .nsc-return *::after {\n    box-sizing: border-box;\n  }\n\n  .nsc-return__container {\n    width: 100%;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .nsc-return__header {\n    border-bottom: 1px solid var(--nsc-line);\n    padding-bottom: 2rem;\n    margin-bottom: 2.5rem;\n  }\n\n  .nsc-return__eyebrow {\n    font-size: 0.8rem;\n    letter-spacing: 0.08em;\n    color: var(--nsc-accent);\n    margin: 0 0 0.6rem;\n  }\n\n  .nsc-return__title {\n    font-family: var(--nsc-serif);\n    font-size: clamp(2rem, 5vw, 2.75rem);\n    font-weight: 400;\n    margin: 0 0 0.75rem;\n    color: var(--nsc-ink);\n  }\n\n  .nsc-return__intro {\n    font-size: 1.05rem;\n    color: var(--nsc-ink-soft);\n    max-width: 70ch;\n    margin: 0;\n  }\n\n  .nsc-return__section {\n    padding: 2.25rem 0;\n    border-bottom: 1px solid var(--nsc-line);\n  }\n\n  .nsc-return__section:last-child { border-bottom: none; }\n\n  .nsc-return__section h2 {\n    font-family: var(--nsc-serif);\n    font-weight: 400;\n    font-size: 1.4rem;\n    margin: 0 0 1rem;\n    color: var(--nsc-ink);\n  }\n\n  .nsc-return__section p { margin: 0 0 1rem; color: var(--nsc-ink); }\n  .nsc-return__section p:last-child { margin-bottom: 0; }\n\n  .nsc-return__section ul {\n    margin: 0 0 1rem;\n    padding-left: 1.25rem;\n  }\n\n  .nsc-return__section li { margin-bottom: 0.5rem; }\n\n  .nsc-return__callout {\n    font-size: 0.92rem;\n    background: #fff;\n    border: 1px solid var(--nsc-line);\n    border-left: 3px solid var(--nsc-accent);\n    padding: 1rem 1.25rem;\n    border-radius: 2px;\n  }\n\n  @media (max-width: 640px) {\n    .nsc-return { padding: 2.5rem 1.25rem 4rem; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .nsc-return * { scroll-behavior: auto !important; }\n  }\n<\/style>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_7qzLci"]}