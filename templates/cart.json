{"sections":{"cart-section":{"type":"main-cart","blocks":{"custom_liquid_WL4DNn":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"rental-consent-cart\" class=\"rcc\">\n  <div class=\"rcc__checks\">\n\n    <div class=\"rcc__check-row\">\n      <input\n        type=\"checkbox\"\n        id=\"rcc-terms\"\n        class=\"rcc__checkbox\"\n      >\n      <label for=\"rcc-terms\" class=\"rcc__label\">\n        I AGREE WITH THE TERMS AND CONDITIONS\n      <\/label>\n    <\/div>\n\n    <div class=\"rcc__check-row\">\n      <input\n        type=\"checkbox\"\n        id=\"rcc-deposit\"\n        class=\"rcc__checkbox\"\n        aria-haspopup=\"dialog\"\n        aria-controls=\"rcc-deposit-modal\"\n      >\n      <label for=\"rcc-deposit\" class=\"rcc__label\">\n        REFUNDABLE DEPOSIT TERMS &amp; CONDITIONS\n        (ONLY FOR RENTAL ORDERS)\n      <\/label>\n    <\/div>\n\n  <\/div>\n\n  <p\n    class=\"rcc__error\"\n    id=\"rcc-error\"\n    role=\"alert\"\n    hidden\n  >\n    Please accept both terms and conditions before proceeding to checkout.\n  <\/p>\n\n  <!-- Refundable deposit modal -->\n  <div\n    class=\"rcc__modal\"\n    id=\"rcc-deposit-modal\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"rcc-modal-title\"\n    aria-describedby=\"rcc-modal-description\"\n    hidden\n  >\n    <div class=\"rcc__modal-panel\">\n\n      <button\n        type=\"button\"\n        class=\"rcc__close\"\n        aria-label=\"Close refundable deposit terms\"\n        data-rcc-close\n      >\n        &times;\n      <\/button>\n\n      <div class=\"rcc__modal-content\">\n\n        <h2 id=\"rcc-modal-title\">\n          REFUNDABLE DEPOSIT TERMS\n          <span class=\"rcc__modal-subtitle\">\n            For Rental Orders Only\n          <\/span>\n        <\/h2>\n\n        <!-- Formatted refundable deposit policy -->\n        <div\n          class=\"rcc__policy\"\n          id=\"rcc-modal-description\"\n        >\n\n          <div class=\"rcc__policy-section\">\n            <h3>1. How It Works<\/h3>\n\n            <p>\n              Every rental order includes a\n              <strong>100% refundable security deposit<\/strong>,\n              separate from the rental fee. The deposit amount is\n              equal to the rental value of your selected outfit.\n            <\/p>\n\n            <p>\n              <strong>Example:<\/strong> For an outfit with a rental\n              value of ₹25,000, the refundable security deposit\n              will be ₹25,000.\n            <\/p>\n          <\/div>\n\n          <div class=\"rcc__policy-section\">\n            <h3>2. When Is the Deposit Collected?<\/h3>\n\n            <p>\n              Our team will contact you to collect the security\n              deposit <strong>10 days before your scheduled\n              delivery date.<\/strong>\n            <\/p>\n          <\/div>\n\n          <div class=\"rcc__policy-section\">\n            <h3>3. When Is the Deposit Refunded?<\/h3>\n\n            <p>\n              Once we receive the outfit back, your security\n              deposit will be refunded within\n              <strong>15–17 working days.<\/strong>\n            <\/p>\n          <\/div>\n\n          <div class=\"rcc__policy-section\">\n            <h3>4. When Is the Deposit Used?<\/h3>\n\n            <p>\n              The security deposit will be used only in cases of\n              <strong>irreparable damage to the garment.<\/strong>\n            <\/p>\n          <\/div>\n\n          <div class=\"rcc__policy-section rcc__policy-notice\">\n            <h3>5. Important Notice<\/h3>\n\n            <p>\n              Please ensure that the security deposit is paid at\n              least <strong>10 days before your scheduled delivery\n              date.<\/strong> We will be unable to process your\n              rental order if the deposit is not paid within\n              this timeframe.\n            <\/p>\n          <\/div>\n\n          <div class=\"rcc__policy-section rcc__policy-help\">\n            <h3>6. Need Help?<\/h3>\n\n            <p>\n              For any questions or assistance, chat with us on\n              WhatsApp or get in touch through our Contact page.\n            <\/p>\n          <\/div>\n\n        <\/div>\n\n        <div class=\"rcc__modal-actions\">\n\n          <button\n            type=\"button\"\n            class=\"rcc__button rcc__button--secondary\"\n            data-rcc-close\n          >\n            CANCEL\n          <\/button>\n\n          <button\n            type=\"button\"\n            class=\"rcc__button rcc__button--primary\"\n            id=\"rcc-accept-deposit\"\n          >\n            I AGREE\n          <\/button>\n\n        <\/div>\n\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  \/* =========================================\n     RENTAL CONSENT COMPONENT\n  ========================================= *\/\n\n  #rental-consent-cart {\n    --rcc-black: #111111;\n    --rcc-border: #dedbd5;\n    --rcc-text: #171717;\n\n    width: 100%;\n    color: var(--rcc-text);\n    font-family: inherit;\n    box-sizing: border-box;\n  }\n\n  #rental-consent-cart *,\n  #rental-consent-cart *::before,\n  #rental-consent-cart *::after {\n    box-sizing: border-box;\n  }\n\n  \/* =========================================\n     CHECKBOXES\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__checks {\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    padding: 12px 0 8px;\n  }\n\n  #rental-consent-cart .rcc__check-row {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    width: 100%;\n  }\n\n  #rental-consent-cart .rcc__checkbox {\n    appearance: auto;\n    -webkit-appearance: checkbox;\n    accent-color: var(--rcc-black);\n\n    width: 18px;\n    height: 18px;\n    min-width: 18px;\n\n    margin: 2px 0 0;\n    padding: 0;\n    cursor: pointer;\n  }\n\n  #rental-consent-cart .rcc__label {\n    display: block;\n    flex: 1;\n\n    margin: 0;\n\n    font-size: 11px;\n    line-height: 1.8;\n    letter-spacing: 4px;\n    font-weight: 400;\n    text-transform: uppercase;\n\n    cursor: pointer;\n    overflow-wrap: anywhere;\n  }\n\n  \/* =========================================\n     VALIDATION MESSAGE\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__error {\n    color: #b42318;\n    font-size: 13px;\n    line-height: 1.5;\n    margin: 14px 0;\n  }\n\n  #rental-consent-cart .rcc__error[hidden],\n  #rental-consent-cart .rcc__modal[hidden] {\n    display: none !important;\n  }\n\n  \/* =========================================\n     MODAL BACKDROP\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__modal {\n    position: fixed;\n    inset: 0;\n    z-index: 999999;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 24px;\n\n    background: rgba(0, 0, 0, 0.48);\n\n    overflow-y: auto;\n    overscroll-behavior: contain;\n  }\n\n  \/* =========================================\n     MODAL PANEL\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__modal-panel {\n    position: relative;\n\n    width: min(100%, 900px);\n    max-height: min(88vh, 850px);\n\n    overflow-y: auto;\n\n    background: #ffffff;\n    color: #111111;\n\n    box-shadow: 0 12px 45px rgba(0, 0, 0, 0.15);\n  }\n\n  #rental-consent-cart .rcc__modal-content {\n    padding: 44px 48px 38px;\n  }\n\n  \/* =========================================\n     CLOSE BUTTON\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__close {\n    position: absolute;\n    z-index: 2;\n\n    top: 12px;\n    right: 16px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 36px;\n    height: 36px;\n\n    border: 0;\n    background: transparent;\n    color: #111111;\n\n    font-family: inherit;\n    font-size: 32px;\n    line-height: 1;\n    font-weight: 300;\n\n    cursor: pointer;\n  }\n\n  \/* =========================================\n     MODAL HEADING\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__modal-content h2 {\n    max-width: 700px;\n\n    margin: 0 auto 34px;\n\n    color: #111111;\n\n    font-family: inherit;\n    font-size: 25px;\n    line-height: 1.45;\n    font-weight: 500;\n\n    text-align: center;\n    text-transform: uppercase;\n    letter-spacing: 0;\n  }\n\n  #rental-consent-cart .rcc__modal-subtitle {\n    display: block;\n\n    margin-top: 5px;\n\n    font-size: 12px;\n    line-height: 1.6;\n    font-weight: 400;\n\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  \/* =========================================\n     POLICY CONTENT\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__policy {\n    font-size: 16px;\n    line-height: 1.75;\n    font-weight: 400;\n  }\n\n  #rental-consent-cart .rcc__policy-section {\n    margin: 0 0 26px;\n    padding: 0 0 22px;\n    border-bottom: 1px solid #e9e6e1;\n  }\n\n  #rental-consent-cart .rcc__policy-section:last-child {\n    margin-bottom: 0;\n    padding-bottom: 0;\n    border-bottom: 0;\n  }\n\n  #rental-consent-cart .rcc__policy-section h3 {\n    margin: 0 0 10px;\n\n    color: #111111;\n\n    font-family: inherit;\n    font-size: 17px;\n    line-height: 1.5;\n    font-weight: 600;\n\n    letter-spacing: 0;\n    text-transform: none;\n  }\n\n  #rental-consent-cart .rcc__policy-section p {\n    margin: 0 0 12px;\n  }\n\n  #rental-consent-cart .rcc__policy-section p:last-child {\n    margin-bottom: 0;\n  }\n\n  #rental-consent-cart .rcc__policy strong {\n    color: #111111;\n    font-weight: 600;\n  }\n\n  #rental-consent-cart .rcc__policy ul {\n    padding-left: 24px;\n    margin: -6px 0 24px;\n  }\n\n  #rental-consent-cart .rcc__policy li {\n    padding-left: 4px;\n    margin-bottom: 8px;\n  }\n\n  #rental-consent-cart .rcc__policy a {\n    color: inherit;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  \/* Important notice *\/\n  #rental-consent-cart .rcc__policy-notice {\n    padding: 20px;\n    border: 1px solid #dedbd5;\n    background: #faf9f7;\n  }\n\n  #rental-consent-cart .rcc__policy-notice h3 {\n    margin-bottom: 8px;\n  }\n\n  \/* =========================================\n     MODAL ACTION BUTTONS\n  ========================================= *\/\n\n  #rental-consent-cart .rcc__modal-actions {\n    display: flex;\n    justify-content: flex-end;\n    gap: 12px;\n\n    margin-top: 28px;\n    padding-top: 22px;\n\n    border-top: 1px solid var(--rcc-border);\n  }\n\n  #rental-consent-cart .rcc__button {\n    min-height: 48px;\n    padding: 14px 24px;\n\n    border: 1px solid #111111;\n    border-radius: 0;\n\n    font-family: inherit;\n    font-size: 11px;\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 2px;\n\n    cursor: pointer;\n    transition: opacity 0.2s ease;\n  }\n\n  #rental-consent-cart .rcc__button--primary {\n    background: #111111;\n    color: #ffffff;\n  }\n\n  #rental-consent-cart .rcc__button--secondary {\n    background: #ffffff;\n    color: #111111;\n  }\n\n  #rental-consent-cart .rcc__button:hover {\n    opacity: 0.82;\n  }\n\n  #rental-consent-cart .rcc__button:focus-visible,\n  #rental-consent-cart .rcc__close:focus-visible {\n    outline: 2px solid #111111;\n    outline-offset: 3px;\n  }\n\n  \/* =========================================\n     CHECKOUT LOCK STYLES\n  ========================================= *\/\n\n  body.rcc-checkout-locked\n  button[data-rcc-checkout].rcc-checkout-disabled,\n  body.rcc-checkout-locked\n  input[data-rcc-checkout].rcc-checkout-disabled {\n    opacity: 0.45 !important;\n    cursor: not-allowed !important;\n  }\n\n  body.rcc-checkout-locked\n  a[data-rcc-checkout].rcc-checkout-disabled {\n    opacity: 0.45 !important;\n    cursor: not-allowed !important;\n  }\n\n  \/* =========================================\n     DESKTOP\n  ========================================= *\/\n\n  @media (min-width: 900px) {\n    #rental-consent-cart .rcc__modal-panel {\n      width: min(100%, 900px);\n    }\n\n    #rental-consent-cart .rcc__modal-content {\n      padding: 48px 60px;\n    }\n  }\n\n  \/* =========================================\n     MOBILE\n  ========================================= *\/\n\n  @media (max-width: 749px) {\n    #rental-consent-cart .rcc__checks {\n      gap: 22px;\n    }\n\n    #rental-consent-cart .rcc__check-row {\n      gap: 12px;\n    }\n\n    #rental-consent-cart .rcc__label {\n      font-size: 10px;\n      letter-spacing: 2px;\n      line-height: 1.8;\n    }\n\n    #rental-consent-cart .rcc__modal {\n      padding: 12px;\n      align-items: center;\n    }\n\n    #rental-consent-cart .rcc__modal-panel {\n      width: 100%;\n      max-height: 90dvh;\n    }\n\n    #rental-consent-cart .rcc__modal-content {\n      padding: 48px 22px 24px;\n    }\n\n    #rental-consent-cart .rcc__modal-content h2 {\n      font-size: 19px;\n      line-height: 1.5;\n      margin-bottom: 26px;\n    }\n\n    #rental-consent-cart .rcc__modal-subtitle {\n      font-size: 10px;\n      letter-spacing: 1.5px;\n    }\n\n    #rental-consent-cart .rcc__policy {\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    #rental-consent-cart .rcc__policy-section {\n      margin-bottom: 22px;\n      padding-bottom: 18px;\n    }\n\n    #rental-consent-cart .rcc__policy-section h3 {\n      font-size: 15px;\n      line-height: 1.5;\n      margin-bottom: 8px;\n    }\n\n    #rental-consent-cart .rcc__policy-section p {\n      margin-bottom: 12px;\n    }\n\n    #rental-consent-cart .rcc__policy-notice {\n      padding: 15px;\n    }\n\n    #rental-consent-cart .rcc__modal-actions {\n      flex-direction: column-reverse;\n      gap: 10px;\n    }\n\n    #rental-consent-cart .rcc__button {\n      width: 100%;\n      min-height: 48px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #rental-consent-cart .rcc__button {\n      transition: none;\n    }\n  }\n<\/style>\n\n<script>\n(function () {\n  'use strict';\n\n  var root = document.getElementById('rental-consent-cart');\n\n  if (!root || root.dataset.rccInitialized === 'true') return;\n\n  root.dataset.rccInitialized = 'true';\n\n  var terms = root.querySelector('#rcc-terms');\n  var deposit = root.querySelector('#rcc-deposit');\n  var modal = root.querySelector('#rcc-deposit-modal');\n  var acceptDeposit = root.querySelector('#rcc-accept-deposit');\n  var error = root.querySelector('#rcc-error');\n  var previousFocus = null;\n\n  \/*\n   * Find standard Shopify checkout controls.\n   * Also supports checkout buttons rendered later by Horizon.\n   *\/\n  function getCheckoutControls() {\n    var selectors = [\n      'button[name=\"checkout\"]',\n      'input[name=\"checkout\"]',\n      '[data-testid=\"checkout-button\"]',\n      'a[href=\"\/checkout\"]',\n      'a[href^=\"\/checkout?\"]'\n    ].join(',');\n\n    return Array.from(document.querySelectorAll(selectors)).filter(\n      function (element) {\n        return !root.contains(element);\n      }\n    );\n  }\n\n  function hasConsent() {\n    return terms.checked && deposit.checked;\n  }\n\n  \/*\n   * Disable checkout until both consent boxes are accepted.\n   *\/\n  function updateCheckout() {\n    var unlocked = hasConsent();\n\n    document.body.classList.toggle(\n      'rcc-checkout-locked',\n      !unlocked\n    );\n\n    getCheckoutControls().forEach(function (control) {\n      var isAnchor = control.tagName === 'A';\n\n      \/*\n       * Preserve the original disabled state of theme buttons.\n       *\/\n      if (!control.hasAttribute('data-rcc-original-disabled')) {\n        control.dataset.rccOriginalDisabled =\n          control.disabled ? 'true' : 'false';\n      }\n\n      var originallyDisabled =\n        control.dataset.rccOriginalDisabled === 'true';\n\n      control.dataset.rccCheckout = 'true';\n\n      control.classList.toggle(\n        'rcc-checkout-disabled',\n        !unlocked\n      );\n\n      control.setAttribute(\n        'aria-disabled',\n        String(!unlocked || originallyDisabled)\n      );\n\n      if (isAnchor) {\n        if (!unlocked) {\n          if (!control.hasAttribute('data-rcc-original-tabindex')) {\n            control.dataset.rccOriginalTabindex =\n              control.getAttribute('tabindex') === null\n                ? '__none__'\n                : control.getAttribute('tabindex');\n          }\n\n          control.setAttribute('tabindex', '-1');\n\n        } else if (\n          control.dataset.rccOriginalTabindex !== undefined\n        ) {\n          if (\n            control.dataset.rccOriginalTabindex === '__none__'\n          ) {\n            control.removeAttribute('tabindex');\n          } else {\n            control.setAttribute(\n              'tabindex',\n              control.dataset.rccOriginalTabindex\n            );\n          }\n\n          delete control.dataset.rccOriginalTabindex;\n        }\n\n      } else {\n        control.disabled = !unlocked || originallyDisabled;\n      }\n    });\n  }\n\n  \/* =========================================\n     OPEN AND CLOSE MODAL\n  ========================================= *\/\n\n  function openModal() {\n    previousFocus = document.activeElement;\n\n    modal.hidden = false;\n    document.body.style.overflow = 'hidden';\n\n    window.requestAnimationFrame(function () {\n      acceptDeposit.focus();\n    });\n  }\n\n  function closeModal() {\n    modal.hidden = true;\n    document.body.style.overflow = '';\n\n    if (\n      previousFocus &&\n      typeof previousFocus.focus === 'function'\n    ) {\n      previousFocus.focus();\n    }\n  }\n\n  \/* =========================================\n     GENERAL TERMS CHECKBOX\n  ========================================= *\/\n\n  terms.addEventListener('change', function () {\n    error.hidden = true;\n    updateCheckout();\n  });\n\n  \/* =========================================\n     DEPOSIT TERMS CHECKBOX\n  ========================================= *\/\n\n  deposit.addEventListener('change', function () {\n    error.hidden = true;\n\n    \/*\n     * Require the customer to open the policy\n     * and explicitly click I AGREE.\n     *\/\n    if (deposit.checked) {\n      deposit.checked = false;\n\n      updateCheckout();\n      openModal();\n\n    } else {\n      updateCheckout();\n    }\n  });\n\n  \/* =========================================\n     ACCEPT DEPOSIT TERMS\n  ========================================= *\/\n\n  acceptDeposit.addEventListener('click', function () {\n    deposit.checked = true;\n\n    error.hidden = true;\n\n    closeModal();\n    updateCheckout();\n  });\n\n  \/* =========================================\n     CLOSE BUTTONS\n  ========================================= *\/\n\n  root.querySelectorAll('[data-rcc-close]').forEach(\n    function (button) {\n      button.addEventListener('click', closeModal);\n    }\n  );\n\n  \/* Close when clicking the backdrop *\/\n  modal.addEventListener('click', function (event) {\n    if (event.target === modal) {\n      closeModal();\n    }\n  });\n\n  \/* =========================================\n     KEYBOARD ACCESSIBILITY\n  ========================================= *\/\n\n  document.addEventListener('keydown', function (event) {\n    if (modal.hidden) return;\n\n    if (event.key === 'Escape') {\n      closeModal();\n    }\n\n    if (event.key === 'Tab') {\n      var focusable = Array.from(\n        modal.querySelectorAll(\n          'button:not([disabled]), a[href], input:not([disabled])'\n        )\n      );\n\n      if (!focusable.length) return;\n\n      var first = focusable[0];\n      var last = focusable[focusable.length - 1];\n\n      if (\n        event.shiftKey &&\n        document.activeElement === first\n      ) {\n        event.preventDefault();\n        last.focus();\n\n      } else if (\n        !event.shiftKey &&\n        document.activeElement === last\n      ) {\n        event.preventDefault();\n        first.focus();\n      }\n    }\n  });\n\n  \/* =========================================\n     BLOCK CHECKOUT CLICKS WITHOUT CONSENT\n  ========================================= *\/\n\n  document.addEventListener('click', function (event) {\n    var target = event.target;\n\n    if (!target || typeof target.closest !== 'function') {\n      return;\n    }\n\n    var control = target.closest(\n      'button[name=\"checkout\"], ' +\n      'input[name=\"checkout\"], ' +\n      '[data-testid=\"checkout-button\"], ' +\n      'a[href=\"\/checkout\"], ' +\n      'a[href^=\"\/checkout?\"]'\n    );\n\n    if (!control || root.contains(control)) return;\n\n    if (!hasConsent()) {\n      event.preventDefault();\n      event.stopImmediatePropagation();\n\n      error.hidden = false;\n\n      root.scrollIntoView({\n        behavior: 'smooth',\n        block: 'center'\n      });\n\n      if (!terms.checked) {\n        terms.focus();\n      } else {\n        deposit.focus();\n      }\n\n      updateCheckout();\n    }\n\n  }, true);\n\n  \/* =========================================\n     BLOCK CART FORM SUBMISSION WITHOUT CONSENT\n  ========================================= *\/\n\n  document.addEventListener('submit', function (event) {\n    var form = event.target;\n\n    if (!(form instanceof HTMLFormElement)) return;\n\n    var action = form.getAttribute('action') || '';\n\n    var isCartForm =\n      \/(^|\\\/)cart(?:\\.js)?(?:[?#]|$)\/.test(action) ||\n      !!form.querySelector(\n        'button[name=\"checkout\"], input[name=\"checkout\"]'\n      );\n\n    var submitter = event.submitter;\n\n    var isCheckoutSubmit =\n      submitter &&\n      (\n        submitter.name === 'checkout' ||\n        submitter.matches('[data-testid=\"checkout-button\"]')\n      );\n\n    if (\n      (isCartForm || isCheckoutSubmit) &&\n      !hasConsent()\n    ) {\n      event.preventDefault();\n      event.stopImmediatePropagation();\n\n      error.hidden = false;\n\n      root.scrollIntoView({\n        behavior: 'smooth',\n        block: 'center'\n      });\n\n      updateCheckout();\n    }\n\n  }, true);\n\n  \/* =========================================\n     HORIZON DYNAMIC CART SUPPORT\n  ========================================= *\/\n\n  updateCheckout();\n\n  var observer = new MutationObserver(function () {\n    updateCheckout();\n  });\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n})();\n<\/script>"},"blocks":{}},"cart-page-title":{"type":"_cart-title","static":true,"settings":{"title":"Cart","show_count":true,"type_preset":"h4","alignment":"left","text_color":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"cart-page-items":{"type":"_cart-products","static":true,"settings":{"gap":24,"image_ratio":"square","dividers":true,"vendor":false,"input_style":"default","input_background_color":"{{ settings.color_palette.background }}","input_text_color":"{{ settings.color_palette.foreground }}","input_border_color":"{{ settings.color_palette.foreground }}","border_width":1,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"cart-page-summary":{"type":"_cart-summary","static":true,"settings":{"extend_summary":true,"background_color":"","text_color":"","border":"solid","border_width":1,"border_opacity":100,"border_color":"{{ settings.color_palette.color2 }}","border_radius":0},"blocks":{}}},"block_order":["custom_liquid_WL4DNn"],"settings":{"section_width":"page-width","background_color":"{{ settings.color_palette.background }}","text_color":"","padding-block-start":32,"padding-block-end":0}},"product_list_MxPXQq":{"type":"product-list","blocks":{"static-header":{"type":"_product-list-content","name":"t:names.header","static":true,"settings":{"content_direction":"row","vertica