{
  "sections": {
    "main": {
      "type": "product-editorial",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "one",
            "image_gap": 0,
            "large_first_image": false,
            "icons_style": "arrow",
            "slideshow_controls_style": "counter",
            "slideshow_mobile_controls_style": "counter",
            "thumbnail_position": "left",
            "thumbnail_width": 57,
            "thumbnail_radius": 0,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": false,
            "media_fit": "cover",
            "media_radius": 0,
            "extend_media": true,
            "zoom": true,
            "video_loop": false,
            "hide_variants": true,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 12,
            "sticky_details_desktop": true,
            "background_media": "none",
            "background_color": "",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "title": {
              "type": "text",
              "name": "Product title",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "name": "Price",
              "settings": {},
              "blocks": {}
            },
            "variant-picker": {
              "type": "variant-picker",
              "name": "Variant picker",
              "settings": {},
              "blocks": {}
            },
            "buy-buttons": {
              "type": "buy-buttons",
              "name": "Buy buttons",
              "settings": {},
              "blocks": {}
            },
            "description": {
              "type": "product-description",
              "name": "Description",
              "settings": {},
              "blocks": {}
            }
          },
          "block_order": ["title", "price", "variant-picker", "buy-buttons", "description"]
        }
      },
      "block_order": ["media-gallery", "product-details"],
      "settings": {
        "eyebrow": "The edit",
        "collection_label": "The edit",
        "show_breadcrumbs": true,
        "available_label": "Available to rent",
        "sold_out_label": "Currently unavailable",
        "designer_metafield_namespace": "custom",
        "designer_metafield_key": "designer_name",
        "show_deposit_note": true,
        "deposit_note": "<p>Refundable security deposit collected separately before delivery.</p>",
        "show_trust_row": true,
        "trust_label": "Rental benefits",
        "trust_one": "Pan-India delivery",
        "trust_two": "Quality checked",
        "trust_three": "Easy returns",
        "background_color": "#F7F1E6",
        "surface_color": "#EFE5D4",
        "ink_color": "#2A1015",
        "accent_color": "#B8935A",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "settings": {
        "product_list": [],
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_width": "full",
        "image_fit": "cover",
        "border": "none",
        "border_width": 0,
        "border_opacity": 100,
        "border_radius": 0,
        "padding-block-start": 64,
        "padding-block-end": 64,
        "padding-inline-start": 0,
        "padding-inline-end": 0
      }
    }
  },
  "order": ["main", "product-recommendations"]
}
