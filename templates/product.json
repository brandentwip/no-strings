            "custom_liquid_7DJgKJ": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"custom-price-wrapper\">\n  <div class=\"custom-price-display\">\n    <div class=\"price-item\">\n      <span class=\"price-label\">ONE-TIME PRICE</span>\n      <span class=\"price-value\" id=\"one-time-price\">\n        {{ product.selected_or_first_available_variant.price | money }}\n      </span>\n    </div>\n\n    <span class=\"price-divider\" aria-hidden=\"true\">|</span>\n\n    <div class=\"price-item\">\n      <span class=\"price-label\">DESIGNER PRICE</span>\n      <span class=\"price-value designer-price\" id=\"designer-price\">\n        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}\n          {{ product.selected_or_first_available_variant.compare_at_price | money }}\n        {% else %}\n          —\n        {% endif %}\n      </span>\n    </div>\n  </div>\n\n  <span class=\"custom-tax-label\">Tax Included</span>\n</div>\n\n<style>\n  /* Main wrapper */\n  .custom-price-wrapper {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    width: 100%;\n    max-width: 100%;\n    box-sizing: border-box;\n    margin: 10px 0;\n    font-family: inherit;\n    color: #5f5a53;\n  }\n\n  /* Price row */\n  .custom-price-wrapper .custom-price-display {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    flex-wrap: wrap;\n    gap: 10px 14px;\n    width: 100%;\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n\n  /* Individual price groups */\n  .custom-price-wrapper .price-item {\n    display: flex;\n    align-items: baseline;\n    flex-wrap: wrap;\n    gap: 6px 9px;\n    min-width: 0;\n    max-width: 100%;\n  }\n\n  /* Price labels */\n  .custom-price-wrapper .price-label {\n    font-size: 13px;\n    line-height: 1.4;\n    font-weight: 400;\n    letter-spacing: 0.4px;\n    color: #77716a;\n  }\n\n  /* Price values */\n  .custom-price-wrapper .price-value {\n    font-size: 18px;\n    line-height: 1.4;\n    font-weight: 400;\n    color: #222;\n    overflow-wrap: anywhere;\n  }\n\n  .custom-price-wrapper .designer-price {\n    color: #222;\n  }\n\n  /* Divider */\n  .custom-price-wrapper .price-divider {\n    flex-shrink: 0;\n    font-size: 18px;\n    line-height: 1;\n    color: #8b867f;\n  }\n\n  /* Tax label */\n  .custom-price-wrapper .custom-tax-label {\n    display: block;\n    margin-top: 5px;\n    font-size: 12px;\n    line-height: 1.5;\n    font-weight: 400;\n    color: #77716a;\n  }\n\n  /* Tablet */\n  @media screen and (min-width: 750px) and (max-width: 1024px) {\n    .custom-price-wrapper .custom-price-display {\n      gap: 10px 12px;\n    }\n\n    .custom-price-wrapper .price-item {\n      gap: 5px 7px;\n    }\n\n    .custom-price-wrapper .price-label {\n      font-size: 12px;\n    }\n\n    .custom-price-wrapper .price-value {\n      font-size: 16px;\n    }\n  }\n\n  /* Mobile */\n  @media screen and (max-width: 749px) {\n    .custom-price-wrapper {\n      margin: 8px 0;\n    }\n\n    .custom-price-wrapper .custom-price-display {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 8px 10px;\n    }\n\n    .custom-price-wrapper .price-item {\n      flex-wrap: wrap;\n      align-items: baseline;\n      gap: 4px 6px;\n    }\n\n    .custom-price-wrapper .price-label {\n      font-size: 10px;\n      line-height: 1.4;\n      letter-spacing: 0.2px;\n    }\n\n    .custom-price-wrapper .price-value {\n      font-size: 15px;\n      line-height: 1.4;\n    }\n\n    .custom-price-wrapper .price-divider {\n      font-size: 14px;\n    }\n\n    .custom-price-wrapper .custom-tax-label {\n      margin-top: 4px;\n      font-size: 11px;\n    }\n  }\n\n  /* Very small mobile screens */\n  @media screen and (max-width: 380px) {\n    .custom-price-wrapper .custom-price-display {\n      gap: 8px;\n    }\n\n    .custom-price-wrapper .price-item {\n      gap: 3px 5px;\n    }\n\n    .custom-price-wrapper .price-label {\n      font-size: 9px;\n      letter-spacing: 0;\n    }\n\n    .custom-price-wrapper .price-value {\n      font-size: 14px;\n    }\n\n    .custom-price-wrapper .price-divider {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initCustomPriceDisplay() {\n      const wrappers = document.querySelectorAll('.custom-price-wrapper');\n\n      wrappers.forEach(function (wrapper) {\n        if (wrapper.dataset.priceInitialized === 'true') return;\n        wrapper.dataset.priceInitialized = 'true';\n\n        const oneTimePrice = wrapper.querySelector('#one-time-price');\n        const designerPrice = wrapper.querySelector('#designer-price');\n\n        function formatMoney(cents) {\n          return new Intl.NumberFormat('en-IN', {\n            style: 'currency',\n            currency: 'INR',\n            maximumFractionDigits: 0\n          }).format(cents / 100);\n        }\n\n        function updateCustomPrices(variant) {\n          if (!variant) return;\n\n          if (oneTimePrice && typeof variant.price === 'number') {\n            oneTimePrice.textContent = formatMoney(variant.price);\n          }\n\n          if (designerPrice) {\n            if (\n              typeof variant.compare_at_price === 'number' &&\n              variant.compare_at_price > variant.price\n            ) {\n              designerPrice.textContent = formatMoney(\n                variant.compare_at_price\n              );\n            } else {\n              designerPrice.textContent = '—';\n            }\n          }\n        }\n\n        document.addEventListener('variant:change', function (event) {\n          const variant = event.detail && event.detail.variant;\n\n          if (variant) {\n            updateCustomPrices(variant);\n          }\n        });\n\n        wrapper.addEventListener('change', function (event) {\n          const target = event.target;\n\n          if (\n            !target.matches('select[name=\"id\"], input[name=\"id\"]')\n          ) {\n            return;\n          }\n\n          const variantId = target.value;\n\n          if (!variantId) return;\n\n          fetch(\n            window.Shopify.routes.root +\n            'variants/' +\n            encodeURIComponent(variantId) +\n            '.js'\n          )\n            .then(function (response) {\n              if (!response.ok) {\n                throw new Error('Unable to fetch variant details');\n              }\n\n              return response.json();\n            })\n            .then(function (variant) {\n              updateCustomPrices(variant);\n            })\n            .catch(function (error) {\n              console.error('Variant price update error:', error);\n            });\n        });\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener(\n        'DOMContentLoaded',\n        initCustomPriceDisplay\n      );\n    } else {\n      initCustomPriceDisplay();\n    }\n  })();\n</script>"
              },
