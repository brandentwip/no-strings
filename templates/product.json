            "custom_liquid_j6yXgi": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% for option in product.options_with_values %}\n  {% if option.name == 'Duration' %}\n    <div class=\"duration-option\" data-option-position=\"{{ option.position }}\">\n      <label class=\"duration-option__label\">\n        {{ option.name | upcase }}\n      </label>\n\n      <div class=\"duration-option__values\">\n        {% for value in option.values %}\n          <button\n            type=\"button\"\n            class=\"duration-option__value {% if option.selected_value == value %}is-selected{% endif %}\"\n            data-option-position=\"{{ option.position }}\"\n            data-option-value=\"{{ value | escape }}\"\n          >\n            {{ value }}\n          </button>\n        {% endfor %}\n      </div>\n    </div>\n  {% endif %}\n{% endfor %}\n\n<style>\n  .duration-option {\n    margin: 20px 0;\n  }\n\n  .duration-option__label {\n    display: block;\n    margin-bottom: 14px;\n    font-size: 13px;\n    font-weight: 400;\n    letter-spacing: 0.08em;\n    color: #766b67;\n  }\n\n  .duration-option__values {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .duration-option__value {\n    appearance: none;\n    border: 1px solid #321019;\n    background: transparent;\n    color: #321019;\n    border-radius: 999px;\n    padding: 14px 20px;\n    min-width: 75px;\n    font-family: inherit;\n    font-size: 14px;\n    line-height: 1;\n    cursor: pointer;\n    transition: background .2s ease, color .2s ease;\n  }\n\n  .duration-option__value.is-selected {\n    background: #321019;\n    color: #fff;\n  }\n\n  .duration-option__value:hover {\n    background: #321019;\n    color: #fff;\n  }\n</style>"
