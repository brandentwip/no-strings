            "custom_liquid_fj4ygX": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "<div class=\"additional-info-accordion\">\n  <details class=\"additional-info-accordion__details\">\n    <summary class=\"additional-info-accordion__summary\">\n      <span>Additional Information</span>\n      <span class=\"additional-info-accordion__icon\">▾</span>\n    </summary>\n\n    <div class=\"additional-info-accordion__content\">\n      <table class=\"additional-info-table\">\n        <tbody>\n          <tr>\n            <th>Description</th>\n            <td>\n              Step into elegance with the Gold and Peach Mirror Work Lehenga Set by renowned designer Abhinav Mishra — now available on rent exclusively at nostringscouture. This breathtaking ensemble features a beautifully embroidered net silk kurta paired with a net lehenga and dupatta, embellished with signature mirror work and gota accents. The subtle gold-peach color palette enhances your glow in natural and festive lighting. Ideal for modern bridesmaids and fashion-conscious wedding guests looking to rent a designer lehenga online at a fraction of the price.\n            </td>\n          </tr>\n\n          <tr>\n            <th>Occasions</th>\n            <td>Making it a perfect pick for weddings, mehendi, or reception events</td>\n          </tr>\n\n          <tr>\n            <th>Why Should You Rent From Nostringscouture?</th>\n            <td>\n              <ul class=\"additional-info-checklist\">\n                <li>Available in multiple sizes</li>\n                <li>Includes kurta, lehenga, and dupatta</li>\n                <li>Dry-cleaned and quality-checked before every rental</li>\n                <li>Hassle-free doorstep delivery and easy return process</li>\n                <li>Nationwide delivery available</li>\n              </ul>\n            </td>\n          </tr>\n\n          <tr>\n            <th>Sizes Available</th>\n            <td>XS, S, M</td>\n          </tr>\n\n          <tr>\n            <th>Colors</th>\n            <td>Gold</td>\n          </tr>\n\n          <tr>\n            <th>Security Deposit</th>\n            <td>\n              We take a 100% refundable security deposit with all bookings as an assurance in case of incidental damages. This amount is equal to the rental value of the garment and is used in case of irreparable damage.\n            </td>\n          </tr>\n\n          <tr>\n            <th>Occasions</th>\n            <td>Reception, Wedding</td>\n          </tr>\n\n          <tr>\n            <th>How It Works?</th>\n            <td><a href=\"#\" class=\"additional-info-link\">Know More</a></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </details>\n</div>\n<style>\n  .additional-info-accordion {\n    font-family: var(--font-body--family);\n    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.1);\n    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);\n  }\n  .additional-info-accordion__summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    cursor: pointer;\n    padding: var(--padding-md, 16px) 0;\n    font-weight: var(--font-weight-semibold);\n    font-size: var(--font-paragraph--size);\n    list-style: none;\n  }\n  .additional-info-accordion__summary::-webkit-details-marker { display: none; }\n  .additional-info-accordion__icon { transition: transform 0.2s ease; }\n  .additional-info-accordion__details[open] .additional-info-accordion__icon { transform: rotate(180deg); }\n  .additional-info-accordion__content { padding-bottom: var(--padding-md, 16px); }\n  .additional-info-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-family: inherit;\n  }\n  .additional-info-table th, .additional-info-table td {\n    text-align: left;\n    vertical-align: top;\n    padding: 12px 10px;\n    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);\n    font-size: var(--font-paragraph-small--size);\n    line-height: var(--font-paragraph--line-height, 1.5);\n    color: var(--color-foreground);\n  }\n  .additional-info-table th {\n    width: 32%;\n    font-weight: var(--font-weight-semibold);\n  }\n  .additional-info-checklist { margin: 0; padding: 0; list-style: none; }\n  .additional-info-checklist li { padding-left: 1.4em; position: relative; margin-bottom: 4px; }\n  .additional-info-checklist li::before { content: '✓'; position: absolute; left: 0; }\n  .additional-info-link {\n    text-decoration: underline;\n    color: inherit;\n  }\n  @media screen and (max-width: 749px) {\n    .additional-info-table th { width: 40%; }\n  }\n</style>"
              },
